// Colours and sizes shared by every page. One dark theme, one accent.

export global Theme {
    out property <brush> background: @linear-gradient(160deg, #121826 0%, #0a0d14 55%, #07090e 100%);
    out property <color> surface: #141a26;
    out property <color> surface-high: #1c2433;
    out property <color> surface-focus: #26304a;
    out property <color> stroke: #252e40;
    out property <color> text: #eef2f8;
    out property <color> dim: #93a0b5;
    out property <color> faint: #5d687c;
    out property <color> accent: #ff3d5e;
    out property <color> accent-soft: #ff3d5e2e;
    out property <color> accent-text: #ffffff;
    out property <color> focus: #ffffff;
    out property <color> good: #34d399;
    out property <color> warn: #fbbf24;
    out property <color> warn-soft: #fbbf2420;
    out property <color> bad: #f87171;

    out property <length> radius: 18px;
    out property <length> radius-small: 12px;
    out property <length> gap: 16px;

    out property <length> font-small: 15px;
    out property <length> font-body: 18px;
    out property <length> font-title: 22px;
}
