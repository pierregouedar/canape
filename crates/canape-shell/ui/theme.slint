// Colours and sizes shared by every page. One dark theme and one accent
// colour, picked in the settings page; everything else derives from it.

export global Theme {
    // Accent picked in the settings page, set by the Rust side (accent.rs)
    // from shell.json, the picker, or the service when another client
    // changed it.
    in-out property <color> accent: #ff3d5e;
    // Text on a filled accent background: white or near black, whichever
    // contrasts more.
    in-out property <color> accent-text: #ffffff;
    in-out property <string> accent-hex: "#ff3d5e";
    // The picker's position: hue in degrees, saturation and value in [0, 1].
    in-out property <float> accent-hue: 350;
    in-out property <float> accent-saturation: 0.76;
    in-out property <float> accent-value: 1;

    out property <brush> background: @linear-gradient(160deg, #121826 0%, #0a0d14 55%, #07090e 100%);
    out property <color> surface: #141a26;
    out property <color> surface-high: #1c2433;
    out property <color> surface-focus: #26304a;
    out property <color> stroke: #252e40;
    out property <color> text: #eef2f8;
    out property <color> dim: #93a0b5;
    out property <color> faint: #5d687c;
    out property <color> accent-soft: root.accent.with-alpha(0.18);
    // Dark tint for large highlighted panels.
    out property <color> accent-tint: root.accent.mix(root.surface, 0.12);
    // Graph lines and their legend: the accent lifted toward white, so a
    // dark accent still reads on the dark panels.
    out property <color> accent-line: root.accent.mix(#ffffff, 0.7);
    // Second series in graphs (GPU activity), neutral next to any accent.
    out property <color> graph: #9fb4d6;
    // Reference lines in graphs (the power limit).
    out property <color> reference: #b7c0cf;
    out property <color> focus: #ffffff;
    out property <color> good: #34d399;
    out property <color> warn: #fbbf24;
    out property <color> warn-soft: #fbbf2420;
    out property <color> bad: #f87171;

    out property <length> radius: 18px;
    out property <length> radius-small: 12px;
    out property <length> gap: 16px;

    out property <length> font-small: 15px;
    out property <length> font-body: 18px;
    out property <length> font-title: 22px;
}
