// The sub-pages: game profiles and the games to add (from the settings),
// the bench (from the performance page) and gyro aiming (from the hardware
// page). All are lines the D-pad moves through, like the settings page; B
// goes back.

import { Theme } from "theme.slint";
import { App } from "state.slint";
import { Library } from "library.slint";
import { SectionTitle, SettingLine } from "kit.slint";

// Games to add: the games of games.json and the Start menu and desktop
// shortcuts that could be games (library.rs, addgames.rs). A adds the
// focused one, or takes it out of games.json.
export component AddGamesPage inherits Rectangle {
    in-out property <int> focus-row: 0;
    property <bool> active: fs.has-focus;
    property <length> pitch: 56px;
    init => {
        Library.open-add-games();
    }
    changed focus-row => {
        // Keep the focused line in view: the gamepad cannot scroll.
        let y = root.focus-row * root.pitch;
        if y + list.content-y < 0 {
            list.content-y = -y;
        }
        if y + root.pitch + list.content-y > list.height {
            list.content-y = list.height - y - root.pitch;
        }
    }

    fs := FocusScope {
        init => {
            self.focus();
        }
        key-pressed(event) => {
            if event.text == Key.UpArrow {
                root.focus-row = max(0, root.focus-row - 1);
                return accept;
            }
            if event.text == Key.DownArrow {
                root.focus-row = max(0, min(Library.add-games.length - 1, root.focus-row + 1));
                return accept;
            }
            if (event.text == Key.Return || event.text == " ") && root.focus-row < Library.add-games.length {
                Library.toggle-add-game(root.focus-row);
                return accept;
            }
            return reject;
        }
    }

    VerticalLayout {
        x: 0;
        width: 784px;
        height: parent.height;
        spacing: 2px;

        SectionTitle {
            height: 36px;
            x: 16px;
            text: @tr("Add a game");
        }

        if Library.add-games-error != "": Text {
            x: 16px;
            text: Library.add-games-error;
            color: Theme.warn;
            font-size: 13px;
            wrap: word-wrap;
        }

        if Library.add-games.length == 0: Text {
            x: 16px;
            text: Library.add-games-loading ? @tr("Looking for shortcuts…") : @tr("No shortcut to a game in the Start menu or on the desktop. Games can also be listed in games.json, in %LOCALAPPDATA%\\Canape.");
            color: Theme.dim;
            font-size: 14px;
            wrap: word-wrap;
        }

        list := Flickable {
            vertical-stretch: 1;
            content-height: Library.add-games.length * root.pitch;
            animate content-y { duration: 160ms; easing: ease-out; }
            for game[i] in Library.add-games: SettingLine {
                y: i * root.pitch;
                width: list.width;
                label: game.name;
                value: game.added ? @tr("Added") : game.file;
                chevrons: false;
                focused: root.active && root.focus-row == i;
                clicked => {
                    root.focus-row = i;
                    Library.toggle-add-game(i);
                    fs.focus();
                }
            }
        }
    }
}

// Game profiles. Line 0 saves the game in the foreground; the others are
// the profiles, and X deletes the focused one after a second press.
export component ProfilesPage inherits Rectangle {
    in-out property <int> focus-row: 0;
    // Line whose profile X deletes on the next press, -1 when none.
    in-out property <int> armed: -1;
    property <bool> active: fs.has-focus;
    property <bool> can-save: App.status.connected && App.status.foreground != "";
    property <int> rows: App.profiles.length + 1;
    property <length> pitch: 56px;
    init => {
        App.refresh();
    }
    changed focus-row => {
        root.armed = -1;
        // Keep the focused line in view: the gamepad cannot scroll.
        let y = (root.focus-row - 1) * root.pitch;
        if y + list.content-y < 0 {
            list.content-y = -y;
        }
        if y + root.pitch + list.content-y > list.height {
            list.content-y = list.height - y - root.pitch;
        }
    }

    fs := FocusScope {
        init => {
            self.focus();
        }
        key-pressed(event) => {
            if event.text == Key.UpArrow {
                root.focus-row = max(0, root.focus-row - 1);
                return accept;
            }
            if event.text == Key.DownArrow {
                root.focus-row = min(root.rows - 1, root.focus-row + 1);
                return accept;
            }
            if (event.text == Key.Return || event.text == " ") && root.focus-row == 0 && root.can-save {
                App.save-profile();
                return accept;
            }
            if (event.text == Key.F2 || event.text == "x") && root.focus-row > 0 {
                if root.armed == root.focus-row {
                    root.armed = -1;
                    App.delete-profile(App.profiles[root.focus-row - 1].exe);
                    root.focus-row = min(root.focus-row, root.rows - 2);
                } else {
                    root.armed = root.focus-row;
                }
                return accept;
            }
            return reject;
        }
    }

    VerticalLayout {
        x: 0;
        width: 784px;
        height: parent.height;
        spacing: 2px;

        SectionTitle {
            height: 36px;
            x: 16px;
            text: @tr("Game profiles");
        }

        SettingLine {
            label: App.status.foreground != "" ? (App.status.active-profile != "" ? @tr("Update the profile of {}", App.status.foreground) : @tr("Save a profile for {}", App.status.foreground)) : @tr("No game in the foreground");
            value: "";
            chevrons: false;
            enabled: root.can-save;
            focused: root.active && root.focus-row == 0;
            clicked => {
                root.focus-row = 0;
                if root.can-save {
                    App.save-profile();
                }
                fs.focus();
            }
        }

        Rectangle {
            height: 12px;
        }

        if App.profiles.length == 0: Text {
            x: 16px;
            text: App.status.connected ? @tr("No profiles yet. Save one while a game is running, or from a bench result.") : @tr("Service not connected");
            color: Theme.dim;
            font-size: 14px;
            wrap: word-wrap;
        }

        list := Flickable {
            vertical-stretch: 1;
            content-height: App.profiles.length * root.pitch;
            animate content-y { duration: 160ms; easing: ease-out; }
            for profile[i] in App.profiles: SettingLine {
                y: i * root.pitch;
                width: list.width;
                label: profile.exe + (profile.exe.to-lowercase() == App.status.active-profile.to-lowercase() ? "  ·  " + @tr("In use") : "");
                value: root.armed == i + 1 ? @tr("Press X again to delete") : (profile.auto-tdp ? App.fps-value(profile.target-fps) + " · " + App.watts(profile.min-watts) + "–" + App.watts(profile.max-watts) : @tr("Auto TDP off")) + (profile.learned-watts >= 0 ? " · " + @tr("{} learned", App.watts(profile.learned-watts)) : "") + (profile.fps-limit > 0 ? " · " + @tr("limit {}", App.fps-value(profile.fps-limit)) : "");
                chevrons: false;
                focused: root.active && root.focus-row == i + 1;
                clicked => {
                    root.focus-row = i + 1;
                    fs.focus();
                }
            }
        }
    }
}

// The bench: plays the game in front at several power limits. Lines 0 and
// 1 set the step and the time per step, line 2 starts or cancels; after a
// run, lines 3 to 5 are the recommendations: A sets the power limit, X
// saves it for the game.
export component BenchPage inherits Rectangle {
    in-out property <int> focus-row: 2;
    in-out property <int> step-watts: 3;
    in-out property <int> measure-secs: 15;
    property <bool> active: fs.has-focus;
    property <bool> has-game: App.bench.exe != "" || App.status.foreground != "";
    property <bool> results: !App.status.bench-running && App.bench.available;
    property <[int]> steps: [2, 3, 5];
    property <[int]> times: [10, 15, 30];
    init => {
        App.refresh();
    }
    changed results => {
        if !root.results && root.focus-row > 2 {
            root.focus-row = 2;
        }
    }

    function pick(list: [int], value: int, d: int) -> int {
        let i = value == list[0] ? 0 : value == list[1] ? 1 : 2;
        list[clamp(i + d, 0, 2)]
    }
    function start-or-cancel() {
        if App.status.bench-running {
            App.cancel-bench();
        } else if App.status.connected {
            App.start-bench(root.step-watts, root.measure-secs);
        }
    }
    function rec-watts(r: int) -> int {
        r == 3 ? App.bench.sweet-spot.watts : r == 4 ? App.bench.for-target.watts : App.bench.most-efficient.watts
    }
    function rec-available(r: int) -> bool {
        r == 3 ? App.bench.sweet-spot.available : r == 4 ? App.bench.for-target.available : App.bench.most-efficient.available
    }

    fs := FocusScope {
        init => {
            self.focus();
        }
        key-pressed(event) => {
            if event.text == Key.UpArrow {
                root.focus-row = max(0, root.focus-row - 1);
                return accept;
            }
            if event.text == Key.DownArrow {
                root.focus-row = min(root.results ? 5 : 2, root.focus-row + 1);
                return accept;
            }
            if (event.text == Key.LeftArrow || event.text == Key.RightArrow) && !App.status.bench-running {
                let d = event.text == Key.LeftArrow ? -1 : 1;
                if root.focus-row == 0 {
                    root.step-watts = root.pick(root.steps, root.step-watts, d);
                } else if root.focus-row == 1 {
                    root.measure-secs = root.pick(root.times, root.measure-secs, d);
                }
                return accept;
            }
            if event.text == Key.Return || event.text == " " {
                if root.focus-row == 2 {
                    root.start-or-cancel();
                } else if root.focus-row > 2 && root.rec-available(root.focus-row) && App.status.connected {
                    App.apply-tdp(root.rec-watts(root.focus-row));
                }
                return accept;
            }
            if (event.text == Key.F2 || event.text == "x") && root.focus-row > 2 && root.rec-available(root.focus-row) && root.has-game && App.status.connected {
                App.apply-profile(root.rec-watts(root.focus-row));
                return accept;
            }
            return reject;
        }
    }

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        spacing: 40px;

        VerticalLayout {
            width: 640px;
            spacing: 2px;

            SectionTitle {
                height: 36px;
                x: 16px;
                text: @tr("Bench");
            }

            SettingLine {
                label: @tr("Step");
                value: App.watts(root.step-watts);
                enabled: !App.status.bench-running;
                focused: root.active && root.focus-row == 0;
                step(d) => {
                    root.focus-row = 0;
                    root.step-watts = root.pick(root.steps, root.step-watts, d);
                    fs.focus();
                }
            }

            SettingLine {
                label: @tr("Per step");
                value: @tr("{} s", root.measure-secs);
                enabled: !App.status.bench-running;
                focused: root.active && root.focus-row == 1;
                step(d) => {
                    root.focus-row = 1;
                    root.measure-secs = root.pick(root.times, root.measure-secs, d);
                    fs.focus();
                }
            }

            SettingLine {
                label: App.status.bench-running ? @tr("Cancel") : @tr("Start");
                value: App.status.bench-running ? @tr("{} left", App.duration(App.status.bench-seconds-left)) : @tr("about {}", App.duration(App.bench-duration(root.step-watts, root.measure-secs)));
                chevrons: false;
                enabled: App.status.connected;
                focused: root.active && root.focus-row == 2;
                clicked => {
                    root.focus-row = 2;
                    root.start-or-cancel();
                    fs.focus();
                }
            }

            Rectangle {
                height: 24px;
            }

            // The run's measures, one column per power limit.
            if root.results: HorizontalLayout {
                padding-left: 16px;
                spacing: 4px;
                VerticalLayout {
                    width: 150px;
                    for label in [@tr("Power"), @tr("Average FPS"), @tr("Lowest FPS"), @tr("FPS per watt"), @tr("Max temperature")]: Text {
                        height: 30px;
                        text: label;
                        color: Theme.dim;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                for row in App.bench-rows: Rectangle {
                    border-radius: 8px;
                    background: row.watts == App.bench.sweet-spot.watts ? Theme.surface-high : transparent;
                    VerticalLayout {
                        for value[i] in [App.watts(row.watts), row.fps-avg, row.fps-low, App.tenths(row.fps-per-watt-tenths), row.temp >= 0 ? App.celsius(row.temp) : "—"]: Text {
                            height: 30px;
                            text: value;
                            color: i == 0 || i == 1 ? Theme.text : Theme.text.mix(Theme.dim, 0.6);
                            font-size: 14px;
                            font-weight: i == 0 ? 600 : 500;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            if !root.results && !App.status.bench-running: Text {
                x: 16px;
                text: App.status.connected ? @tr("No results yet. Start a game, then start the bench.") : @tr("Service not connected");
                color: Theme.dim;
                font-size: 14px;
                wrap: word-wrap;
            }

            Rectangle {
                vertical-stretch: 1;
            }
        }

        VerticalLayout {
            spacing: 2px;

            SectionTitle {
                height: 36px;
                x: 16px;
                text: App.status.bench-running ? @tr("Running") : root.results ? (App.bench.exe != "" ? @tr("Results for {}", App.bench.exe) : @tr("Results")) + (App.bench.completed ? "" : " · " + @tr("incomplete run")) : "";
            }

            if App.status.bench-running: VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 14px;
                Text {
                    text: App.status.bench-step == 0 ? @tr("Waiting for the game") : @tr("Step {} of {}: {}", App.status.bench-step, App.status.bench-steps, App.watts(App.status.bench-watts));
                    color: Theme.text;
                    font-size: 28px;
                    font-weight: 600;
                }

                Rectangle {
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.surface-focus;
                    Rectangle {
                        x: 0;
                        width: parent.width * max(0, App.status.bench-step - 1) / max(1, App.status.bench-steps);
                        border-radius: 2px;
                        background: Theme.accent;
                        animate width { duration: 400ms; }
                    }
                }

                Text {
                    text: App.status.bench-step == 0 ? @tr("Bring the game back to the front: the bench starts on its own.") : @tr("{} left. Keep the game in front; the power limit changes on its own.", App.duration(App.status.bench-seconds-left));
                    color: Theme.dim;
                    font-size: 14px;
                    wrap: word-wrap;
                }
            }

            for r in (root.results ? [3, 4, 5] : []): SettingLine {
                label: r == 3 ? @tr("Sweet spot") : r == 4 ? @tr("For {} FPS", App.bench.target-fps) : @tr("Most efficient");
                value: root.rec-available(r) ? App.watts(root.rec-watts(r)) + " · " + App.fps-value(r == 3 ? App.bench.sweet-spot.fps : r == 4 ? App.bench.for-target.fps : App.bench.most-efficient.fps) : "—";
                chevrons: false;
                enabled: root.rec-available(r);
                focused: root.active && root.focus-row == r;
                clicked => {
                    root.focus-row = r;
                    fs.focus();
                }
            }

            Rectangle {
                vertical-stretch: 1;
            }
        }
    }
}

// Gyro aiming: the device's rotation moves the mouse while a game is in
// front. Left and right change the focused line; X keeps the settings for
// the game in the foreground.
export component GyroPage inherits Rectangle {
    in-out property <int> focus-row: 0;
    property <bool> active: fs.has-focus;
    property <[string]> activations: ["off", "hold", "toggle", "always"];
    property <int> activation-index: App.status.gyro-activation == "hold" ? 1 : App.status.gyro-activation == "toggle" ? 2 : App.status.gyro-activation == "always" ? 3 : 0;

    function side(d: int) {
        if !App.status.connected {
            return;
        }
        if root.focus-row == 0 {
            App.set-gyro-activation(root.activations[Math.mod(root.activation-index + d + 4, 4)]);
        } else if root.focus-row == 1 {
            App.change-gyro-sensitivity(d);
        } else if root.focus-row == 2 {
            App.toggle-gyro-roll();
        } else {
            App.toggle-gyro-invert();
        }
    }

    fs := FocusScope {
        init => {
            self.focus();
        }
        key-pressed(event) => {
            if event.text == Key.UpArrow {
                root.focus-row = max(0, root.focus-row - 1);
                return accept;
            }
            if event.text == Key.DownArrow {
                root.focus-row = min(3, root.focus-row + 1);
                return accept;
            }
            if event.text == Key.LeftArrow {
                root.side(-1);
                return accept;
            }
            if event.text == Key.RightArrow {
                root.side(1);
                return accept;
            }
            // A flips the two on / off lines.
            if (event.text == Key.Return || event.text == " ") && root.focus-row >= 2 {
                root.side(1);
                return accept;
            }
            if (event.text == Key.F2 || event.text == "x") && App.status.connected && App.status.foreground != "" {
                App.save-hardware-profile();
                return accept;
            }
            return reject;
        }
    }

    VerticalLayout {
        x: 0;
        width: 784px;
        height: parent.height;
        spacing: 2px;

        HorizontalLayout {
            height: 36px;
            padding-left: 16px;
            padding-right: 16px;
            SectionTitle {
                text: @tr("Gyro aiming");
                vertical-alignment: center;
            }

            Text {
                horizontal-stretch: 1;
                text: App.status.active-profile != "" ? @tr("{} · game profile", App.status.foreground) : "";
                color: Theme.dim;
                font-size: 13px;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        SettingLine {
            label: @tr("Active");
            value: App.gyro-name(App.status.gyro-activation);
            enabled: App.status.connected;
            focused: root.active && root.focus-row == 0;
            clicked => {
                root.focus-row = 0;
                fs.focus();
            }
            step(d) => {
                root.focus-row = 0;
                root.side(d);
                fs.focus();
            }
        }

        SettingLine {
            label: @tr("Sensitivity");
            value: App.status.gyro-sensitivity;
            enabled: App.status.connected;
            focused: root.active && root.focus-row == 1;
            clicked => {
                root.focus-row = 1;
                fs.focus();
            }
            step(d) => {
                root.focus-row = 1;
                root.side(d);
                fs.focus();
            }
        }

        SettingLine {
            label: @tr("Left and right");
            value: App.status.gyro-roll ? @tr("Tilt like a wheel") : @tr("Turn the console");
            enabled: App.status.connected;
            focused: root.active && root.focus-row == 2;
            clicked => {
                root.focus-row = 2;
                root.side(1);
                fs.focus();
            }
            step(d) => {
                root.focus-row = 2;
                root.side(d);
                fs.focus();
            }
        }

        SettingLine {
            label: @tr("Invert up and down");
            value: App.status.gyro-invert ? @tr("On") : @tr("Off");
            enabled: App.status.connected;
            focused: root.active && root.focus-row == 3;
            clicked => {
                root.focus-row = 3;
                root.side(1);
                fs.focus();
            }
            step(d) => {
                root.focus-row = 3;
                root.side(d);
                fs.focus();
            }
        }

        Rectangle {
            height: 12px;
        }

        Text {
            x: 16px;
            width: parent.width - 32px;
            text: App.status.connected ? @tr("Moves the mouse while a game is in front. Games that only read the gamepad ignore it.") : @tr("Service not connected");
            color: Theme.dim;
            font-size: 14px;
            wrap: word-wrap;
        }

        Rectangle {
            vertical-stretch: 1;
        }
    }
}
