// Building blocks. Every control is a focusable Pressable so the gamepad
// (Tab / Shift+Tab / Return, see nav.rs) can reach it; the focus shows as a
// white ring.

import { Theme } from "theme.slint";

export component Pressable inherits Rectangle {
    in property <bool> enabled: true;
    in property <bool> selected;
    out property <bool> focused: fs.has-focus;
    // Text colour that reads on the current background.
    out property <color> fg: !root.enabled ? Theme.faint : root.selected ? Theme.accent-text : Theme.text;
    out property <color> fg-dim: !root.enabled ? Theme.faint : root.selected ? Theme.accent-text.with-alpha(0.8) : Theme.dim;
    callback clicked();
    callback focus-gained();

    forward-focus: fs;
    border-radius: Theme.radius-small;
    background: root.selected ? (root.enabled ? Theme.accent : Theme.accent-soft) : fs.has-focus ? Theme.surface-focus : ta.has-hover && root.enabled ? Theme.surface-focus : Theme.surface-high;
    border-width: fs.has-focus ? 3px : 1px;
    border-color: fs.has-focus ? Theme.focus : root.selected ? Theme.accent : Theme.stroke;
    animate background, border-color { duration: 120ms; }

    fs := FocusScope {
        // A click would otherwise stop here, only moving the focus: the
        // TouchArea on top takes it and focuses explicitly (touchscreen).
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                if root.enabled {
                    root.clicked();
                }
                return accept;
            }
            return reject;
        }
        focus-gained(reason) => {
            root.focus-gained();
        }
    }

    ta := TouchArea {
        clicked => {
            fs.focus();
            if root.enabled {
                root.clicked();
            }
        }
    }

    @children
}

// Large button: a label and an optional second line.
export component Tile inherits Pressable {
    in property <string> label;
    in property <string> sub;
    in property <length> font-size: 20px;
    // Side padding: narrow tiles trade it for room for the label.
    in property <length> pad: 16px;
    min-height: 64px;
    min-width: 110px;

    VerticalLayout {
        alignment: center;
        padding-left: root.pad;
        padding-right: root.pad;
        spacing: 2px;
        Text {
            text: root.label;
            color: root.fg;
            font-size: root.font-size;
            font-weight: 600;
            horizontal-alignment: center;
            overflow: elide;
        }
        if root.sub != "": Text {
            text: root.sub;
            color: root.fg-dim;
            font-size: Theme.font-small;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}

// Small selectable pill.
export component Chip inherits Pressable {
    in property <string> label;
    in property <length> font-size: Theme.font-body;
    height: 46px;
    min-width: 64px;
    border-radius: 23px;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        Text {
            text: root.label;
            color: root.fg;
            font-size: root.font-size;
            font-weight: root.selected ? 700 : 500;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Square "−" / "+" button.
export component IconButton inherits Pressable {
    in property <string> icon;
    width: 50px;
    height: 46px;
    border-radius: 23px;

    Text {
        text: root.icon;
        color: root.fg;
        font-size: 26px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// − value +
export component Stepper inherits HorizontalLayout {
    in property <string> value;
    in property <bool> enabled: true;
    callback step(int);
    spacing: 8px;
    alignment: start;

    IconButton {
        icon: "−";
        enabled: root.enabled;
        clicked => {
            root.step(-1);
        }
    }

    Text {
        text: root.value;
        min-width: 76px;
        color: root.enabled ? Theme.text : Theme.faint;
        font-size: 22px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    IconButton {
        icon: "+";
        enabled: root.enabled;
        clicked => {
            root.step(1);
        }
    }
}

export component Caption inherits Text {
    color: Theme.dim;
    font-size: Theme.font-small;
    font-weight: 600;
    letter-spacing: 0.6px;
    overflow: elide;
}

// Rounded panel with an optional caption.
export component Card inherits Rectangle {
    in property <string> title;
    in property <length> pad: 20px;
    in property <length> inner-spacing: 12px;
    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.stroke;

    VerticalLayout {
        padding: root.pad;
        spacing: root.inner-spacing;
        if root.title != "": Caption {
            text: root.title;
        }
        @children
    }
}

// One minute of history (history.rs): an area under a line, and an
// optional reference line such as the power limit. The paths share one
// viewbox and stroke width, so they line up exactly.
export component Graph inherits Rectangle {
    in property <string> line;
    in property <string> area;
    in property <string> reference;
    in property <color> tint: Theme.accent;
    clip: true;

    // A guide at half scale, and the baseline.
    Rectangle {
        y: parent.height / 2;
        height: 1px;
        background: Theme.stroke.with-alpha(0.45);
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.stroke;
    }

    if root.area != "": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 59;
        viewbox-height: 100;
        fit: fill;
        commands: root.area;
        // The software renderer fills paths with plain colours only.
        fill: root.tint.with-alpha(0.24);
        stroke: transparent;
        stroke-width: 2px;
    }

    if root.reference != "": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 59;
        viewbox-height: 100;
        fit: fill;
        commands: root.reference;
        stroke: Theme.reference;
        stroke-width: 1.5px;
    }

    if root.line != "": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 59;
        viewbox-height: 100;
        fit: fill;
        commands: root.line;
        stroke: root.tint;
        // Thicker than the reference line: the live value comes first.
        stroke-width: 3px;
        stroke-line-join: round;
    }
}

// Warning sign, drawn so it does not depend on the font.
export component WarnIcon inherits Rectangle {
    width: 22px;
    height: 20px;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 22;
        viewbox-height: 20;
        commands: "M 11 0 L 22 20 L 0 20 Z";
        fill: Theme.warn;
    }

    Rectangle {
        x: 10px;
        y: 6px;
        width: 2px;
        height: 7px;
        background: #1a1300;
    }

    Rectangle {
        x: 10px;
        y: 15px;
        width: 2px;
        height: 2px;
        background: #1a1300;
    }
}

// A slider for the colour picker: focus it, press A to grab it, then any
// direction moves it (the gamepad sends Tab / Shift+Tab, see nav.rs) until
// A or B lets go. Arrow keys and touch move it directly.
export component ColorSlider inherits Rectangle {
    in property <string> label;
    // Position in [0, 1].
    in property <float> value;
    // Change for one press, in [0, 1].
    in property <float> step: 0.02;
    in property <brush> track;
    // Draws the hue circle instead of `track`.
    in property <bool> rainbow;
    in property <color> knob;
    out property <bool> focused: fs.has-focus;
    out property <bool> grabbed;
    callback moved(float);
    forward-focus: fs;
    height: 62px;

    function nudge(direction: int) {
        root.moved(max(0, min(1, root.value + direction * root.step)));
    }

    Text {
        x: 0;
        y: 0;
        height: 20px;
        text: root.label;
        color: root.focused ? Theme.text : Theme.dim;
        font-size: Theme.font-small;
        font-weight: 600;
        overflow: elide;
        width: parent.width;
    }

    bar := Rectangle {
        x: 0;
        y: 26px;
        width: parent.width;
        height: 36px;
        border-radius: 10px;
        border-width: root.focused ? 3px : 0;
        border-color: Theme.focus;

        Rectangle {
            x: 5px;
            y: 5px;
            width: parent.width - 10px;
            height: parent.height - 10px;
            // Square ends: the software renderer does not round gradients.
            if !root.rainbow: Rectangle {
                background: root.track;
            }
            // One two-stop gradient per sixth of the hue circle: multi-stop
            // gradients show seams in the software renderer.
            for pair[i] in [[#ff0000, #ffff00], [#ffff00, #00ff00], [#00ff00, #00ffff], [#00ffff, #0000ff], [#0000ff, #ff00ff], [#ff00ff, #ff0000]]: Rectangle {
                visible: root.rainbow;
                x: parent.width * i / 6;
                width: parent.width / 6 + 1px;
                background: @linear-gradient(90deg, pair[0] 0%, pair[1] 100%);
            }
        }

        Rectangle {
            property <length> size: root.grabbed ? 30px : 24px;
            x: 5px + (parent.width - 10px - self.size) * root.value;
            y: (parent.height - self.size) / 2;
            width: self.size;
            height: self.size;
            border-radius: self.size / 2;
            background: root.knob;
            border-width: 3px;
            border-color: Theme.focus;
            drop-shadow-blur: 6px;
            drop-shadow-color: #00000080;
            animate width, height { duration: 100ms; }
        }

        TouchArea {
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    fs.focus();
                }
            }
            moved => {
                if self.pressed {
                    root.moved(max(0, min(1, (self.mouse-x - 5px) / (bar.width - 10px))));
                }
            }
            clicked => {
                root.moved(max(0, min(1, (self.mouse-x - 5px) / (bar.width - 10px))));
            }
        }
    }

    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.LeftArrow {
                root.nudge(-1);
                return accept;
            }
            if event.text == Key.RightArrow {
                root.nudge(1);
                return accept;
            }
            if event.text == Key.Return || event.text == " " {
                root.grabbed = !root.grabbed;
                return accept;
            }
            if root.grabbed {
                if event.text == Key.Escape {
                    root.grabbed = false;
                    return accept;
                }
                if event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift) || event.text == Key.UpArrow {
                    root.nudge(-1);
                    return accept;
                }
                if event.text == Key.Tab || event.text == Key.DownArrow {
                    root.nudge(1);
                    return accept;
                }
            }
            return reject;
        }
        focus-lost(reason) => {
            root.grabbed = false;
        }
    }
}

// The Canapé logo: a sofa in the accent colour, on a 30 x 22 grid.
export component Logo inherits Rectangle {
    in property <length> size: 30px;
    property <length> u: root.size / 30;
    width: root.size;
    height: root.u * 22;

    // Backrest.
    Rectangle {
        x: root.u * 5;
        y: root.u * 2;
        width: root.u * 20;
        height: root.u * 10;
        border-radius: root.u * 3.5;
        background: Theme.accent;
    }

    // Armrests.
    for side in [0, 1]: Rectangle {
        x: side == 0 ? root.u * 1 : root.u * 22;
        y: root.u * 8;
        width: root.u * 7;
        height: root.u * 10;
        border-radius: root.u * 3;
        background: Theme.accent;
    }

    // Seat.
    Rectangle {
        x: root.u * 6;
        y: root.u * 11.5;
        width: root.u * 18;
        height: root.u * 6.5;
        border-radius: root.u * 1.5;
        background: Theme.accent;
        opacity: 0.8;
    }

    // Legs.
    for side in [0, 1]: Rectangle {
        x: side == 0 ? root.u * 4 : root.u * 23.5;
        y: root.u * 18;
        width: root.u * 2.5;
        height: root.u * 3;
        border-radius: root.u * 1;
        background: Theme.accent;
    }
}

// Lightning bolt, drawn so it does not depend on the font.
export component Bolt inherits Path {
    width: 8px;
    height: 12px;
    viewbox-width: 12;
    viewbox-height: 18;
    commands: "M 7 0 L 0 10.5 L 5 10.5 L 4 18 L 12 7 L 7 7 L 8 0 Z";
    fill: Theme.text.mix(Theme.dim, 0.6);
}

// A small battery outline, filled to the charge; low charge turns red.
export component BatteryIcon inherits Rectangle {
    in property <int> percent;
    in property <bool> charging;
    property <color> ink: Theme.text.mix(Theme.dim, 0.6);
    width: 22px;
    height: 12px;

    Rectangle {
        x: 0;
        width: 20px;
        border-width: 1.5px;
        border-color: root.ink;
        border-radius: 3px;
        Rectangle {
            x: 2.5px;
            y: 2.5px;
            height: parent.height - 5px;
            width: (parent.width - 5px) * clamp(root.percent, 0, 100) / 100;
            border-radius: 1px;
            background: root.percent <= 20 && !root.charging ? Theme.bad : Theme.text;
        }
    }

    Rectangle {
        x: 20.5px;
        y: 4px;
        width: 1.5px;
        height: 4px;
        border-radius: 0.75px;
        background: root.ink;
    }
}

// A gamepad button as Windows draws it: a thin circle with the letter, in
// the text colour (Segoe Fluent Icons U+F093 A, U+F094 B, U+F095 Y,
// U+F096 X). Bumpers and other labels get a rounded outline.
export component PadGlyph inherits Rectangle {
    in property <string> text;
    in property <bool> round: true;
    in property <color> ink: Theme.text.mix(Theme.dim, 0.7);
    in property <length> size: 22px;
    property <string> system: root.text == "A" ? "\u{F093}" : root.text == "B" ? "\u{F094}" : root.text == "Y" ? "\u{F095}" : root.text == "X" ? "\u{F096}" : "";
    property <bool> use-font: Theme.system-glyphs && root.round && root.system != "";
    height: root.size;
    width: root.round ? root.size : max(root.size, label.preferred-width + 12px);
    border-radius: root.round ? root.size / 2 : 6px;
    border-width: root.use-font ? 0 : 1.5px;
    border-color: root.ink;

    if root.use-font: Text {
        text: root.system;
        font-family: "Segoe Fluent Icons";
        font-size: root.size;
        color: root.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    label := Text {
        visible: !root.use-font;
        text: root.text;
        color: root.ink;
        font-size: (root.round ? 11px : 10px) * root.size / 22px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
// The D-pad, with the two arrows of the axis it moves along.
export component DpadGlyph inherits Rectangle {
    in property <bool> horizontal;
    width: 22px;
    height: 22px;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: Theme.stroke;
        stroke: Theme.dim;
        stroke-width: 1.2px;
        stroke-line-join: round;
        commands: "M 9 2 L 15 2 L 15 9 L 22 9 L 22 15 L 15 15 L 15 22 L 9 22 L 9 15 L 2 15 L 2 9 L 9 9 Z";
    }

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: Theme.text;
        commands: root.horizontal ? "M 5.5 12 L 7.5 10.4 L 7.5 13.6 Z M 18.5 12 L 16.5 10.4 L 16.5 13.6 Z" : "M 12 5.5 L 13.6 7.5 L 10.4 7.5 Z M 12 18.5 L 13.6 16.5 L 10.4 16.5 Z";
    }
}

// A gamepad hint: the button, then what it does. `glyph` is a button name,
// "LB RB" for both bumpers, or "updown" / "leftright" for the D-pad.
export component Hint inherits HorizontalLayout {
    in property <string> glyph;
    in property <string> text;
    property <bool> bumpers: root.glyph == "LB RB";
    property <bool> dpad: root.glyph == "updown" || root.glyph == "leftright";
    horizontal-stretch: 0;
    spacing: 8px;
    if root.dpad: VerticalLayout {
        alignment: center;
        DpadGlyph {
            horizontal: root.glyph == "leftright";
        }
    }
    if root.bumpers: HorizontalLayout {
        spacing: 4px;
        VerticalLayout {
            alignment: center;
            PadGlyph {
                text: "LB";
                round: false;
            }
        }

        VerticalLayout {
            alignment: center;
            PadGlyph {
                text: "RB";
                round: false;
            }
        }
    }
    if !root.dpad && !root.bumpers: VerticalLayout {
        alignment: center;
        PadGlyph {
            text: root.glyph;
        }
    }

    Text {
        text: root.text;
        color: Theme.text.mix(Theme.dim, 0.6);
        font-size: 13px;
        vertical-alignment: center;
    }
}

// A store's logo, one colour, on a 24-unit grid: "Steam", "Epic", "GOG" or
// "Xbox" (the names GameView.source uses).
export component StoreLogo inherits Path {
    in property <string> store;
    in property <color> ink: Theme.text;
    width: 18px;
    height: 18px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: root.ink;
    stroke-width: 0;
    // The "Other" gamepad has holes: the D-pad and the buttons.
    fill-rule: root.store == "Other" ? evenodd : nonzero;
    commands: root.store == "Steam" ? "M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 11.999-5.373 11.999-12S18.605 0 11.979 0zM7.54 18.21l-1.473-.61c.262.543.714.999 1.314 1.25 1.297.539 2.793-.076 3.332-1.375.263-.63.264-1.319.005-1.949s-.75-1.121-1.377-1.383c-.624-.26-1.29-.249-1.878-.03l1.523.63c.956.4 1.409 1.5 1.009 2.455-.397.957-1.497 1.41-2.454 1.012H7.54zm11.415-9.303c0-1.662-1.353-3.015-3.015-3.015-1.665 0-3.015 1.353-3.015 3.015 0 1.665 1.35 3.015 3.015 3.015 1.663 0 3.015-1.35 3.015-3.015zm-5.273-.005c0-1.252 1.013-2.266 2.265-2.266 1.249 0 2.266 1.014 2.266 2.266 0 1.251-1.017 2.265-2.266 2.265-1.253 0-2.265-1.014-2.265-2.265z"
