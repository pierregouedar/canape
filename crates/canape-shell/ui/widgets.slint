// Building blocks. Every control is a focusable Pressable so the gamepad
// (Tab / Shift+Tab / Return, see nav.rs) can reach it; the focus shows as a
// white ring.

import { Theme } from "theme.slint";

export component Pressable inherits Rectangle {
    in property <bool> enabled: true;
    in property <bool> selected;
    out property <bool> focused: fs.has-focus;
    // Text colour that reads on the current background.
    out property <color> fg: !root.enabled ? Theme.faint : root.selected ? Theme.accent-text : Theme.text;
    out property <color> fg-dim: !root.enabled ? Theme.faint : root.selected ? Theme.accent-text.with-alpha(0.8) : Theme.dim;
    callback clicked();
    callback focus-gained();

    forward-focus: fs;
    border-radius: Theme.radius-small;
    background: root.selected ? (root.enabled ? Theme.accent : Theme.accent-soft) : fs.has-focus ? Theme.surface-focus : ta.has-hover && root.enabled ? Theme.surface-focus : Theme.surface-high;
    border-width: fs.has-focus ? 3px : 1px;
    border-color: fs.has-focus ? Theme.focus : root.selected ? Theme.accent : Theme.stroke;
    animate background, border-color { duration: 120ms; }

    fs := FocusScope {
        // A click would otherwise stop here, only moving the focus: the
        // TouchArea on top takes it and focuses explicitly (touchscreen).
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                if root.enabled {
                    root.clicked();
                }
                return accept;
            }
            return reject;
        }
        focus-gained(reason) => {
            root.focus-gained();
        }
    }

    ta := TouchArea {
        clicked => {
            fs.focus();
            if root.enabled {
                root.clicked();
            }
        }
    }

    @children
}

// Large button: a label and an optional second line.
export component Tile inherits Pressable {
    in property <string> label;
    in property <string> sub;
    in property <length> font-size: 20px;
    // Side padding: narrow tiles trade it for room for the label.
    in property <length> pad: 16px;
    min-height: 64px;
    min-width: 110px;

    VerticalLayout {
        alignment: center;
        padding-left: root.pad;
        padding-right: root.pad;
        spacing: 2px;
        Text {
            text: root.label;
            color: root.fg;
            font-size: root.font-size;
            font-weight: 600;
            horizontal-alignment: center;
            overflow: elide;
        }
        if root.sub != "": Text {
            text: root.sub;
            color: root.fg-dim;
            font-size: Theme.font-small;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}

// Small selectable pill.
export component Chip inherits Pressable {
    in property <string> label;
    in property <length> font-size: Theme.font-body;
    height: 46px;
    min-width: 64px;
    border-radius: 23px;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        Text {
            text: root.label;
            color: root.fg;
            font-size: root.font-size;
            font-weight: root.selected ? 700 : 500;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Square "−" / "+" button.
export component IconButton inherits Pressable {
    in property <string> icon;
    width: 50px;
    height: 46px;
    border-radius: 23px;

    Text {
        text: root.icon;
        color: root.fg;
        font-size: 26px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// − value +
export component Stepper inherits HorizontalLayout {
    in property <string> value;
    in property <bool> enabled: true;
    callback step(int);
    spacing: 8px;
    alignment: start;

    IconButton {
        icon: "−";
        enabled: root.enabled;
        clicked => {
            root.step(-1);
        }
    }

    Text {
        text: root.value;
        min-width: 76px;
        color: root.enabled ? Theme.text : Theme.faint;
        font-size: 22px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    IconButton {
        icon: "+";
        enabled: root.enabled;
        clicked => {
            root.step(1);
        }
    }
}

export component Caption inherits Text {
    color: Theme.dim;
    font-size: Theme.font-small;
    font-weight: 600;
    letter-spacing: 0.6px;
    overflow: elide;
}

// Rounded panel with an optional caption.
export component Card inherits Rectangle {
    in property <string> title;
    in property <length> pad: 20px;
    in property <length> inner-spacing: 12px;
    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.stroke;

    VerticalLayout {
        padding: root.pad;
        spacing: root.inner-spacing;
        if root.title != "": Caption {
            text: root.title;
        }
        @children
    }
}

// One minute of history (history.rs): an area under a line, and an
// optional reference line such as the power limit. The paths share one
// viewbox and stroke width, so they line up exactly.
export component Graph inherits Rectangle {
    in property <string> line;
    in property <string> area;
    in property <string> reference;
    in property <color> tint: Theme.accent;
    clip: true;

    // Guides at half and full scale, and the baseline.
    for level in [0, 0.5]: Rectangle {
        y: parent.height * level;
        height: 1px;
        background: Theme.stroke.with-alpha(0.6);
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.stroke;
    }

    if root.area != "": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 59;
        viewbox-height: 100;
        fit: fill;
        commands: root.area;
        // The software renderer fills paths with plain colours only.
        fill: root.tint.with-alpha(0.24);
        stroke: transparent;
        stroke-width: 2px;
    }

    if root.reference != "": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 59;
        viewbox-height: 100;
        fit: fill;
        commands: root.reference;
        stroke: Theme.reference;
        stroke-width: 2px;
    }

    if root.line != "": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 59;
        viewbox-height: 100;
        fit: fill;
        commands: root.line;
        stroke: root.tint;
        // Thicker than the reference line: the live value comes first.
        stroke-width: 3px;
        stroke-line-join: round;
    }
}

// Warning sign, drawn so it does not depend on the font.
export component WarnIcon inherits Rectangle {
    width: 22px;
    height: 20px;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 22;
        viewbox-height: 20;
        commands: "M 11 0 L 22 20 L 0 20 Z";
        fill: Theme.warn;
    }

    Rectangle {
        x: 10px;
        y: 6px;
        width: 2px;
        height: 7px;
        background: #1a1300;
    }

    Rectangle {
        x: 10px;
        y: 15px;
        width: 2px;
        height: 2px;
        background: #1a1300;
    }
}

// A slider for the colour picker: focus it, press A to grab it, then any
// direction moves it (the gamepad sends Tab / Shift+Tab, see nav.rs) until
// A or B lets go. Arrow keys and touch move it directly.
export component ColorSlider inherits Rectangle {
    in property <string> label;
    // Position in [0, 1].
    in property <float> value;
    // Change for one press, in [0, 1].
    in property <float> step: 0.02;
    in property <brush> track;
    // Draws the hue circle instead of `track`.
    in property <bool> rainbow;
    in property <color> knob;
    out property <bool> focused: fs.has-focus;
    out property <bool> grabbed;
    callback moved(float);
    forward-focus: fs;
    height: 62px;

    function nudge(direction: int) {
        root.moved(max(0, min(1, root.value + direction * root.step)));
    }

    Text {
        x: 0;
        y: 0;
        height: 20px;
        text: root.label;
        color: root.focused ? Theme.text : Theme.dim;
        font-size: Theme.font-small;
        font-weight: 600;
        overflow: elide;
        width: parent.width;
    }

    bar := Rectangle {
        x: 0;
        y: 26px;
        width: parent.width;
        height: 36px;
        border-radius: 10px;
        border-width: root.focused ? 3px : 0;
        border-color: Theme.focus;

        Rectangle {
            x: 5px;
            y: 5px;
            width: parent.width - 10px;
            height: parent.height - 10px;
            // Square ends: the software renderer does not round gradients.
            if !root.rainbow: Rectangle {
                background: root.track;
            }
            // One two-stop gradient per sixth of the hue circle: multi-stop
            // gradients show seams in the software renderer.
            for pair[i] in [[#ff0000, #ffff00], [#ffff00, #00ff00], [#00ff00, #00ffff], [#00ffff, #0000ff], [#0000ff, #ff00ff], [#ff00ff, #ff0000]]: Rectangle {
                visible: root.rainbow;
                x: parent.width * i / 6;
                width: parent.width / 6 + 1px;
                background: @linear-gradient(90deg, pair[0] 0%, pair[1] 100%);
            }
        }

        Rectangle {
            property <length> size: root.grabbed ? 30px : 24px;
            x: 5px + (parent.width - 10px - self.size) * root.value;
            y: (parent.height - self.size) / 2;
            width: self.size;
            height: self.size;
            border-radius: self.size / 2;
            background: root.knob;
            border-width: 3px;
            border-color: Theme.focus;
            drop-shadow-blur: 6px;
            drop-shadow-color: #00000080;
            animate width, height { duration: 100ms; }
        }

        TouchArea {
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    fs.focus();
                }
            }
            moved => {
                if self.pressed {
                    root.moved(max(0, min(1, (self.mouse-x - 5px) / (bar.width - 10px))));
                }
            }
            clicked => {
                root.moved(max(0, min(1, (self.mouse-x - 5px) / (bar.width - 10px))));
            }
        }
    }

    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.LeftArrow {
                root.nudge(-1);
                return accept;
            }
            if event.text == Key.RightArrow {
                root.nudge(1);
                return accept;
            }
            if event.text == Key.Return || event.text == " " {
                root.grabbed = !root.grabbed;
                return accept;
            }
            if root.grabbed {
                if event.text == Key.Escape {
                    root.grabbed = false;
                    return accept;
                }
                if event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift) || event.text == Key.UpArrow {
                    root.nudge(-1);
                    return accept;
                }
                if event.text == Key.Tab || event.text == Key.DownArrow {
                    root.nudge(1);
                    return accept;
                }
            }
            return reject;
        }
        focus-lost(reason) => {
            root.grabbed = false;
        }
    }
}

// The Canapé logo: a sofa in the accent colour, on a 32 x 24 grid.
export component Logo inherits Rectangle {
    in property <length> size: 32px;
    property <length> u: root.size / 32;
    width: root.size;
    height: root.u * 24;

    // Backrest.
    Rectangle {
        x: root.u * 5;
        y: root.u * 1;
        width: root.u * 22;
        height: root.u * 13;
        border-radius: root.u * 4;
        background: Theme.accent;
    }

    // Seat cushion, lighter so it reads in front of the backrest.
    Rectangle {
        x: root.u * 6;
        y: root.u * 12;
        width: root.u * 20;
        height: root.u * 7;
        border-radius: root.u * 2.5;
        background: Theme.accent.brighter(0.35);
    }

    // Armrests.
    for side in [0, 1]: Rectangle {
        x: side == 0 ? 0 : root.u * 24;
        y: root.u * 8;
        width: root.u * 8;
        height: root.u * 12;
        border-radius: root.u * 3.5;
        background: Theme.accent;
    }

    // Legs.
    for side in [0, 1]: Rectangle {
        x: side == 0 ? root.u * 3 : root.u * 26;
        y: root.u * 19;
        width: root.u * 3;
        height: root.u * 5;
        border-radius: root.u * 1;
        background: Theme.accent.darker(0.35);
    }
}

// Lightning bolt, drawn so it does not depend on the font.
export component Bolt inherits Path {
    width: 12px;
    height: 18px;
    viewbox-width: 12;
    viewbox-height: 18;
    commands: "M 7 0 L 0 10.5 L 5 10.5 L 4 18 L 12 7 L 7 7 L 8 0 Z";
    fill: Theme.warn;
}

export component BatteryIcon inherits Rectangle {
    in property <int> percent;
    in property <bool> charging;
    in property <color> tint: Theme.text;
    width: 40px;
    height: 20px;

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width - 4px;
        height: parent.height;
        border-width: 2px;
        border-color: root.tint;
        border-radius: 5px;
        Rectangle {
            x: 4px;
            y: 4px;
            height: parent.height - 8px;
            width: (parent.width - 8px) * max(0, min(100, root.percent)) / 100;
            border-radius: 2px;
            background: root.percent <= 20 && !root.charging ? Theme.bad : root.charging ? Theme.good : root.tint;
        }
    }

    Rectangle {
        x: parent.width - 3px;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: 8px;
        border-radius: 1px;
        background: root.tint;
    }
}

// A gamepad button, as drawn in the hints: round for A / B, a pill for LB / RB.
// A gamepad button as Windows draws it: a thin circle with the letter, in
// the text colour (Segoe Fluent Icons U+F093 A, U+F094 B, U+F095 Y,
// U+F096 X). Bumpers and other labels get a rounded outline.
export component PadGlyph inherits Rectangle {
    in property <string> text;
    in property <bool> round: true;
    in property <color> ink: Theme.text.mix(Theme.dim, 0.7);
    property <string> system: root.text == "A" ? "\u{F093}" : root.text == "B" ? "\u{F094}" : root.text == "Y" ? "\u{F095}" : root.text == "X" ? "\u{F096}" : "";
    property <bool> use-font: Theme.system-glyphs && root.round && root.system != "";
    height: 22px;
    width: root.round ? 22px : max(22px, label.preferred-width + 12px);
    border-radius: root.round ? 11px : 6px;
    border-width: root.use-font ? 0 : 1.5px;
    border-color: root.ink;

    if root.use-font: Text {
        text: root.system;
        font-family: "Segoe Fluent Icons";
        font-size: 22px;
        color: root.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    label := Text {
        visible: !root.use-font;
        text: root.text;
        color: root.ink;
        font-size: root.round ? 11px : 10px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
export component Hint inherits HorizontalLayout {
    in property <string> glyph;
    in property <bool> round: true;
    in property <string> text;
    spacing: 8px;
    VerticalLayout {
        alignment: center;
        PadGlyph {
            text: root.glyph;
            round: root.round;
        }
    }

    Text {
        text: root.text;
        color: Theme.dim;
        font-size: Theme.font-small;
        vertical-alignment: center;
    }
}

// The D-pad, drawn as a cross.
export component DpadGlyph inherits Rectangle {
    width: 26px;
    height: 26px;
    Rectangle {
        x: 9px;
        y: 1px;
        width: 8px;
        height: 24px;
        border-radius: 2px;
        background: Theme.surface-high;
        border-width: 1px;
        border-color: #3a4560;
    }

    Rectangle {
        x: 1px;
        y: 9px;
        width: 24px;
        height: 8px;
        border-radius: 2px;
        background: Theme.surface-high;
        border-width: 1px;
        border-color: #3a4560;
    }

    Rectangle {
        x: 9px;
        y: 9px;
        width: 8px;
        height: 8px;
        background: Theme.surface-high;
    }
}
