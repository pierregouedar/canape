// Windows tweaks sub-page (from Settings): one list the D-pad moves
// through, grouped by theme. The service owns the catalogue and applies
// the Windows settings; the shell removes the preinstalled apps of the
// signed-in user (tweaks.rs). Up and down change line, A acts on it. A
// line that lowers the protection, removes an app or applies the
// recommended set asks for a second A; leaving the line cancels.

import { Theme } from "theme.slint";
import { App } from "state.slint";
import { ChoiceTile, Drawer, HintSet, PageHints, Shelf, ShelfCard, ShelfPane, Shelves } from "kit.slint";

// One line of the page, built by tweaks.rs.
export struct TweakRow {
    // 0 heading, 1 the recommended set, 2 a tweak, 3 an app.
    kind: int,
    // Heading: the group ("clutter", "privacy", "games", "security",
    // "apps"); tweak: its protocol name; app: its package name.
    id: string,
    // App: its English name, for the names Windows does not translate.
    name: string,
    // Tweak: applied; app: removed; recommended set: all applied.
    applied: bool,
    // Tweak: "" or why it cannot change ("tamper_protection", "locked",
    // "no_game_folders", "not_supported").
    unavailable: string,
    // Tweak: changed, and only effective after a restart.
    reboot-pending: bool,
    // Tweak: lowers the protection; asks for confirmation.
    security: bool,
    // Defender exclusions: game folders; recommended set: tweaks left.
    count: int,
}

export global Tweaks {
    in property <[TweakRow]> rows;
    in property <[TweakRow]> clutter;
    in property <[TweakRow]> privacy;
    in property <[TweakRow]> games;
    in property <[TweakRow]> security;
    in property <[TweakRow]> recommended;
    in property <bool> recommended-exclusions;
    in property <[TweakRow]> owned;
    in property <[TweakRow]> apps;
    // Row waiting for its outcome (a removal, a change), -1 when none.
    in property <int> busy: -1;
    // Last failure of an app removal, untranslated.
    in property <string> error;
    callback open();
    // Applies (true) or reverts one tweak, by protocol name.
    callback set(string, bool);
    callback apply-recommended();
    callback revert-owned();
    callback remove-app(string);
    // Opens the app's Microsoft Store page.
    callback reinstall-app(string);

    public pure function label(row: TweakRow) -> string {
        if row.kind == 1 {
            return @tr("Apply the recommended settings");
        }
        if row.kind == 3 {
            return root.app-name(row.id, row.name);
        }
        if row.kind == 0 {
            return row.id == "clutter" ? @tr("Copilot and ads") : row.id == "privacy" ? @tr("Privacy") : row.id == "games" ? @tr("Games") : row.id == "security" ? @tr("Security") : @tr("Preinstalled apps");
        }
        row.id == "copilot_off" ? @tr("Copilot") : row.id == "widgets_off" ? @tr("Widgets") : row.id == "web_search_off" ? @tr("Web results in search") : row.id == "suggestions_off" ? @tr("Suggestions and ads") : row.id == "lock_screen_tips_off" ? @tr("Tips on the lock screen") : row.id == "tips_off" ? @tr("Tips and welcome screens") : row.id == "telemetry_min" ? @tr("Diagnostic data") : row.id == "background_apps_off" ? @tr("Store apps in the background") : row.id == "game_mode_on" ? @tr("Game Mode") : row.id == "gpu_scheduling_on" ? @tr("Hardware-accelerated GPU scheduling") : row.id == "windowed_optimizations_on" ? @tr("Optimizations for windowed games") : row.id == "game_dvr_off" ? @tr("Background game recording") : row.id == "asus_services_off" ? @tr("ASUS services") : row.id == "defender_exclusions" ? @tr("Exclude game folders from Defender scans") : row.id == "defender_realtime_off" ? @tr("Defender real-time protection") : row.id == "memory_integrity_off" ? @tr("Memory integrity") : row.id
    }

    // Names Windows shows translated; the others are brands.
    public pure function app-name(package: string, name: string) -> string {
        package == "Microsoft.BingNews" ? @tr("News") : package == "Microsoft.BingWeather" ? @tr("Weather") : package == "Microsoft.GetHelp" ? @tr("Get Help") : package == "Microsoft.Getstarted" ? @tr("Tips") : package == "Microsoft.WindowsFeedbackHub" ? @tr("Feedback Hub") : package == "microsoft.windowscommunicationsapps" ? @tr("Mail and Calendar") : package == "Microsoft.People" ? @tr("People") : package == "Microsoft.WindowsMaps" ? @tr("Maps") : package == "Microsoft.MicrosoftStickyNotes" ? @tr("Sticky Notes") : package == "Microsoft.YourPhone" ? @tr("Phone Link") : package == "Microsoft.WindowsSoundRecorder" ? @tr("Sound Recorder") : package == "Microsoft.WindowsCalculator" ? @tr("Calculator") : package == "Microsoft.Windows.Photos" ? @tr("Photos") : package == "MicrosoftCorporationII.QuickAssist" ? @tr("Quick Assist") : package == "Microsoft.ZuneVideo" ? @tr("Movies & TV") : name
    }

    // The setting's state in Windows' own terms.
    public pure function value(row: TweakRow) -> string {
        if row.kind == 1 {
            return row.applied ? @tr("All applied") : @tr("{} to apply", row.count);
        }
        if row.kind == 3 {
            return row.applied ? @tr("Reinstall") : @tr("Remove");
        }
        if row.unavailable != "" {
            return @tr("Unavailable");
        }
        if row.id == "telemetry_min" {
            return row.applied ? @tr("Minimum") : @tr("Default");
        }
        // The *_off tweaks turn a feature off; the others turn one on.
        (row.applied != (row.id == "copilot_off" || row.id == "widgets_off" || row.id == "web_search_off" || row.id == "suggestions_off" || row.id == "lock_screen_tips_off" || row.id == "tips_off" || row.id == "background_apps_off" || row.id == "game_dvr_off" || row.id == "asus_services_off" || row.id == "defender_realtime_off" || row.id == "memory_integrity_off")) ? @tr("On") : @tr("Off")
    }

    public pure function desired(row: TweakRow, applied: bool) -> string {
        if row.id == "telemetry_min" { return applied ? @tr("Minimum") : @tr("Default"); }
        let on-when-applied = (root.value(row) == @tr("On")) == row.applied;
        (on-when-applied == applied) ? @tr("On") : @tr("Off")
    }

    // A consequence that is not obvious, "" when there is none.
    public pure function note(row: TweakRow, armed: bool) -> string {
        if row.kind == 0 {
            return row.id == "apps" ? @tr("Removed for this account only; each one can be installed again from the Microsoft Store.") : "";
        }
        if row.kind == 1 {
            return armed ? @tr("Also excludes the game folders from Defender scans.") : "";
        }
        if row.kind == 3 {
            return armed ? @tr("Can be installed again from the Microsoft Store.") : "";
        }
        if row.unavailable == "tamper_protection" {
            return @tr("Turn off Tamper Protection in Windows Security first.");
        }
        if row.unavailable == "locked" {
            return @tr("Locked by the firmware or by a policy.");
        }
        if row.unavailable == "no_game_folders" {
            return @tr("No game folder found.");
        }
        if row.unavailable != "" {
            return @tr("Not supported on this system.");
        }
        if row.reboot-pending {
            return @tr("Restart Windows to apply.");
        }
        row.id == "telemetry_min" ? @tr("Home and Pro editions keep the required level.") : row.id == "background_apps_off" ? @tr("Except Xbox, the Game Bar, the Store and Canapé's widget.") : row.id == "gpu_scheduling_on" ? @tr("Takes effect after a restart.") : row.id == "game_dvr_off" ? @tr("The Game Bar stays available.") : row.id == "asus_services_off" ? @tr("ASUS apps stop working ({} services).", row.count) : row.id == "defender_exclusions" ? @tr("{} game folders", row.count) : row.id == "defender_realtime_off" ? @tr("Leaves the device without antivirus protection. Windows may turn it back on.") : row.id == "memory_integrity_off" ? @tr("Less protection against malicious drivers. Restart needed.") : ""
    }
}

// A line: the label, its consequence below when there is one, the value
// on the right.
component TweakLine inherits Rectangle {
    in property <string> label;
    in property <string> note;
    in property <string> value;
    in property <bool> focused;
    in property <bool> enabled: true;
    // Waiting for a second A: the value and the note turn to warnings.
    in property <bool> armed;
    in property <bool> warn-note;
    callback clicked();
    border-radius: 10px;
    background: root.focused ? Theme.surface : transparent;
    opacity: root.enabled ? 1 : 0.4;
    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 16px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.label;
                color: Theme.text;
                font-size: 16px;
                font-weight: 500;
                overflow: elide;
            }

            if root.note != "": Text {
                text: root.note;
                color: root.armed || root.warn-note ? Theme.warn : Theme.dim;
                font-size: 13px;
                overflow: elide;
            }
        }

        Text {
            text: root.armed ? @tr("Press A again") : root.value;
            color: root.armed ? Theme.warn : root.focused ? Theme.accent-line : Theme.text.mix(Theme.dim, 0.6);
            font-size: 16px;
            font-weight: root.focused ? 600 : 500;
            vertical-alignment: center;
        }
    }

    if root.focused: Rectangle {
        border-radius: 10px;
        border-width: 2px;
        border-color: root.armed ? Theme.warn : Theme.focus;
    }

    TouchArea {
        z: -1;
        clicked => {
            root.clicked();
        }
    }
}

// A shelf with horizontal scrolling when a group has more than five cards.
component TweakShelf inherits Rectangle {
    in property <[TweakRow]> rows;
    in property <int> index;
    in property <int> front;
    in property <int> selected;
    in property <bool> active;
    in property <string> title;
    callback pick(int);
    y: root.index * Shelves.pitch;
    height: Shelves.pitch;
    visible: root.index >= root.front - 1 && root.index <= root.front + 1;
    Text {
        x: 48px;
        y: 0;
        height: 20px;
        text: root.title;
        color: Theme.text.mix(Theme.dim, 0.6);
        font-size: 15px;
        font-weight: 600;
        vertical-alignment: center;
    }
    Rectangle {
        x: 38px;
        y: Shelves.cards-top - 8px;
        width: parent.width - 38px;
        height: Shelves.card-height + 16px;
        clip: true;
        HorizontalLayout {
            x: 10px - max(0, root.selected - 4) * (Shelves.card-width + Shelves.card-gap);
            y: 8px;
            height: Shelves.card-height;
            spacing: Shelves.card-gap;
            alignment: start;
            for row[i] in root.rows: ShelfCard {
                label: Tweaks.label(row);
                wrap-label: true;
                value: Tweaks.value(row);
                icon: "range";
                enabled: App.status.connected && row.unavailable == "";
                focused: root.active && root.front == root.index && root.selected == i;
                clicked => { root.pick(i); }
            }
        }
    }
    Rectangle {
        background: Theme.background.with-alpha(root.index == root.front ? 0 : 0.6);
    }
}

export component TweaksPage inherits Rectangle {
    property <int> shelf: 0;
    property <int> card: 0;
    property <bool> open: false;
    property <bool> app-list: false;
    property <int> app-row: 0;
    property <int> choice: 0;
    property <bool> armed: false;
    property <bool> active: fs.has-focus;
    property <TweakRow> current-row: root.shelf == 1 ? Tweaks.clutter[root.card] : root.shelf == 2 ? Tweaks.privacy[root.card] : root.shelf == 3 ? Tweaks.games[root.card] : Tweaks.security[root.card];
    property <int> count: root.shelf == 0 ? 3 : root.shelf == 1 ? Tweaks.clutter.length : root.shelf == 2 ? Tweaks.privacy.length : root.shelf == 3 ? Tweaks.games.length : Tweaks.security.length;
    property <bool> busy: Tweaks.busy >= 0;
    property <HintSet> hints: root.app-list ? { move-glyph: "updown", move: @tr("Choose"), a: @tr("Apply"), b: @tr("Back") }
        : root.open ? { move-glyph: "leftright", move: @tr("Choose"), a: @tr("Apply"), b: @tr("Close") }
        : { move-glyph: "dpad", move: @tr("Shelves"), a: @tr("Open"), b: @tr("Back") };
    init => { Tweaks.open(); PageHints.current = root.hints; }
    changed hints => { PageHints.current = root.hints; }
    changed shelf => { root.card = 0; root.armed = false; }
    changed card => { root.armed = false; }
    changed app-row => { root.armed = false; }

    function activate() {
        if root.app-list {
            if root.app-row >= Tweaks.apps.length || root.busy { return; }
            let app = Tweaks.apps[root.app-row];
            if !app.applied && !root.armed { root.armed = true; return; }
            root.armed = false;
            if app.applied { Tweaks.reinstall-app(app.id); } else { Tweaks.remove-app(app.id); }
            return;
        }
        if root.open { root.apply(); return; }
        if root.shelf == 0 && root.card == 2 { root.app-list = true; root.app-row = 0; return; }
        if !App.status.connected || root.busy || (root.shelf > 0 && root.count == 0) { return; }
        root.open = true;
        root.armed = false;
        root.choice = root.shelf > 0 && !root.current-row.applied ? 1 : 0;
    }
    function apply() {
        if root.busy || !App.status.connected || (root.shelf > 0 && root.current-row.unavailable != "") { return; }
        if root.shelf == 0 {
            if (root.card == 0 && Tweaks.recommended.length == 0) || (root.card == 1 && Tweaks.owned.length == 0) { return; }
            if !root.armed { root.armed = true; return; }
            root.armed = false;
            if root.card == 0 { Tweaks.apply-recommended(); } else { Tweaks.revert-owned(); }
            root.open = false;
        } else {
            let applied = root.choice == 0;
            if applied == root.current-row.applied { root.open = false; return; }
            if applied && root.current-row.security && !root.armed { root.armed = true; return; }
            root.armed = false;
            Tweaks.set(root.current-row.id, applied);
            root.open = false;
        }
    }
    function select(s: int, c: int) { root.shelf = s; root.card = c; root.activate(); fs.focus(); }

    fs := FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape && (root.open || root.app-list) {
                root.open = false; root.app-list = false; root.armed = false; return accept;
            }
            if root.app-list {
                if event.text == Key.UpArrow || event.text == Key.DownArrow {
                    root.app-row = clamp(root.app-row + (event.text == Key.UpArrow ? -1 : 1), 0, max(0, Tweaks.apps.length - 1));
                    return accept;
                }
            } else if root.open {
                if event.text == Key.LeftArrow || event.text == Key.RightArrow {
                    root.choice = event.text == Key.LeftArrow ? 0 : 1; root.armed = false; return accept;
                }
            } else {
                if event.text == Key.UpArrow || event.text == Key.DownArrow {
                    root.shelf = clamp(root.shelf + (event.text == Key.UpArrow ? -1 : 1), 0, 4); return accept;
                }
                if event.text == Key.LeftArrow || event.text == Key.RightArrow {
                    root.card = clamp(root.card + (event.text == Key.LeftArrow ? -1 : 1), 0, max(0, root.count - 1)); return accept;
                }
            }
            if event.text == Key.Return || event.text == " " { root.activate(); return accept; }
            return reject;
        }
    }
    if !root.app-list: Text {
        x: 48px; y: 36px; width: parent.width - 96px;
        text: @tr("Windows tweaks"); color: Theme.text; font-size: 38px; font-weight: 700;
    }
    if Tweaks.error != "": Text {
        x: 48px; y: 90px; width: parent.width - 96px;
        text: Tweaks.error; color: Theme.warn; font-size: 14px; overflow: elide;
    }
    if !root.app-list: ShelfPane {
        y: 160px; width: parent.width; height: 330px; front: root.shelf;
        Shelf {
            x: 48px; width: parent.width - 48px; index: 0; front: root.shelf; icon: "range"; title: @tr("Windows tweaks");
            ShelfCard {
                label: @tr("Recommended"); value: Tweaks.rows.length > 0 ? Tweaks.value(Tweaks.rows[0]) : "…"; icon: "target";
                enabled: App.status.connected; focused: root.active && root.shelf == 0 && root.card == 0;
                clicked => { root.select(0, 0); }
            }
            ShelfCard {
                label: @tr("Restore"); value: Tweaks.owned.length; icon: "cycle";
                enabled: App.status.connected; focused: root.active && root.shelf == 0 && root.card == 1;
                clicked => { root.select(0, 1); }
            }
            ShelfCard {
                label: @tr("Applications"); value: Tweaks.apps.length; icon: "library";
                focused: root.active && root.shelf == 0 && root.card == 2;
                clicked => { root.select(0, 2); }
            }
        }
        TweakShelf { width: parent.width; index: 1; front: root.shelf; selected: root.card; active: root.active; rows: Tweaks.clutter; title: @tr("Copilot and ads"); pick(i) => { root.select(1, i); } }
        TweakShelf { width: parent.width; index: 2; front: root.shelf; selected: root.card; active: root.active; rows: Tweaks.privacy; title: @tr("Privacy"); pick(i) => { root.select(2, i); } }
        TweakShelf { width: parent.width; index: 3; front: root.shelf; selected: root.card; active: root.active; rows: Tweaks.games; title: @tr("Games"); pick(i) => { root.select(3, i); } }
        TweakShelf { width: parent.width; index: 4; front: root.shelf; selected: root.card; active: root.active; rows: Tweaks.security; title: @tr("Security"); pick(i) => { root.select(4, i); } }
    }
    if root.app-list: Rectangle {
        x: 48px; y: 30px; width: parent.width - 96px; height: parent.height - 40px;
        Text { x: 0; y: 0; width: parent.width; height: 36px; text: @tr("Preinstalled apps"); color: Theme.text; font-size: 24px; font-weight: 700; }
        list := Flickable {
            y: 50px; width: parent.width; height: parent.height - 50px; content-height: Tweaks.apps.length * 58px;
            content-y: -min(max(0px, root.app-row * 58px - self.height + 58px), max(0px, self.content-height - self.height));
            for app[i] in Tweaks.apps: TweakLine {
                y: i * 58px; width: list.width; height: 54px;
                label: Tweaks.label(app); value: Tweaks.value(app); note: Tweaks.note(app, root.armed && root.app-row == i);
                focused: root.active && root.app-row == i; armed: root.armed && root.app-row == i;
                clicked => { root.app-row = i; root.activate(); fs.focus(); }
            }
        }
    }
    Drawer {
        width: parent.width; page-height: parent.height; open: root.open;
        sheet-height: root.shelf == 0 ? 480px : 220px;
        title: root.shelf == 0 ? (root.card == 0 ? @tr("Apply the recommended settings") : @tr("Restore my changes")) : Tweaks.label(root.current-row);
        note: root.armed ? @tr("Press A again") : "";
        if root.shelf == 0: Rectangle {
            for row[i] in root.card == 0 ? Tweaks.recommended : Tweaks.owned: Text {
                x: Math.mod(i, 2) * (parent.width / 2); y: Math.floor(i / 2) * 38px;
                width: parent.width / 2 - 16px; height: 36px;
                text: Tweaks.label(row) + (root.card == 0 ? " · " + Tweaks.desired(row, true) : ""); color: row.security ? Theme.warn : Theme.text; font-size: 14px; wrap: word-wrap; overflow: elide;
            }
            Text {
                y: parent.height - 28px; width: parent.width; height: 28px;
                text: root.card == 0 ? (Tweaks.recommended-exclusions ? @tr("Also excludes the game folders from Defender scans.") : "") : @tr("Removed apps are not reinstalled.");
                color: Theme.warn; font-size: 13px; overflow: elide;
            }
        }
        if root.shelf > 0: VerticalLayout {
            spacing: 8px; alignment: start;
            if root.current-row.unavailable == "": HorizontalLayout {
                spacing: 12px; alignment: start;
                for i in 2: ChoiceTile {
                width: 180px;
                label: Tweaks.desired(root.current-row, i == 0);
                selected: (i == 0) == root.current-row.applied;
                focused: root.active && root.choice == i;
                    clicked => { root.choice = i; root.apply(); fs.focus(); }
                }
            }
            if Tweaks.note(root.current-row, true) != "": Text {
                text: Tweaks.note(root.current-row, true); color: root.current-row.security ? Theme.warn : Theme.dim;
                font-size: 14px; wrap: word-wrap;
            }
        }
    }
}
