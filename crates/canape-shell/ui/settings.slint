// Settings page: Canapé's version, the service and the accounts at the
// top, then three shelves of setting cards, moved through as on the
// performance page. A opens the card's drawer (or the games to add and
// the game profiles, which are pages of their own). Cards:
//   shelf 0, appearance: language, accent colour, the Ally's buttons;
//   shelf 1, library: games folder, missing covers, add a game, game
//   profiles;
//   shelf 2, accounts: Steam, Epic Games, time to beat (IGDB);
//   shelf 3, system: Windows tweaks (a page of its own), the welcome tour
//   again, full power while Canapé is in front, the display (software
//   renderer or graphics card).
// In the language drawer the arrows move over the languages and A applies
// one; in the accent drawer, up and down go from the presets (A applies
// one) to the hue, saturation and brightness tracks, which left and right
// move.

import { Theme } from "theme.slint";
import { App } from "state.slint";
import { Library } from "library.slint";
import { Onboarding } from "onboarding.slint";
import { ChoiceTile, Drawer, HeroLine, HintSet, PageHints, SettingLine, Shelf, ShelfCard, ShelfPane, Swatch, TrackLine } from "kit.slint";

// An account in the hero: the store, then who is signed in.
component AccountChip inherits Rectangle {
    in property <string> text;
    in property <bool> signed-in;
    height: 32px;
    width: label.preferred-width + 28px;
    border-radius: 16px;
    background: Theme.card;
    label := Text {
        text: root.text;
        color: root.signed-in ? Theme.text.mix(Theme.dim, 0.6) : Theme.dim;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component SettingsPage inherits Rectangle {
    // Opens the game profiles, and the list of games to add.
    callback open-profiles();
    callback open-tweaks();
    callback open-add-games();
    in-out property <int> shelf: 0;
    in-out property <int> card: 0;
    // The card whose drawer is open, "" when none; `sheet` keeps the last
    // one so the drawer keeps its content while it closes.
    in-out property <string> drawer;
    property <string> sheet;
    property <bool> open: root.drawer != "";
    property <bool> active: fs.has-focus;
    property <string> focused-key: root.key(root.shelf, root.card);

    property <[{ code: string, name: string }]> languages: [
        { code: "auto", name: @tr("Automatic") },
        { code: "en", name: "English" },
        { code: "fr", name: "Français" },
        { code: "es", name: "Español" },
        { code: "de", name: "Deutsch" },
        { code: "it", name: "Italiano" },
        { code: "pt", name: "Português" },
        { code: "nl", name: "Nederlands" },
        { code: "pl", name: "Polski" },
        { code: "ru", name: "Русский" },
        { code: "tr", name: "Türkçe" },
        { code: "ja", name: "日本語" },
        { code: "ko", name: "한국어" },
        { code: "zh_CN", name: "简体中文" },
    ];
    property <int> language-index: App.language == "en" ? 1 : App.language == "fr" ? 2 : App.language == "es" ? 3 : App.language == "de" ? 4 : App.language == "it" ? 5 : App.language == "pt" ? 6 : App.language == "nl" ? 7 : App.language == "pl" ? 8 : App.language == "ru" ? 9 : App.language == "tr" ? 10 : App.language == "ja" ? 11 : App.language == "ko" ? 12 : App.language == "zh_CN" ? 13 : 0;
    // The language the focus is on in the drawer; A applies it.
    in-out property <int> language-pick: root.language-index;
    // The hex code is what gets saved; the colour, what gets drawn.
    property <[{ hex: string, color: color }]> presets: [
        { hex: "#ff3d5e", color: #ff3d5e },
        { hex: "#f97316", color: #f97316 },
        { hex: "#eab308", color: #eab308 },
        { hex: "#10b981", color: #10b981 },
        { hex: "#06b6d4", color: #06b6d4 },
        { hex: "#3b82f6", color: #3b82f6 },
        { hex: "#8b5cf6", color: #8b5cf6 },
        { hex: "#ec4899", color: #ec4899 },
    ];
    in-out property <int> preset-col: 0;
    // Accent drawer: 0 the presets, 1 hue, 2 saturation, 3 brightness.
    in-out property <int> accent-row: 0;
    // On / off drawers: 0 on, 1 off.
    in-out property <int> toggle-col: 0;
    // Darkest accent the picker allows: below, it no longer reads on the
    // dark background.
    property <float> min-value: 0.4;

    property <HintSet> hints: !root.open ? {
        move-glyph: "dpad",
        move: @tr("Shelves"),
        a: root.focused-key == "add" || root.focused-key == "profiles" || root.focused-key == "tour" || root.focused-key == "tweaks" ? @tr("Open") : @tr("Adjust"),
        b: @tr("Back"),
    } : root.drawer == "language" ? {
        move-glyph: "dpad",
        move: @tr("Choose"),
        a: @tr("Apply"),
        b: @tr("Close"),
    } : root.drawer == "accent" ? {
        move-glyph: "updown",
        move: @tr("Setting"),
        move2-glyph: "leftright",
        move2: @tr("Value"),
        a: root.accent-row == 0 ? @tr("Apply") : "",
        b: @tr("Close"),
    } : root.drawer == "ally" || root.drawer == "covers" || root.drawer == "uipower" || root.drawer == "display" ? {
        move-glyph: "leftright",
        move: @tr("Choose"),
        a: @tr("Apply"),
        b: @tr("Close"),
    } : root.drawer == "folder" ? {
        move-glyph: "leftright",
        move: @tr("Value"),
        b: @tr("Close"),
    } : root.drawer == "epic" ? {
        a: @tr("Sign in"),
        b: @tr("Close"),
    } : {
        b: @tr("Close"),
    };
    init => {
        PageHints.current = self.hints;
    }
    changed hints => {
        PageHints.current = self.hints;
    }

    pure function key(s: int, c: int) -> string {
        s == 0 ? ["language", "accent", "ally"][c] : s == 1 ? ["folder", "covers", "add", "profiles"][c] : s == 2 ? ["steam", "epic", "igdb"][c] : ["tweaks", "tour", "uipower", "display"][c]
    }
    pure function cards(s: int) -> int {
        s == 0 || s == 2 ? 3 : 4
    }
    // The setting behind an On / Off drawer.
    pure function toggle-value(key: string) -> bool {
        key == "ally" ? App.ally-buttons : key == "covers" ? App.online-covers : App.status.ui-power-enabled
    }
    function activate() {
        if root.focused-key == "add" {
            root.open-add-games();
        } else if root.focused-key == "profiles" {
            root.open-profiles();
        } else if root.focused-key == "tweaks" {
            root.open-tweaks();
        } else if root.focused-key == "tour" {
            Onboarding.replay();
        } else {
            root.language-pick = root.language-index;
            root.accent-row = 0;
            root.toggle-col = root.focused-key == "display" ? (App.gpu-renderer ? 1 : 0) : root.toggle-value(root.focused-key) ? 0 : 1;
            root.sheet = root.focused-key;
            root.drawer = root.focused-key;
        }
    }
    function hue(d: int) {
        // 360° is 0° again: stop just before, so the knob stays right.
        App.pick-accent-hsv(clamp(Theme.accent-hue + d * 5, 0, 359), Theme.accent-saturation, Theme.accent-value);
    }
    function saturation(d: int) {
        App.pick-accent-hsv(Theme.accent-hue, clamp(Theme.accent-saturation + d * 0.05, 0, 1), Theme.accent-value);
    }
    function brightness(d: int) {
        App.pick-accent-hsv(Theme.accent-hue, Theme.accent-saturation, clamp(Theme.accent-value + d * 0.05, root.min-value, 1));
    }
    // Left (-1) or right (1) in the open drawer.
    function side(d: int) {
        if root.drawer == "language" {
            root.language-pick = clamp(root.language-pick + d, 0, root.languages.length - 1);
        } else if root.drawer == "accent" {
            if root.accent-row == 0 {
                root.preset-col = clamp(root.preset-col + d, 0, root.presets.length - 1);
            } else if root.accent-row == 1 {
                root.hue(d);
            } else if root.accent-row == 2 {
                root.saturation(d);
            } else {
                root.brightness(d);
            }
        } else if root.drawer == "ally" || root.drawer == "covers" || root.drawer == "uipower" || root.drawer == "display" {
            root.toggle-col = clamp(root.toggle-col + d, 0, 1);
        } else if root.drawer == "folder" {
            Library.games-folder-step(d);
        }
    }
    // Up (-1) or down (1) in the open drawer.
    function vertical(d: int) {
        if root.drawer == "language" {
            let to = root.language-pick + d * 7;
            if to >= 0 && to < root.languages.length {
                root.language-pick = to;
            }
        } else if root.drawer == "accent" {
            root.accent-row = clamp(root.accent-row + d, 0, 3);
        }
    }
    function apply() {
        if root.drawer == "language" {
            App.set-language(root.languages[root.language-pick].code);
        } else if root.drawer == "accent" {
            if root.accent-row == 0 {
                App.pick-accent(root.presets[root.preset-col].hex);
            }
        } else if root.drawer == "ally" {
            if App.ally-buttons != (root.toggle-col == 0) {
                App.toggle-ally-buttons();
            }
        } else if root.drawer == "covers" {
            if App.online-covers != (root.toggle-col == 0) {
                App.toggle-online-covers();
            }
        } else if root.drawer == "uipower" {
            if App.status.ui-power-enabled != (root.toggle-col == 0) {
                App.set-ui-power(root.toggle-col == 0);
            }
        } else if root.drawer == "display" {
            if App.gpu-renderer != (root.toggle-col == 1) {
                App.set-gpu-renderer(root.toggle-col == 1);
            }
        } else if root.drawer == "epic" {
            if !Library.epic-busy {
                Library.epic-login();
            }
        } else {
            root.drawer = "";
        }
    }

    property <length> sheet-height: root.sheet == "language" ? 232px : root.sheet == "accent" ? 254px : 186px;
    // A taller drawer lifts the shelves so the card stays in view.
    property <length> lift: root.open ? max(0px, 420px - (root.height - root.sheet-height)) : 0px;

    fs := FocusScope {
        init => {
            self.focus();
        }
        key-pressed(event) => {
            if root.open {
                if event.text == Key.Escape {
                    root.drawer = "";
                } else if event.text == Key.LeftArrow || event.text == Key.RightArrow {
                    root.side(event.text == Key.LeftArrow ? -1 : 1);
                } else if event.text == Key.UpArrow || event.text == Key.DownArrow {
                    root.vertical(event.text == Key.UpArrow ? -1 : 1);
                } else if event.text == Key.Return || event.text == " " {
                    root.apply();
                }
                return accept;
            }
            if event.text == Key.UpArrow || event.text == Key.DownArrow {
                root.shelf = clamp(root.shelf + (event.text == Key.UpArrow ? -1 : 1), 0, 3);
                root.card = min(root.card, root.cards(root.shelf) - 1);
                return accept;
            }
            if event.text == Key.LeftArrow || event.text == Key.RightArrow {
                root.card = clamp(root.card + (event.text == Key.LeftArrow ? -1 : 1), 0, root.cards(root.shelf) - 1);
                return accept;
            }
            if event.text == Key.Return || event.text == " " {
                root.activate();
                return accept;
            }
            return reject;
        }
    }

    // Canapé itself: its version, the service, the accounts.
    HorizontalLayout {
        x: 48px;
        y: 36px;
        width: parent.width - 96px;
        height: 110px;
        spacing: 40px;
        VerticalLayout {
            spacing: 8px;
            alignment: end;
            HeroLine {
                title: "Canapé";
                detail: App.version;
            }

            Text {
                text: App.status.connected ? @tr("Service connected") : @tr("Service not connected");
                color: App.status.connected ? Theme.text : Theme.warn;
                font-size: 44px;
                font-weight: 700;
                letter-spacing: -1px;
            }

            Text {
                text: Library.install-error != "" ? Library.install-error : @tr("Installed · {}", Library.total);
                color: Library.install-error != "" ? Theme.warn : Theme.dim;
                font-size: 13px;
                overflow: elide;
            }
        }

        HorizontalLayout {
            horizontal-stretch: 1;
            alignment: end;
            spacing: 10px;
            padding-bottom: 4px;
            VerticalLayout {
                alignment: end;
                AccountChip {
                    text: "Steam · " + (Library.steam-key ? @tr("API key") : @tr("No API key"));
                    signed-in: Library.steam-key;
                }
            }

            VerticalLayout {
                alignment: end;
                AccountChip {
                    text: "Epic · " + (Library.epic-account != "" ? Library.epic-account : @tr("not signed in"));
                    signed-in: Library.epic-account != "";
                }
            }

        }
    }

    ShelfPane {
        x: 0;
        y: 256px - root.lift;
        animate y { duration: Theme.motion(200ms); easing: cubic-bezier(0.16, 1, 0.3, 1); }
        width: parent.width;
        height: 330px;
        front: root.shelf;

        Shelf {
            x: 48px;
            width: parent.width - 48px;
            index: 0;
            front: root.shelf;
            icon: "palette";
            title: @tr("Appearance");
            ShelfCard {
                label: @tr("Language");
                icon: "globe";
                value: root.languages[root.language-index].name;
                focused: root.active && root.shelf == 0 && root.card == 0;
                clicked => {
                    root.shelf = 0;
                    root.card = 0;
                    root.activate();
                    fs.focus();
                }
            }

            ShelfCard {
                label: @tr("Accent colour");
                icon: "drop";
                value: Theme.accent-hex.to-uppercase();
                focused: root.active && root.shelf == 0 && root.card == 1;
                clicked => {
                    root.shelf = 0;
                    root.card = 1;
                    root.activate();
                    fs.focus();
                }
            }

            ShelfCard {
                label: @tr("The Ally's buttons");
                icon: "gamepad";
                value: App.ally-buttons ? @tr("On") : @tr("Off");
                focused: root.active && root.shelf == 0 && root.card == 2;
                clicked => {
                    root.shelf = 0;
                    root.card = 2;
                    root.activate();
                    fs.focus();
                }
            }
        }

        Shelf {
            x: 48px;
            width: parent.width - 48px;
            index: 1;
            front: root.shelf;
            icon: "library";
            title: @tr("Library");
            ShelfCard {
                label: @tr("Games folder");
                icon: "folder";
                value: Library.games-folder != "" ? Library.games-folder : "—";
                focused: root.active && root.shelf == 1 && root.card == 0;
                clicked => {
                    root.shelf = 1;
                    root.card = 0;
                    root.activate();
                    fs.focus();
                }
            }

            ShelfCard {
                label: @tr("Missing covers");
                icon: "image";
                value: App.online-covers ? @tr("On") : @tr("Off");
                focused: root.active && root.shelf == 1 && root.card == 1;
                clicked => {
                    root.shelf = 1;
                    root.card = 1;
                    root.activate();
                    fs.focus();
                }
            }

            ShelfCard {
                label: @tr("Add a game");
                icon: "plus";
                value: Library.external;
                focused: root.active && root.shelf == 1 && root.card == 2;
                clicked => {
                    root.shelf = 1;
                    root.card = 2;
                    root.activate();
                    fs.focus();
                }
            }

            ShelfCard {
                label: @tr("Game profiles");
                icon: "profiles";
                value: App.profiles.length;
                focused: root.active && root.shelf == 1 && root.card == 3;
                clicked => {
                    root.shelf = 1;
                    root.card = 3;
                    root.activate();
                    fs.focus();
                }
            }
        }

        Shelf {
            x: 48px;
            width: parent.width - 48px;
            index: 2;
            front: root.shelf;
            icon: "user";
            title: @tr("Accounts");
            ShelfCard {
                label: "Steam";
                store: "Steam";
                value: Library.steam-key ? @tr("API key") : @tr("No API key");
                focused: root.active && root.shelf == 2 && root.card == 0;
                clicked => {
                    root.shelf = 2;
                    root.card = 0;
                    root.activate();
                    fs.focus();
                }
            }

            ShelfCard {
                label: "Epic Games";
                store: "Epic";
                value: Library.epic-busy || Library.epic-waiting ? "…" : Library.epic-account != "" ? Library.epic-account : @tr("Sign in");
                focused: root.active && root.shelf == 2 && root.card == 1;
                clicked => {
                    root.shelf = 2;
                    root.card = 1;
                    root.activate();
                    fs.focus();
                }
            }

            ShelfCard {
                label: @tr("Time to beat");
                icon: "hourglass";
                value: Library.igdb-keys ? "IGDB" : @tr("Off");
                focused: root.active && root.shelf == 2 && root.card == 2;
                clicked => {
                    root.shelf = 2;
                    root.card = 2;
                    root.activate();
                    fs.focus();
                }
            }
        }

        Shelf {
            x: 48px;
            width: parent.width - 48px;
            index: 3;
            front: root.shelf;
            icon: "screen";
            title: @tr("System");
            ShelfCard {
                label: @tr("Windows tweaks");
                icon: "dial";
                focused: root.active && root.shelf == 3 && root.card == 0;
                clicked => {
                    root.shelf = 3;
                    root.card = 0;
                    root.activate();
                    fs.focus();
                }
            }

            ShelfCard {
                label: @tr("Welcome tour");
                icon: "gamepad";
                focused: root.active && root.shelf == 3 && root.card == 1;
                clicked => {
                    root.shelf = 3;
                    root.card = 1;
                    root.activate();
                    fs.focus();
                }
            }

            ShelfCard {
                label: @tr("Full power in Canapé");
                icon: "gauge";
                value: App.status.ui-power-enabled ? @tr("On") : @tr("Off");
                focused: root.active && root.shelf == 3 && root.card == 2;
                clicked => {
                    root.shelf = 3;
                    root.card = 2;
                    root.activate();
                    fs.focus();
                }
            }

            ShelfCard {
                label: @tr("Display");
                icon: "screen";
                value: App.gpu-renderer ? @tr("Smooth") : @tr("Efficient");
                focused: root.active && root.shelf == 3 && root.card == 3;
                clicked => {
                    root.shelf = 3;
                    root.card = 3;
                    root.activate();
                    fs.focus();
                }
            }
        }
    }

    Drawer {
        width: parent.width;
        page-height: parent.height;
        open: root.open;
        sheet-height: root.sheet-height;
        title: root.sheet == "language" ? @tr("Language") : root.sheet == "accent" ? @tr("Accent colour") : root.sheet == "ally" ? @tr("Use the Ally's buttons") : root.sheet == "folder" ? @tr("Games folder") : root.sheet == "covers" ? @tr("Download missing covers") : root.sheet == "steam" ? "Steam" : root.sheet == "epic" ? @tr("Epic Games account") : root.sheet == "uipower" ? @tr("Full power in Canapé") : root.sheet == "display" ? @tr("Display") : @tr("Time to beat");
        note: root.sheet == "folder" && Library.games-free-tenths >= 0 ? @tr("{} GB free", App.tenths(Library.games-free-tenths))
            : root.sheet == "accent" ? Theme.accent-hex.to-uppercase()
            : root.sheet == "display" ? @tr("Smooth uses about 300 MB more memory, also during games. Canapé restarts.")
            : root.sheet == "steam" ? (Library.steam-key ? @tr("Steam API key set") : @tr("No Steam API key"))
            : root.sheet == "epic" ? (Library.epic-busy ? @tr("Opening the Epic sign-in…") : Library.epic-waiting ? @tr("Waiting for the Epic code…") : Library.epic-account)
            : "";

        if root.sheet == "language": VerticalLayout {
            spacing: 10px;
            alignment: start;
            for r in 2: HorizontalLayout {
                spacing: 10px;
                for c in 7: ChoiceTile {
                    horizontal-stretch: 1;
                    preferred-width: 10px;
                    height: 48px;
                    label: root.languages[r * 7 + c].name;
                    selected: root.language-index == r * 7 + c;
                    focused: root.active && root.language-pick == r * 7 + c;
                    clicked => {
                        root.language-pick = r * 7 + c;
                        root.apply();
                        fs.focus();
                    }
                }
            }
        }

        if root.sheet == "accent": HorizontalLayout {
            spacing: 40px;
            Rectangle {
                width: 8 * 40px + 7 * 12px + 24px;
                height: 64px;
                border-radius: 10px;
                background: root.active && root.accent-row == 0 ? Theme.surface-high : transparent;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 12px;
                    for preset[i] in root.presets: VerticalLayout {
                        alignment: center;
                        Swatch {
                            swatch: preset.color;
                            selected: Theme.accent-hex == preset.hex;
                            focused: root.active && root.accent-row == 0 && root.preset-col == i;
                            clicked => {
                                root.accent-row = 0;
                                root.preset-col = i;
                                App.pick-accent(preset.hex);
                                fs.focus();
                            }
                        }
                    }
                }
            }

            VerticalLayout {
                spacing: 4px;
                alignment: start;
                TrackLine {
                    height: 42px;
                    label: @tr("Hue");
                    value: Theme.accent-hue / 360;
                    track: @linear-gradient(90deg, hsv(0, 1, 1) 0%, hsv(60, 1, 1) 16.7%, hsv(120, 1, 1) 33.3%, hsv(180, 1, 1) 50%, hsv(240, 1, 1) 66.7%, hsv(300, 1, 1) 83.3%, hsv(359, 1, 1) 100%);
                    focused: root.active && root.accent-row == 1;
                    moved(v) => {
                        root.accent-row = 1;
                        App.pick-accent-hsv(min(v, 0.999) * 360, Theme.accent-saturation, Theme.accent-value);
                        fs.focus();
                    }
                }

                TrackLine {
                    height: 42px;
                    label: @tr("Saturation");
                    value: Theme.accent-saturation;
                    track: @linear-gradient(90deg, hsv(Theme.accent-hue, 0, Theme.accent-value) 0%, hsv(Theme.accent-hue, 1, Theme.accent-value) 100%);
                    focused: root.active && root.accent-row == 2;
                    moved(v) => {
                        root.accent-row = 2;
                        App.pick-accent-hsv(Theme.accent-hue, v, Theme.accent-value);
                        fs.focus();
                    }
                }

                TrackLine {
                    height: 42px;
                    label: @tr("Brightness");
                    value: max(0, (Theme.accent-value - root.min-value) / (1 - root.min-value));
                    track: @linear-gradient(90deg, hsv(Theme.accent-hue, Theme.accent-saturation, root.min-value) 0%, hsv(Theme.accent-hue, Theme.accent-saturation, 1) 100%);
                    focused: root.active && root.accent-row == 3;
                    moved(v) => {
                        root.accent-row = 3;
                        App.pick-accent-hsv(Theme.accent-hue, Theme.accent-saturation, root.min-value + v * (1 - root.min-value));
                        fs.focus();
                    }
                }
            }
        }

        if root.sheet == "ally" || root.sheet == "covers" || root.sheet == "uipower": HorizontalLayout {
            spacing: 12px;
            alignment: start;
            for i in 2: ChoiceTile {
                width: 180px;
                label: i == 0 ? @tr("On") : @tr("Off");
                selected: root.toggle-value(root.sheet) == (i == 0);
                focused: root.active && root.toggle-col == i;
                clicked => {
                    root.toggle-col = i;
                    root.apply();
                    fs.focus();
                }
            }
        }

        if root.sheet == "display": HorizontalLayout {
            spacing: 12px;
            alignment: start;
            for i in 2: ChoiceTile {
                width: 180px;
                label: i == 0 ? @tr("Efficient") : @tr("Smooth");
                selected: App.gpu-renderer == (i == 1);
                focused: root.active && root.toggle-col == i;
                clicked => {
                    root.toggle-col = i;
                    root.apply();
                    fs.focus();
                }
            }
        }

        if root.sheet == "folder": SettingLine {
            x: 0;
            y: 0;
            width: 720px;
            label: @tr("Games folder");
            value: Library.games-folder;
            focused: root.active;
            step(d) => {
                Library.games-folder-step(d);
                fs.focus();
            }
        }

        if root.sheet == "steam" || root.sheet == "igdb": Text {
            x: 0;
            y: 0;
            width: 900px;
            text: root.sheet == "steam" ? @tr("Add your Steam Web API key (steamcommunity.com/dev/apikey) as steam_api_key in shell.json: Canapé then lists the games you own, to install them from the library.") : @tr("Add the client id and secret of a Twitch application as igdb_client_id and igdb_client_secret in shell.json: game pages then show how long a game takes to beat.");
            color: Theme.text.mix(Theme.dim, 0.6);
            font-size: 15px;
            wrap: word-wrap;
        }

        if root.sheet == "epic": Text {
            x: 0;
            y: 0;
            width: 900px;
            text: Library.epic-waiting ? @tr("Sign in to Epic in the browser, then copy the page it lands on (or its authorizationCode): Canapé reads it from the clipboard.") : @tr("Canapé installs Epic games without their launcher once you are signed in.");
            color: Theme.text.mix(Theme.dim, 0.6);
            font-size: 15px;
            wrap: word-wrap;
        }
    }
}
