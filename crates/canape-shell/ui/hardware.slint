// Hardware page: rows the D-pad moves through, as on the performance page.
// Left and right move along a row of tiles or change the row's value; A
// picks a tile; X saves the fans and the frame rate cap for the game in
// the foreground:
//   0 fan presets, 1 frame rate cap, 2 controller mode, 3 refresh rate
// (when the screen reports its rates), then gyro aiming, which A opens.

import { Theme } from "theme.slint";
import { App } from "state.slint";
import { ChoiceTile, Figure, IconTile, LegendKey, Row, Ruler, SectionTitle, SettingLine } from "kit.slint";

// The CPU fan's custom curve: duty (0 to 100 %) against temperature
// (20 to 110 °C), from hardware.rs.
component Curve inherits Rectangle {
    in property <string> line;
    in property <string> area;
    clip: true;

    // The half-scale guide, only under a curve: it would cross the text.
    if root.line != "": Rectangle {
        y: parent.height / 2;
        height: 1px;
        background: Theme.stroke.with-alpha(0.45);
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.stroke;
    }

    if root.area != "": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 90;
        viewbox-height: 100;
        fit: fill;
        commands: root.area;
        fill: Theme.accent.with-alpha(0.16);
        stroke: transparent;
        stroke-width: 2px;
    }
    if root.line != "": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 90;
        viewbox-height: 100;
        fit: fill;
        commands: root.line;
        stroke: Theme.accent;
        stroke-width: 2.5px;
        stroke-line-join: round;
    }
    if root.line == "": Text {
        width: parent.width;
        height: parent.height;
        text: @tr("The power mode's own curve");
        color: Theme.dim;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component HardwarePage inherits Rectangle {
    callback open-gyro();
    in-out property <int> focus-row: 0;
    in-out property <int> fan-col: root.fan-index >= 0 ? root.fan-index : 0;
    in-out property <int> controller-col: root.controller-index >= 0 ? root.controller-index : 0;
    in-out property <int> refresh-col: root.refresh-index >= 0 ? root.refresh-index : 0;
    property <bool> active: fs.has-focus;
    property <[string]> fan-presets: ["", "balanced", "max-cooling"];
    property <int> fan-index: !App.status.connected ? -1 : App.status.fan-preset == "" ? 0 : App.status.fan-preset == "balanced" ? 1 : App.status.fan-preset == "max-cooling" ? 2 : -1;
    property <[string]> controllers: ["gamepad", "wasd", "mouse"];
    property <int> controller-index: App.status.controller == "gamepad" ? 0 : App.status.controller == "wasd" ? 1 : App.status.controller == "mouse" ? 2 : -1;
    property <[int]> fps-stops: [0, 30, 40, 45, 60, 90, 120];
    property <int> fps-index: App.status.fps-limit <= 0 ? 0 : App.status.fps-limit <= 30 ? 1 : App.status.fps-limit <= 40 ? 2 : App.status.fps-limit <= 45 ? 3 : App.status.fps-limit <= 60 ? 4 : App.status.fps-limit <= 90 ? 5 : 6;
    property <int> refresh-index: root.index-of-refresh(App.refresh-hz);
    property <int> gyro-row: App.refresh-rates.length > 0 ? 4 : 3;
    property <int> rows: root.gyro-row + 1;

    pure function index-of-refresh(hz: int) -> int {
        // Past the end, an array reads as 0.
        hz <= 0 ? -1 : hz == App.refresh-rates[0] ? 0 : hz == App.refresh-rates[1] ? 1 : hz == App.refresh-rates[2] ? 2 : hz == App.refresh-rates[3] ? 3 : hz == App.refresh-rates[4] ? 4 : hz == App.refresh-rates[5] ? 5 : -1
    }
    function side(d: int) {
        if root.focus-row == 0 {
            root.fan-col = clamp(root.fan-col + d, 0, 2);
        } else if root.focus-row == 1 {
            App.set-fps-limit(root.fps-stops[clamp(root.fps-index + d, 0, 6)]);
        } else if root.focus-row == 2 {
            root.controller-col = clamp(root.controller-col + d, 0, 2);
        } else if root.focus-row != root.gyro-row {
            root.refresh-col = clamp(root.refresh-col + d, 0, App.refresh-rates.length - 1);
        }
    }
    function activate() {
        if root.focus-row == 0 {
            App.set-fan-preset(root.fan-presets[root.fan-col]);
        } else if root.focus-row == 2 {
            App.set-controller(root.controllers[root.controller-col]);
        } else if root.focus-row == root.gyro-row {
            root.open-gyro();
        } else if root.focus-row == 3 {
            App.set-refresh(App.refresh-rates[root.refresh-col]);
        }
    }

    fs := FocusScope {
        init => {
            self.focus();
        }
        key-pressed(event) => {
            if event.text == Key.UpArrow {
                root.focus-row = max(0, root.focus-row - 1);
                return accept;
            }
            if event.text == Key.DownArrow {
                root.focus-row = min(root.rows - 1, root.focus-row + 1);
                return accept;
            }
            // Only the screen works without the service.
            if !App.status.connected && (root.focus-row != 3 || root.gyro-row == 3) {
                return reject;
            }
            if event.text == Key.LeftArrow {
                root.side(-1);
                return accept;
            }
            if event.text == Key.RightArrow {
                root.side(1);
                return accept;
            }
            if event.text == Key.Return || event.text == " " {
                root.activate();
                return accept;
            }
            // X: keep the fans and the frame rate cap for this game.
            if (event.text == Key.F2 || event.text == "x") && App.status.foreground != "" {
                App.save-hardware-profile();
                return accept;
            }
            return reject;
        }
    }

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        spacing: 40px;

        VerticalLayout {
            width: 784px;
            spacing: 10px;

            Row {
                focused: root.active && root.focus-row == 0;
                enabled: App.status.connected;
                VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 14px;
                    padding-bottom: 14px;
                    spacing: 12px;
                    HorizontalLayout {
                        SectionTitle {
                            text: @tr("Fans");
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: App.status.fan-preset == "custom" ? @tr("Custom curves set by another client.") : App.status.foreground != "" ? @tr("{} · game profile", App.status.foreground) : "";
                            color: Theme.dim;
                            font-size: 13px;
                            horizontal-alignment: right;
                            // Top, like the title: the row may be taller than both.
                            vertical-alignment: top;
                            overflow: elide;
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        for icon[i] in ["cycle", "balanced", "wind"]: IconTile {
                            horizontal-stretch: 1;
                            preferred-width: 10px;
                            icon: icon;
                            label: i == 0 ? @tr("Automatic") : i == 1 ? @tr("Balanced") : @tr("Maximum");
                            selected: root.fan-index == i;
                            focused: root.active && root.focus-row == 0 && root.fan-col == i;
                            clicked => {
                                root.focus-row = 0;
                                root.fan-col = i;
                                root.activate();
                                fs.focus();
                            }
                        }
                    }
                }
            }

            Row {
                focused: root.active && root.focus-row == 1;
                enabled: App.status.connected;
                VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 14px;
                    padding-bottom: 14px;
                    spacing: 12px;
                    SectionTitle {
                        text: @tr("Frame rate limit");
                    }

                    Ruler {
                        labels: [@tr("None"), App.fps-value(30), App.fps-value(40), App.fps-value(45), App.fps-value(60), App.fps-value(90), App.fps-value(120)];
                        selected: App.status.connected ? root.fps-index : -1;
                        fill: false;
                        pick(i) => {
                            root.focus-row = 1;
                            App.set-fps-limit(root.fps-stops[i]);
                            fs.focus();
                        }
                    }
                }
            }

            Row {
                focused: root.active && root.focus-row == 2;
                enabled: App.status.connected;
                VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 14px;
                    padding-bottom: 14px;
                    spacing: 12px;
                    SectionTitle {
                        text: @tr("Controller");
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        for icon[i] in ["gamepad", "keyboard", "mouse"]: IconTile {
                            horizontal-stretch: 1;
                            preferred-width: 10px;
                            height: 76px;
                            icon: icon;
                            label: i == 0 ? @tr("Gamepad") : i == 1 ? @tr("Keyboard") : @tr("Mouse");
                            selected: root.controller-index == i;
                            focused: root.active && root.focus-row == 2 && root.controller-col == i;
                            clicked => {
                                root.focus-row = 2;
                                root.controller-col = i;
                                root.activate();
                                fs.focus();
                            }
                        }
                    }
                }
            }

            if App.refresh-rates.length > 0: Row {
                focused: root.active && root.focus-row == 3;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    spacing: 12px;
                    SectionTitle {
                        width: 150px;
                        text: @tr("Screen");
                        vertical-alignment: center;
                    }

                    for hz[i] in App.refresh-rates: ChoiceTile {
                        horizontal-stretch: 1;
                        preferred-width: 10px;
                        label: @tr("{} Hz", hz);
                        selected: App.refresh-hz == hz;
                        focused: root.active && root.focus-row == 3 && root.refresh-col == i;
                        clicked => {
                            root.focus-row = 3;
                            root.refresh-col = i;
                            root.activate();
                            fs.focus();
                        }
                    }
                }
            }

            SettingLine {
                label: @tr("Gyro aiming");
                value: App.gyro-name(App.status.gyro-activation) + " ›";
                chevrons: false;
                enabled: App.status.connected;
                focused: root.active && root.focus-row == root.gyro-row;
                clicked => {
                    root.focus-row = root.gyro-row;
                    root.activate();
                }
            }

            Rectangle {
                vertical-stretch: 1;
            }
        }

        VerticalLayout {
            padding-top: 12px;
            spacing: 26px;
            HorizontalLayout {
                spacing: 20px;
                Figure {
                    horizontal-stretch: 1;
                    preferred-width: 10px;
                    label: @tr("CPU fan");
                    value: App.known(App.status.cpu-rpm, App.status.cpu-rpm);
                    unit: @tr("rpm");
                    note: App.known(App.status.gpu-rpm, @tr("GPU {}", @tr("{} rpm", App.status.gpu-rpm)));
                }

                Figure {
                    horizontal-stretch: 1;
                    preferred-width: 10px;
                    label: @tr("CPU temperature");
                    value: App.known(App.status.temp, App.status.temp);
                    unit: "°C";
                    note: App.status.temp-limit > 0 ? @tr("limit {}", App.celsius(App.status.temp-limit)) : " ";
                }
            }

            VerticalLayout {
                spacing: 10px;
                Curve {
                    height: 140px;
                    line: App.status.fan-line;
                    area: App.status.fan-area;
                }

                HorizontalLayout {
                    spacing: 18px;
                    LegendKey {
                        text: @tr("CPU fan");
                        ink: Theme.accent;
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: App.celsius(20) + " – " + App.celsius(110);
                        vertical-alignment: center;
                        color: Theme.dim;
                        font-size: 13px;
                        horizontal-alignment: right;
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
            }
        }
    }
}
