// The game library, Canapé's landing page: the selected game large, then
// shelves of covers: recent, installed, the user's categories, one per
// store, to install. The
// shelf in front is full; the next one peeks in below. Left and right move
// along the shelf (the gamepad sends arrow keys while it has the focus, see
// nav.rs), up and down change shelf, A plays or installs. The games, their
// covers and the launches come from library.rs, the shelves from
// shelves.rs.

import { Theme } from "theme.slint";
import { App } from "state.slint";
import { PadGlyph, StoreLogo } from "widgets.slint";
import { RevealLine, SectionTitle, SettingLine } from "kit.slint";

export struct GameView {
    id: string,
    title: string,
    // Store name: "Steam", "Epic", "GOG" or "Xbox" (brands: not translated),
    // or "Other" for a game of games.json (see Library.store-name).
    source: string,
    // Empty until decoded, and again once scrolled far away.
    cover: image,
    // The game has cover art on disk, loaded or not yet.
    art: bool,
    // 0 unknown, 1 today, 2 yesterday, 3 within 7 days, 4 within 30 days,
    // 5 longer ago.
    played: int,
    // False for an owned game that A installs.
    installed: bool,
    // Install progress, 0 to 1; -1 when not installing.
    progress: float,
}

export struct ShelfView {
    // 0 recent, 1 installed, 2 a store's, 3 to install, 4 a category's.
    kind: int,
    // The store of a store's shelf (see GameView.source), the name of a
    // category's, "" otherwise.
    store: string,
    games: [GameView],
    // Selected game and first game in view while the shelf is not in front.
    selected: int,
    first: int,
}

// The game page: what the shelf does not show, for the selected game.
export struct DetailView {
    // The cover, larger than on the shelf.
    cover: image,
    // Bytes on disk in tenths of a gigabyte, -1 when unknown. For a game
    // to install, what it will take once installed.
    size-tenths: int,
    // A game to install from Epic or GOG: the free space of the games
    // folder, in tenths of a gigabyte; -1 otherwise or when unknown.
    free-tenths: int,
    // The games folder.
    folder: string,
    // Minutes played, -1 when unknown.
    minutes: int,
    // Minutes to finish the game (IGDB), -1 when unknown: rushing through
    // the main story, the main story, and everything.
    beat-rushed: int,
    beat-minutes: int,
    beat-complete: int,
    // The game's executable, once seen after a launch from Canapé; its
    // profile, if any, shows on the page. "" when not known yet.
    exe: string,
}

// An achievement on the game page.
export struct AchievementView {
    name: string,
    // "" for a hidden one still locked.
    description: string,
    hidden: bool,
    // The greyed icon while locked; empty until decoded.
    icon: image,
    unlocked: bool,
    // Unlock date, YYYY-MM-DD; "" when locked or unknown.
    date: string,
    // Share of the game's players who have it, in tenths of a percent;
    // -1 when unknown.
    rarity-tenths: int,
}

// The game page's options menu (Y), for the game whose page is open.
export struct OptionsView {
    // The lines that apply, top to bottom: 0 rename, 1 back to the
    // store's title, 2 categories, 3 remove from the library, 4 uninstall.
    entries: [int],
    // The store's title, and the user's ("" when not renamed).
    original: string,
    custom: string,
    // The game's categories, " · " between them.
    categories: string,
    // A game of games.json: removing it takes it out of the file.
    listed: bool,
    // How it is uninstalled: 0 it is not, 1 Steam, 2 Legendary, 3 the Epic
    // launcher while Legendary is not set up, 4 its gogdl folder deleted,
    // 5 its own uninstaller (GOG), 6 Windows' settings (Xbox app).
    uninstall: int,
    // The folder deleted (4) or uninstalled (5), "" otherwise.
    folder: string,
}

// A category in the options menu: the game is in it or not.
export struct CategoryView {
    name: string,
    checked: bool,
}

// A hidden game, on its sub-page.
export struct HiddenGameView {
    title: string,
    // As GameView.source.
    source: string,
}

// A line of the "Add a game" sub-page.
export struct AddGameView {
    // The game's title (a shortcut's name).
    name: string,
    // The program's file name.
    file: string,
    // In games.json: A takes it out; otherwise A adds it.
    added: bool,
}

export global Library {
    // Top to bottom.
    in property <[ShelfView]> shelves;
    // The shelf in front, its selected game and its first game in view.
    in property <int> shelf;
    in-out property <int> selected;
    in-out property <int> first;
    // Every installed game.
    in property <int> total;
    in property <bool> scanning;
    // A cache or a finished scan has been loaded: an empty list means
    // there are no games.
    in property <bool> ready;
    // Id of the game being launched, "" when none.
    in property <string> launching;
    // Title of a game that could not be launched, "" when none.
    in property <string> failed;
    // A glow in the selected game's colour, stretched over the window: two
    // layers, the new colour goes into the hidden one, which then fades in
    // over the other.
    in property <image> backdrop-a;
    in property <image> backdrop-b;
    in property <bool> backdrop-b-front;
    // Where the layers start, in physical pixels: left of it the glow is
    // gone and the window's background shows.
    in property <int> backdrop-x;
    // A Steam Web API key is set in shell.json.
    in property <bool> steam-key;
    // IGDB keys (igdb_client_id and igdb_client_secret) are set in
    // shell.json: game pages show the time to beat.
    in property <bool> igdb-keys;
    // Signed-in Epic account (through Legendary), "" when none.
    in property <string> epic-account;
    // Legendary is being downloaded or its sign-in window is open.
    in property <bool> epic-busy;
    // Signed-in GOG account (through gogdl), "" when none.
    in property <string> gog-account;
    // gogdl is being downloaded, or the sign-in code is being checked.
    in property <bool> gog-busy;
    // GOG's sign-in page is open in the browser: the clipboard is watched
    // for the address it lands on.
    in property <bool> gog-waiting;
    // Epic's sign-in page is open: the clipboard is read for its code.
    in property <bool> epic-waiting;
    // The owned lists are being fetched.
    in property <bool> owned-loading;
    // Last install, store, sign-in or launch failure: what failed (0 none,
    // 1 downloading a helper program, 2 a sign-in, 3 an install, 4 a
    // launch, 5 a store's owned list, 6 the anti-cheat setup refused, 7 it
    // failed, 8 anything else), what it concerns (a store, a program or a
    // game) and a short technical detail ("" when none or too long; the
    // full one is in shell.log).
    in property <int> error-kind;
    in property <string> error-subject;
    in property <string> error-detail;
    // That failure as shown, "" when none.
    out property <string> install-error: root.error-message(root.error-kind, root.error-subject, root.error-detail);
    // Games listed in games.json.
    in property <int> external;
    // The "Add a game" sub-page: games.json and the shortcuts that could
    // be games, while they are being looked for, and why games.json could
    // not be read or written ("" when it could).
    in property <[AddGameView]> add-games;
    in property <bool> add-games-loading;
    in property <string> add-games-error;
    callback open-add-games();
    // A on this line: add the game, or take it out of games.json.
    callback toggle-add-game(int);
    // Where Legendary and gogdl install games, and its free space in
    // tenths of a gigabyte (-1 when unknown).
    in property <string> games-folder;
    in property <int> games-free-tenths: -1;
    // Settings: the previous (-1) or next (1) games folder.
    callback games-folder-step(int);

    // Bring this shelf to the front.
    callback focus-shelf(int);
    // The game page of the selected game is open, and what it shows.
    in-out property <bool> detail;
    in property <DetailView> detail-view;
    // The part of the game page in view: 0 the top, 1 below the fold.
    in-out property <int> detail-part;
    // The game page has a part below the fold.
    out property <bool> detail-more: root.detail-view.beat-rushed > 0 || root.detail-view.beat-minutes > 0 || root.detail-view.beat-complete > 0 || root.achievements.length > 0;
    // The game's achievements (Steam), unlocked first, the latest first,
    // then locked; how many are unlocked; the focused one.
    in property <[AchievementView]> achievements;
    in property <int> achievements-unlocked;
    in-out property <int> achievement-focus;
    // The tiles from this index, this many, are in view, with icons of this
    // side in physical pixels.
    callback achievements-view(int, int, float);
    // Wide art behind the game page (Steam's), drawn at the window's width
    // and faded into the background; empty when there is none.
    in property <image> detail-art;
    callback open-detail(int);
    callback close-detail();

    // The game page's options menu is open, and what it offers.
    in-out property <bool> options;
    in property <OptionsView> options-view;
    // Where the menu is: 0 its lines, 1 the rename field, 2 the
    // categories, 3 the new category field, 4 the uninstall's
    // confirmation, 5 the removal's; the line focused.
    in-out property <int> options-mode;
    in-out property <int> options-row;
    // Every category, and whether the game is in it.
    in property <[CategoryView]> categories;
    callback open-options();
    callback close-options();
    callback rename(string);
    callback reset-name();
    callback toggle-category(int);
    callback new-category(string);
    // Hides the game, or takes a game of games.json out of the file.
    callback remove-game();
    callback uninstall-game();
    // A text field gained (true) or lost the focus: the touch keyboard
    // follows.
    callback text-entry(bool);
    // Id of the game being uninstalled ("" when none), and how (see
    // OptionsView.uninstall).
    in property <string> uninstalling;
    in property <int> uninstalling-kind;
    // Why the last change failed: 0 it did not, 1 overrides.json could not
    // be written, 2 games.json could not be read or written, 3 the game
    // `uninstall-failed` could not be uninstalled.
    in property <int> change-error;
    in property <string> uninstall-failed;
    out property <string> change-text: root.change-error == 1 ? @tr("Could not save the change") : root.change-error == 2 ? @tr("games.json could not be read or written") : root.change-error == 3 ? @tr("Could not uninstall {}", root.uninstall-failed) : "";
    // The hidden games, by title; A on one shows it again.
    in property <[HiddenGameView]> hidden-games;
    callback show-game(int);
    callback epic-login();
    callback gog-login();
    callback launch(int);
    // The game at this index of the shelf in front was selected, with the
    // first game in view.
    callback select(int, int);
    // A shelf shows this many covers across, of this size in physical
    // pixels.
    callback view(int, float, float);
    // The shelf gained (true) or lost the focus.
    callback focus-changed(bool);
    // The library page was shown (true) or left.
    callback shown(bool);

    // A store's name as shown; "Other" is the games of games.json.
    public pure function store-name(store: string) -> string {
        store == "Other" ? @tr("Other games") : store
    }

    // See error-kind.
    pure function error-message(kind: int, subject: string, detail: string) -> string {
        if kind == 0 {
            return "";
        }
        if kind == 8 {
            return detail == "" ? subject : subject + ": " + detail;
        }
        root.with-detail(kind == 1 ? @tr("Could not download {}", subject) : kind == 2 ? @tr("{}: sign-in failed", subject) : kind == 3 ? @tr("Could not install {}", subject) : kind == 4 ? @tr("Could not launch {}", subject) : kind == 5 ? @tr("{}: could not list the owned games", subject) : kind == 6 ? @tr("Easy Anti-Cheat was not installed (refused): {} may not start", subject) : @tr("Easy Anti-Cheat could not be installed: {} may not start", subject), detail)
    }

    pure function with-detail(message: string, detail: string) -> string {
        detail == "" ? message : message + " (" + detail + ")"
    }

    public pure function played-text(played: int) -> string {
        if played == 1 {
            return @tr("Played today");
        }
        if played == 2 {
            return @tr("Played yesterday");
        }
        if played == 3 {
            return @tr("Played in the last 7 days");
        }
        if played == 4 {
            return @tr("Played in the last 30 days");
        }
        if played == 5 {
            return @tr("Played more than a month ago");
        }
        ""
    }
}

// A cover on the shelf; the selected one is larger, fully opaque and
// ringed.
component Cover inherits Rectangle {
    in property <GameView> game;
    in property <bool> selected;
    in property <bool> focused;
    in property <bool> launching;
    callback clicked();
    width: root.selected ? 128px : 116px;
    height: root.selected ? 192px : 174px;
    animate width, height { duration: 160ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }

    if root.selected && root.focused: Rectangle {
        x: -6px;
        y: -6px;
        width: parent.width + 12px;
        height: parent.height + 12px;
        border-radius: 16px;
        border-width: 3px;
        border-color: Theme.focus;
        drop-shadow-blur: 30px;
        drop-shadow-color: #0000008c;
        drop-shadow-offset-y: 18px;
    }

    card := Rectangle {
        border-radius: 10px;
        clip: true;
        // Under loaded art, nothing: a fill would show at the rounded corners.
        background: !root.game.art ? Theme.accent.mix(Theme.surface, 0.3) : root.game.cover.width > 0 ? transparent : Theme.surface-high;

        // Fades in once decoded.
        if root.game.art: Image {
            width: 100%;
            height: 100%;
            source: root.game.cover;
            image-fit: fill;
            opacity: root.game.cover.width > 0 ? 1 : 0;
            animate opacity { duration: 200ms; }
        }

        // No art: the title at the bottom of a tinted card.
        if !root.game.art: Text {
            x: 12px;
            y: parent.height - self.height - 12px;
            width: parent.width - 24px;
            text: root.game.title;
            color: Theme.text;
            font-size: 15px;
            font-weight: 700;
            wrap: word-wrap;
            max-height: parent.height - 24px;
            overflow: elide;
        }

        // Install in progress: a bar along the bottom.
        if root.game.progress >= 0: Rectangle {
            x: 10px;
            y: parent.height - 16px;
            width: parent.width - 20px;
            height: 6px;
            border-radius: 3px;
            background: #000000a0;
            clip: true;
            // A share, or a segment going across while it is not known.
            Rectangle {
                x: root.game.progress > 1 ? parent.width * (Math.mod(animation-tick() / 1ms, 1600) / 1600 * 1.4 - 0.4) : 0;
                width: root.game.progress > 1 ? parent.width * 0.4 : parent.width * root.game.progress;
                border-radius: 3px;
                background: Theme.accent;
            }
        }

        if root.launching: Rectangle {
            background: #0b0c0fb0;
        }
    }

    // Dims the covers not selected: a veil costs far less than an opacity,
    // which the software renderer draws through a layer.
    Rectangle {
        border-radius: 10px;
        background: Theme.background.with-alpha(root.selected ? 0 : 0.38);
        animate background { duration: 160ms; }
    }

    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// The main action: white, with the A button. A quiet one is another
// choice, which left or right selects.
component PrimaryButton inherits Rectangle {
    in property <string> label;
    // Briefly darker after a press of A.
    in property <bool> pressed;
    in property <bool> quiet;
    callback clicked();
    height: 48px;
    width: text.preferred-width + (root.quiet ? 44px : 60px);
    border-radius: 10px;
    background: root.quiet ? Theme.surface-high.with-alpha(0.7) : root.pressed || ta.pressed ? Theme.focus.darker(0.3) : Theme.focus;
    animate background { duration: 90ms; }

    HorizontalLayout {
        padding-left: root.quiet ? 22px : 14px;
        padding-right: 22px;
        spacing: 10px;
        if !root.quiet: VerticalLayout {
            alignment: center;
            PadGlyph {
                text: "A";
                ink: Theme.background;
            }
        }

        text := Text {
            text: root.label;
            color: root.quiet ? Theme.text : Theme.background;
            font-size: 16px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// A shelf's name, with its store's logo and its size.
component ShelfTitle inherits HorizontalLayout {
    in property <ShelfView> shelf;
    in property <bool> front;
    spacing: 8px;
    alignment: start;
    if root.shelf.kind == 2: VerticalLayout {
        alignment: center;
        StoreLogo {
            width: 16px;
            height: 16px;
            store: root.shelf.store;
            ink: label.color;
        }
    }
    label := Text {
        text: root.shelf.kind == 0 ? @tr("Recent") : root.shelf.kind == 1 ? @tr("Installed · {}", root.shelf.games.length) : root.shelf.kind == 2 ? Library.store-name(root.shelf.store) + " · " + root.shelf.games.length : root.shelf.kind == 4 ? root.shelf.store + " · " + root.shelf.games.length : @tr("To install · {}", root.shelf.games.length);
        color: root.front ? Theme.text.mix(Theme.dim, 0.6) : Theme.dim;
        font-size: 14px;
        font-weight: 600;
        vertical-alignment: center;
    }
}

// An achievement on the game page: its icon (greyed while locked) and its
// name; the focused one is ringed.
component AchievementTile inherits Rectangle {
    in property <AchievementView> item;
    in property <bool> focused;
    in property <length> icon-size;
    callback clicked();
    border-radius: 10px;
    background: Theme.surface;

    if root.focused: Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: 13px;
        border-width: 2px;
        border-color: Theme.focus;
    }

    // Under a decoded icon, nothing: a fill would show at its rounded
    // corners.
    Rectangle {
        x: 10px;
        y: (parent.height - self.height) / 2;
        width: root.icon-size;
        height: root.icon-size;
        border-radius: 8px;
        background: root.item.icon.width > 0 ? transparent : Theme.surface-high;
        Image {
            width: 100%;
            height: 100%;
            source: root.item.icon;
            image-fit: fill;
        }
    }

    Text {
        x: 10px + root.icon-size + 12px;
        width: parent.width - self.x - 10px;
        height: 100%;
        text: root.item.name;
        color: root.item.unlocked ? Theme.text : Theme.dim;
        font-size: 15px;
        font-weight: root.item.unlocked ? 600 : 400;
        wrap: word-wrap;
        vertical-alignment: center;
        overflow: elide;
    }

    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// The game page, over the shelves: the cover large, what is known about the
// game, and the button that plays or installs it. Its lines slide in like
// the title on the shelf. Below the fold, which Down scrolls to, how long
// the game takes and its achievements.
component GamePage inherits Rectangle {
    in property <GameView> game;
    in property <DetailView> view;
    in property <bool> pressed;
    // The part below the fold is in view.
    in property <bool> lower;
    callback play();
    // Asks for the part below the fold (true) or the top.
    callback scroll-to(bool);
    // The game does not fit in the games folder.
    property <bool> short: !root.game.installed && root.view.free-tenths >= 0 && root.view.size-tenths > root.view.free-tenths;
    property <bool> beat-known: root.view.beat-rushed > 0 || root.view.beat-minutes > 0 || root.view.beat-complete > 0;
    // The page has a part below the fold: its first lines peek in at the
    // bottom, and the top part sits higher to leave them room.
    property <bool> has-lower: root.beat-known || root.count > 0;
    property <length> peek: 184px;
    property <length> top: root.has-lower ? 20px : 96px;
    // Where the part below the fold starts.
    property <length> fold: root.has-lower ? root.height - root.peek : root.height;
    // The fade at the top of the part below the fold.
    property <length> fade: 36px;
    // Achievements: tiles across, from LibraryPage, which moves the focus.
    in property <int> columns: 1;
    property <int> count: Library.achievements.length;
    property <int> focus-index: Library.achievement-focus;
    property <length> gap: 12px;
    property <length> tile-height: 72px;
    property <length> icon-size: 52px;
    property <length> pitch: root.tile-height + root.gap;
    property <length> achievements-y: root.fade + (root.beat-known ? 148px + 32px : 0);
    property <length> grid-y: root.achievements-y + 52px;
    // Rows that fit above the hints, leaving room for the focused tile's
    // line; and the first one in view, which only moves at an edge.
    property <int> grid-rows: max(1, Math.floor((root.height - 82px - 40px - root.grid-y + root.gap) / root.pitch));
    property <int> total-rows: Math.ceil(root.count / root.columns);
    property <int> first-row: 0;
    property <AchievementView> focused: Library.achievements[root.focus-index];

    function report() {
        Library.achievements-view(root.first-row * root.columns, (root.grid-rows + 1) * root.columns, root.icon-size / 1phx);
    }
    function follow() {
        let row = Math.floor(root.focus-index / root.columns);
        if row < root.first-row {
            root.first-row = row;
        } else if row >= root.first-row + root.grid-rows {
            root.first-row = row - root.grid-rows + 1;
        }
        root.report();
    }
    init => {
        root.report();
    }
    changed focus-index => {
        root.follow();
    }
    changed columns => {
        root.follow();
    }
    changed grid-rows => {
        root.follow();
    }

    // A wheel or a swipe scrolls too.
    TouchArea {
        scroll-event(event) => {
            if event.delta-y < 0 {
                root.scroll-to(true);
                return accept;
            }
            if event.delta-y > 0 {
                root.scroll-to(false);
                return accept;
            }
            reject
        }
    }

    // Clips the scrolled page under the header; wider than the page, so
    // that the cover's shadow still shows at its left.
    // Above the hints while the top is in view: what peeks in stops there.
    Rectangle {
        x: -48px;
        width: root.width + 96px;
        height: root.lower ? root.height : root.height - 96px;
        clip: true;

        Rectangle {
            x: 48px;
            y: root.lower ? -root.fold : 0;
            width: root.width;
            height: root.fold + root.height;
            animate y { duration: Theme.motion(260ms); easing: cubic-bezier(0.2, 0.8, 0.2, 1); }

            cover := Rectangle {
                x: 0;
                y: root.top;
                width: 240px;
                height: 360px;
                border-radius: 12px;
                clip: true;
                background: root.game.art ? Theme.surface-high : Theme.accent.mix(Theme.surface, 0.3);
                drop-shadow-blur: 40px;
                drop-shadow-color: #00000099;
                drop-shadow-offset-y: 20px;
                // Launching: the cover comes forward a little.
                property <length> lift: Library.launching == root.game.id ? 8px : 0;
                animate lift { duration: 500ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }

                Image {
                    y: -cover.lift;
                    width: 100%;
                    height: 100%;
                    source: root.view.cover.width > 0 ? root.view.cover : root.game.cover;
                    image-fit: fill;
                }

                if !root.game.art: Text {
                    x: 16px;
                    y: parent.height - self.height - 16px;
                    width: parent.width - 32px;
                    text: root.game.title;
                    color: Theme.text;
                    font-size: 20px;
                    font-weight: 700;
                    wrap: word-wrap;
                }
            }

            VerticalLayout {
                x: 280px - 14px;
                y: root.top;
                width: parent.width - 280px;
                height: 360px;
                spacing: 14px;
                alignment: end;

                store := RevealLine {
                    order: 0;
                    spacing: 8px;
                    alignment: start;
                    height: 16px;
                    VerticalLayout {
                        alignment: center;
                        StoreLogo {
                            width: 15px;
                            height: 15px;
                            store: root.game.source;
                            ink: Theme.dim;
                            opacity: store.shown;
                        }
                    }
                    Text {
                        text: Library.store-name(root.game.source).to-uppercase();
                        color: Theme.dim;
                        font-size: 13px;
                        font-weight: 600;
                        letter-spacing: 1px;
                        vertical-alignment: center;
                        opacity: store.shown;
                    }
                }

                title := RevealLine {
                    order: 1;
                    Text {
                        text: root.game.title;
                        color: Theme.text;
                        font-size: 52px;
                        font-weight: 700;
                        letter-spacing: -1px;
                        wrap: word-wrap;
                        max-height: 130px;
                        overflow: elide;
                        opacity: title.shown;
                    }
                }

                // When it was played, for how long, and its size: only what
                // is known.
                facts := RevealLine {
                    order: 2;
                    Text {
                        // Each known fact, " · " between them only.
                        property <string> played: root.game.installed ? Library.played-text(root.game.played) : @tr("Not installed");
                        property <string> time: root.view.minutes >= 60 ? @tr("{} h played", Math.round(root.view.minutes / 60)) : root.view.minutes > 0 ? @tr("{} min played", root.view.minutes) : "";
                        property <string> size: root.view.size-tenths >= 0 ? @tr("{} GB", App.tenths(root.view.size-tenths)) : "";
                        property <string> free: !root.game.installed && root.view.free-tenths >= 0 ? @tr("{} GB free in {}", App.tenths(root.view.free-tenths), root.view.folder) : "";
                        property <string> one: self.played + (self.played != "" && self.time != "" ? " · " : "") + self.time;
                        property <string> two: self.one + (self.one != "" && self.size != "" ? " · " : "") + self.size;
                        text: self.two + (self.two != "" && self.free != "" ? " · " : "") + self.free;
                        color: Theme.text.mix(Theme.dim, 0.6);
                        font-size: 16px;
                        overflow: elide;
                        opacity: facts.shown;
                    }
                }

                action := RevealLine {
                    order: 3;
                    padding-top: 10px;
                    spacing: 16px;
                    alignment: start;
                    PrimaryButton {
                        opacity: action.shown;
                        pressed: root.pressed;
                        label: Library.launching == root.game.id ? @tr("Launching…") : Library.uninstalling == root.game.id ? @tr("Uninstalling…") : root.game.progress >= 0 ? @tr("Installing…") : root.game.installed ? @tr("Play") : @tr("Install");
                        clicked => {
                            root.play();
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            opacity: action.shown;
                            // The uninstall running, and where the user confirms it.
                            property <string> uninstall: Library.uninstalling != root.game.id ? "" : Library.uninstalling-kind == 1 ? @tr("Confirm in Steam's window") : Library.uninstalling-kind == 5 ? @tr("Follow the game's uninstaller") : Library.uninstalling-kind == 6 ? @tr("Uninstall it in Windows' settings") : "";
                            text: Library.change-text != "" ? Library.change-text : self.uninstall != "" ? self.uninstall : Library.install-error != "" ? Library.install-error : Library.failed != "" ? @tr("Could not launch {}", Library.failed) : root.short && root.game.progress < 0 ? @tr("Not enough space: free some up, or pick another games folder in Settings.") : root.game.progress == 0 ? @tr("Waiting for the store…") : root.game.progress > 1 ? @tr("Downloading…") : root.game.progress > 0 ? @tr("Installing… {} %", Math.round(root.game.progress * 100)) : "";
                            color: Library.change-text != "" || Library.install-error != "" || Library.failed != "" || (root.short && root.game.progress < 0) ? Theme.warn : Theme.text.mix(Theme.dim, 0.6);
                            font-size: 14px;
                            overflow: elide;
                        }
                    }
                }
            }

            // The game's profile, under the cover's column, once its
            // executable is known and has one: every profile is laid at the
            // same place, only the matching one shows.
            for profile in App.profiles: Rectangle {
                x: 280px;
                y: root.top + 360px + 20px;
                width: min(420px, root.width - self.x);
                height: 88px;
                border-radius: 12px;
                background: Theme.surface.with-alpha(0.85);
                visible: root.view.exe != "" && profile.exe.to-lowercase() == root.view.exe.to-lowercase();

                VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 12px;
                    alignment: start;
                    spacing: 6px;
                    Text {
                        text: @tr("This game's profile");
                        color: Theme.dim;
                        font-size: 13px;
                    }

                    Text {
                        text: (profile.auto-tdp ? App.fps-value(profile.target-fps) + " · " + App.watts(profile.min-watts) + "–" + App.watts(profile.max-watts) : @tr("Auto TDP off")) + (profile.learned-watts >= 0 ? " · " + @tr("{} learned", App.watts(profile.learned-watts)) : "") + (profile.fps-limit > 0 ? " · " + @tr("limit {}", App.fps-value(profile.fps-limit)) : "");
                        color: Theme.text;
                        font-size: 16px;
                        font-weight: 600;
                        overflow: elide;
                    }
                }
            }

            // Install progress under the button.
            if root.game.progress >= 0: Rectangle {
                x: 280px;
                y: root.top + 360px + 24px;
                width: 360px;
                height: 4px;
                border-radius: 2px;
                background: Theme.surface-focus;
                clip: true;
                // A share, or a segment going across while it is not known.
                Rectangle {
                    x: root.game.progress > 1 ? parent.width * (Math.mod(animation-tick() / 1ms, 1600) / 1600 * 1.4 - 0.4) : 0;
                    width: root.game.progress > 1 ? parent.width * 0.4 : parent.width * root.game.progress;
                    border-radius: 2px;
                    background: Theme.accent;
                    animate width { duration: 400ms; }
                }
            }

            // Below the fold, on an opaque background (cheaper to draw while
            // it scrolls in) under a short fade: the time to beat, then the
            // achievements.
            if root.beat-known || root.count > 0: Rectangle {
                x: -48px;
                y: root.fold;
                width: root.width + 96px;
                height: root.height;

                Rectangle {
                    y: 0;
                    height: root.fade;
                    background: @linear-gradient(180deg, Theme.background.with-alpha(0) 0%, Theme.background 100%);
                }

                Rectangle {
                    y: root.fade;
                    height: parent.height - root.fade;
                    background: Theme.background;
                }

                // Main story, main + extras, completionist: a coloured
                // strip each, the time large under it.
                if root.beat-known: Rectangle {
                    x: 48px;
                    y: root.fade;
                    width: root.width;
                    height: 36px + 112px;

                    Text {
                        x: 0;
                        y: 0;
                        height: 24px;
                        text: @tr("Time to beat");
                        color: Theme.text;
                        font-size: 18px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    Text {
                        x: parent.width - self.width;
                        y: 0;
                        height: 24px;
                        vertical-alignment: center;
                        text: "IGDB";
                        color: Theme.faint;
                        font-size: 12px;
                    }

                    for time[i] in [root.view.beat-rushed, root.view.beat-minutes, root.view.beat-complete]: Rectangle {
                        property <length> pitch: (parent.width + 16px) / 3;
                        x: i * self.pitch;
                        y: 36px;
                        width: self.pitch - 16px;
                        height: 112px;
                        border-radius: 12px;
                        clip: true;
                        background: Theme.surface;

                        Rectangle {
                            y: 0;
                            height: 36px;
                            background: i == 0 ? #2c5d9e : i == 1 ? #6a3f9e : #9e3f5c;
                            Text {
                                x: 16px;
                                width: parent.width - 32px;
                                text: i == 0 ? @tr("Main story") : i == 1 ? @tr("Main + extras") : @tr("Completionist");
                                color: #ffffff;
                                font-size: 15px;
                                font-weight: 600;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        Text {
                            x: 16px;
                            y: 36px;
                            width: parent.width - 32px;
                            height: parent.height - 36px;
                            text: time >= 60 ? @tr("~{} h", Math.round(time / 60)) : time > 0 ? @tr("~{} min", time) : "—";
                            color: time > 0 ? Theme.text : Theme.dim;
                            font-size: 36px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }

                // Achievements: how many are unlocked, then a grid of
                // tiles that scrolls by rows at its edges, then the focused
                // one's description, date and rarity.
                if root.count > 0: Rectangle {
                    x: 48px;
                    y: root.achievements-y;
                    width: root.width;
                    height: parent.height - self.y;

                    HorizontalLayout {
                        y: 0;
                        height: 24px;
                        spacing: 16px;
                        alignment: start;
                        Text {
                            text: @tr("Achievements");
                            color: Theme.text;
                            font-size: 18px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        Text {
                            text: Library.achievements-unlocked + " / " + root.count + " · " + Math.round(Library.achievements-unlocked * 100 / root.count) + " %";
                            color: Theme.text.mix(Theme.dim, 0.6);
                            font-size: 15px;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        y: 34px;
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.surface-focus;
                        Rectangle {
                            x: 0;
                            width: parent.width * Library.achievements-unlocked / root.count;
                            border-radius: 2px;
                            background: Theme.accent;
                        }
                    }

                    // Wider than the tiles by the focus ring.
                    Rectangle {
                        x: -4px;
                        y: root.grid-y - root.achievements-y - 4px;
                        width: parent.width + 8px;
                        height: min(root.grid-rows, root.total-rows) * root.pitch - root.gap + 8px;
                        clip: true;

                        Rectangle {
                            x: 4px;
                            y: 4px - root.first-row * root.pitch;
                            width: root.width;
                            height: root.total-rows * root.pitch;
                            animate y { duration: Theme.motion(200ms); easing: cubic-bezier(0.2, 0.8, 0.2, 1); }

                            for item[i] in Library.achievements: AchievementTile {
                                property <int> tile-row: Math.floor(i / root.columns);
                                x: Math.mod(i, root.columns) * (self.width + root.gap);
                                y: self.tile-row * root.pitch;
                                width: (root.width - (root.columns - 1) * root.gap) / root.columns;
                                height: root.tile-height;
                                icon-size: root.icon-size;
                                item: item;
                                focused: root.lower && i == root.focus-index;
                                // Only the rows in view and next to them.
                                visible: self.tile-row >= root.first-row - 1 && self.tile-row <= root.first-row + root.grid-rows;
                                clicked => {
                                    Library.achievement-focus = i;
                                    root.scroll-to(true);
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        y: root.grid-y - root.achievements-y + min(root.grid-rows, root.total-rows) * root.pitch - root.gap + 14px;
                        height: 22px;
                        spacing: 12px;
                        alignment: start;
                        Text {
                            text: root.focused.name;
                            color: Theme.text;
                            font-size: 15px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: (root.focused.description != "" ? root.focused.description + " · " : root.focused.hidden ? @tr("Hidden achievement") + " · " : "")
                                + (!root.focused.unlocked ? @tr("Locked") : root.focused.date != "" ? @tr("Unlocked on {}", root.focused.date) : @tr("Unlocked"))
                                + (root.focused.rarity-tenths >= 0 ? " · " + @tr("{} % of players", App.tenths(root.focused.rarity-tenths)) : "");
                            color: Theme.text.mix(Theme.dim, 0.6);
                            font-size: 15px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
}

// A line of text typed with the touch keyboard (or a keyboard): A or Enter
// confirms, B or Escape cancels. Takes the focus when shown.
component TextField inherits Rectangle {
    in property <string> initial;
    callback submit(string);
    callback cancel();
    height: 54px;
    border-radius: 10px;
    background: Theme.surface-high;
    border-width: 2px;
    border-color: input.has-focus ? Theme.focus : Theme.stroke;

    scope := FocusScope {
        // Only the keys the text did not take.
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancel();
                return accept;
            }
            reject
        }

        input := TextInput {
            x: 16px;
            width: parent.width - 32px;
            height: 100%;
            text: root.initial;
            single-line: true;
            color: Theme.text;
            selection-background-color: Theme.accent.with-alpha(0.5);
            selection-foreground-color: Theme.text;
            font-size: 18px;
            vertical-alignment: center;
            changed has-focus => {
                Library.text-entry(self.has-focus);
            }
            accepted => {
                root.submit(self.text);
            }
        }
    }

    init => {
        input.focus();
        input.select-all();
    }
}

// The game page's options, a panel over its right side: rename the game,
// put it in categories, take it off the library, uninstall it. The lines
// are Library.options-view.entries; Library.options-mode is the step.
component OptionsPanel inherits Rectangle {
    in property <GameView> game;
    // The lines have the focus (not a text field).
    in property <bool> active;
    callback pick(int);
    callback submit(string);
    callback cancel();
    property <OptionsView> view: Library.options-view;
    property <int> mode: Library.options-mode;
    property <int> line: Library.options-row;
    border-radius: Theme.radius;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.stroke;
    drop-shadow-blur: 40px;
    drop-shadow-color: #000000aa;

    // Clicks and swipes stay on the panel.
    TouchArea { }

    VerticalLayout {
        padding: 20px;
        spacing: 4px;
        alignment: start;

        SectionTitle {
            text: root.mode == 1 ? @tr("Rename") : root.mode == 2 || root.mode == 3 ? @tr("Categories") : root.mode == 4 ? @tr("Uninstall") : root.mode == 5 ? @tr("Remove from the library") : @tr("Options");
        }

        Text {
            text: root.game.title;
            color: Theme.text;
            font-size: 20px;
            font-weight: 700;
            overflow: elide;
        }

        Rectangle {
            height: 12px;
        }

        if root.mode == 0: VerticalLayout {
            spacing: 2px;
            for entry[i] in root.view.entries: SettingLine {
                label: entry == 0 ? @tr("Rename") : entry == 1 ? @tr("Use the store's title") : entry == 2 ? @tr("Categories") : entry == 3 ? @tr("Remove from the library") : @tr("Uninstall");
                value: entry == 1 ? root.view.original : entry == 2 ? (root.view.categories != "" ? root.view.categories : @tr("None")) : entry == 4 && root.view.uninstall == 3 ? @tr("Sign in to Epic first") : "";
                enabled: !(entry == 4 && root.view.uninstall == 3);
                chevrons: false;
                focused: root.active && root.line == i;
                clicked => {
                    root.pick(i);
                }
            }
        }

        // What removing does, while that line is focused.
        if root.mode == 0 && root.view.entries[root.line] == 3: Text {
            text: root.view.listed ? @tr("Taken out of games.json.") : @tr("Hidden games come back from Settings › Add a game.");
            color: Theme.dim;
            font-size: 14px;
            wrap: word-wrap;
        }

        if root.mode == 1 || root.mode == 3: TextField {
            initial: root.mode == 1 ? root.game.title : "";
            submit(text) => {
                root.submit(text);
            }
            cancel => {
                root.cancel();
            }
        }

        if root.mode == 1 || root.mode == 3: Text {
            text: root.mode == 1 && root.view.custom != "" ? @tr("Store's title: {}", root.view.original) : root.mode == 3 ? @tr("The game goes in the new category.") : "";
            color: Theme.dim;
            font-size: 14px;
            wrap: word-wrap;
        }

        if root.mode == 2: VerticalLayout {
            spacing: 2px;
            SettingLine {
                label: @tr("New category");
                chevrons: false;
                focused: root.active && root.line == 0;
                clicked => {
                    root.pick(0);
                }
            }

            for category[i] in Library.categories: SettingLine {
                label: category.name;
                value: category.checked ? "✓" : "";
                chevrons: false;
                focused: root.active && root.line == i + 1;
                clicked => {
                    root.pick(i + 1);
                }
            }
        }

        if root.mode == 4 || root.mode == 5: VerticalLayout {
            spacing: 2px;
            Text {
                text: root.mode == 5 ? @tr("Taken out of games.json. Add a game can list it again if it has a shortcut.") : root.view.uninstall == 1 ? @tr("Steam asks for its own confirmation, then deletes the game's files.") : root.view.uninstall == 2 ? @tr("Legendary deletes the game's files.") : root.view.uninstall == 4 ? @tr("This folder is deleted: {}", root.view.folder) : root.view.uninstall == 5 ? @tr("The game's own uninstaller opens; Windows may ask for consent.") : @tr("Windows' settings open on the game: uninstall it there.");
                color: Theme.text.mix(Theme.dim, 0.6);
                font-size: 15px;
                wrap: word-wrap;
            }

            Rectangle {
                height: 10px;
            }

            SettingLine {
                label: root.mode == 5 ? @tr("Remove from the library") : @tr("Uninstall");
                chevrons: false;
                focused: root.active && root.line == 0;
                clicked => {
                    root.pick(0);
                }
            }

            SettingLine {
                label: @tr("Cancel");
                chevrons: false;
                focused: root.active && root.line == 1;
                clicked => {
                    root.pick(1);
                }
            }
        }
    }
}

export component LibraryPage inherits Rectangle {
    property <ShelfView> front: Library.shelves[Library.shelf];
    property <GameView> current: root.front.games[Library.selected];
    property <bool> has-games: root.front.games.length > 0;
    property <bool> to-install: root.front.kind == 3;
    // Achievement tiles across the game page: at least 260px wide, 12px
    // apart.
    property <int> achievement-columns: max(1, Math.floor((root.width + 12px) / 272px));
    // Empty To install: the store to sign in to, 0 Epic, 1 GOG.
    in-out property <int> account-pick: 0;
    property <bool> signing-up: !root.has-games && root.to-install;
    property <int> sel: Library.selected;
    property <length> pitch: 132px;
    // From one shelf's title to the next.
    property <length> shelf-pitch: 240px;
    // Room left of the shelves for the focus ring.
    property <length> margin: 16px;
    // A was just pressed: the button shows it for a moment.
    property <bool> pressed;
    // Covers fully in view across a shelf.
    property <int> in-view: Math.floor((root.width + 48px) / root.pitch);
    changed sel => {
        // The shelf only scrolls when the selection reaches an edge, keeping
        // one game beside it: a step then redraws two covers, not the row.
        if self.sel < Library.first + 1 {
            Library.first = max(0, self.sel - 1);
        } else if self.sel > Library.first + root.in-view - 2 {
            Library.first = self.sel - root.in-view + 2;
        }
        Library.select(self.sel, Library.first);
    }

    function report() {
        // Decoded at the size of a cover not selected, so that only the
        // selected one is scaled when drawn.
        Library.view(Math.ceil(root.width / root.pitch) + 1, 116px / 1phx, 174px / 1phx);
    }
    // A on the shelf opens the game page; A on the page plays or installs.
    function act() {
        root.pressed = true;
        if Library.detail {
            // A game that does not fit is not installed: the page says why.
            let short = !root.current.installed && Library.detail-view.free-tenths >= 0 && Library.detail-view.size-tenths > Library.detail-view.free-tenths;
            if root.current.progress < 0 && !short && Library.uninstalling != root.current.id {
                Library.launch(Library.selected);
            }
        } else if root.has-games {
            Library.open-detail(Library.selected);
        } else if root.signing-up && root.account-pick == 0 && !Library.epic-busy {
            Library.epic-login();
        } else if root.signing-up && root.account-pick == 1 && !Library.gog-busy {
            Library.gog-login();
        }
    }
    // Lines of the options menu at its current step.
    property <int> option-lines: Library.options-mode == 0 ? Library.options-view.entries.length : Library.options-mode == 2 ? Library.categories.length + 1 : 2;
    function open-options() {
        Library.options-mode = 0;
        Library.options-row = 0;
        Library.open-options();
    }
    function close-options() {
        Library.close-options();
        fs.focus();
    }
    // Back one step: from a step to the menu's line it came from.
    function options-back() {
        let mode = Library.options-mode;
        if mode == 0 {
            root.close-options();
            return;
        }
        // The menu's lines are 0, 1 when renamed, 2, 3, then 4.
        let offset = Library.options-view.custom != "" ? 1 : 0;
        Library.options-row = mode == 1 || mode == 3 ? 0 : mode == 2 ? 1 + offset : mode == 5 ? 2 + offset : 3 + offset;
        Library.options-mode = mode == 3 ? 2 : 0;
        fs.focus();
    }
    function options-act() {
        let mode = Library.options-mode;
        let row = Library.options-row;
        if mode == 0 {
            let entry = Library.options-view.entries[row];
            if entry == 0 {
                Library.options-mode = 1;
            } else if entry == 1 {
                Library.reset-name();
                Library.options-row = 0;
            } else if entry == 2 {
                Library.options-mode = 2;
                Library.options-row = 0;
            } else if entry == 3 && Library.options-view.listed {
                Library.options-mode = 5;
                Library.options-row = 0;
            } else if entry == 3 {
                Library.remove-game();
                fs.focus();
            } else if entry == 4 && Library.options-view.uninstall != 3 {
                Library.options-mode = 4;
                Library.options-row = 0;
            }
        } else if mode == 2 {
            if row == 0 {
                Library.options-mode = 3;
            } else {
                Library.toggle-category(row - 1);
            }
        } else if mode == 4 || mode == 5 {
            if row == 1 {
                root.options-back();
            } else if mode == 4 {
                Library.uninstall-game();
                fs.focus();
            } else {
                Library.remove-game();
                fs.focus();
            }
        }
    }
    function go-shelf(index: int) {
        if index >= 0 && index < Library.shelves.length && index != Library.shelf {
            Library.focus-shelf(index);
        }
    }
    init => {
        self.report();
        Library.select(Library.selected, Library.first);
    }
    changed width => {
        self.report();
    }

    fs := FocusScope {
        init => {
            self.focus();
        }
        key-pressed(event) => {
            // The options menu over the game page: B goes back a step,
            // Y closes it.
            if Library.detail && Library.options {
                if event.text == Key.Escape {
                    root.options-back();
                }
                if event.text == Key.F3 || event.text == "y" {
                    root.close-options();
                }
                if event.text == Key.UpArrow {
                    Library.options-row = max(0, Library.options-row - 1);
                }
                if event.text == Key.DownArrow {
                    Library.options-row = max(0, min(root.option-lines - 1, Library.options-row + 1));
                }
                if event.text == Key.Return || event.text == " " {
                    root.options-act();
                }
                return accept;
            }
            if Library.detail {
                // Y: the game's options.
                if (event.text == Key.F3 || event.text == "y") && root.has-games {
                    root.open-options();
                    return accept;
                }
                // B goes back to the shelf, on the same game.
                if event.text == Key.Escape {
                    Library.close-detail();
                    return accept;
                }
                if Library.detail-part == 0 {
                    if event.text == Key.DownArrow && Library.detail-more {
                        Library.detail-part = 1;
                    }
                    if event.text == Key.Return || event.text == " " {
                        root.act();
                    }
                    return accept;
                }
                // Below the fold: the D-pad moves along the achievements;
                // up from their first row, or with none, goes back up.
                let count = Library.achievements.length;
                let focus = Library.achievement-focus;
                if event.text == Key.UpArrow {
                    if count == 0 || focus < root.achievement-columns {
                        Library.detail-part = 0;
                    } else {
                        Library.achievement-focus = focus - root.achievement-columns;
                    }
                }
                if event.text == Key.DownArrow && count > 0 {
                    if focus + root.achievement-columns < count {
                        Library.achievement-focus = focus + root.achievement-columns;
                    } else if Math.floor(focus / root.achievement-columns) < Math.floor((count - 1) / root.achievement-columns) {
                        Library.achievement-focus = count - 1;
                    }
                }
                if event.text == Key.LeftArrow {
                    Library.achievement-focus = max(0, focus - 1);
                }
                if event.text == Key.RightArrow {
                    Library.achievement-focus = max(0, min(count - 1, focus + 1));
                }
                return accept;
            }
            if event.text == Key.LeftArrow {
                if root.signing-up {
                    root.account-pick = 0;
                }
                Library.selected = max(0, Library.selected - 1);
                return accept;
            }
            if event.text == Key.RightArrow {
                if root.signing-up {
                    root.account-pick = 1;
                }
                Library.selected = max(0, min(root.front.games.length - 1, Library.selected + 1));
                return accept;
            }
            if event.text == Key.UpArrow {
                root.go-shelf(Library.shelf - 1);
                return accept;
            }
            if event.text == Key.DownArrow {
                root.go-shelf(Library.shelf + 1);
                return accept;
            }
            if event.text == Key.Return || event.text == " " {
                root.act();
                return accept;
            }
            return reject;
        }
        focus-gained(reason) => {
            Library.focus-changed(true);
        }
        focus-lost(reason) => {
            Library.focus-changed(false);
        }
    }

    Timer {
        interval: 140ms;
        running: root.pressed;
        triggered => {
            root.pressed = false;
        }
    }

    if Library.detail: GamePage {
        width: root.width;
        height: root.height;
        game: root.current;
        view: Library.detail-view;
        pressed: root.pressed;
        lower: Library.detail-part == 1;
        columns: root.achievement-columns;
        play => {
            root.act();
            fs.focus();
        }
        scroll-to(down) => {
            Library.detail-part = down && Library.detail-more ? 1 : 0;
            fs.focus();
        }
    }

    if Library.detail && Library.options: OptionsPanel {
        x: root.width - self.width;
        y: 0;
        width: 470px;
        height: root.height - 74px;
        game: root.current;
        active: fs.has-focus;
        pick(i) => {
            Library.options-row = i;
            root.options-act();
            if Library.options-mode != 1 && Library.options-mode != 3 {
                fs.focus();
            }
        }
        submit(text) => {
            Library.text-entry(false);
            if Library.options-mode == 1 {
                Library.rename(text);
                Library.options-mode = 0;
                Library.options-row = 0;
                fs.focus();
            } else {
                Library.new-category(text);
                Library.options-mode = 2;
                Library.options-row = 0;
                fs.focus();
            }
        }
        cancel => {
            Library.text-entry(false);
            root.options-back();
        }
    }

    // The selected game, or why there is none; a new model at each game,
    // so its title fades in.
    // The selected game, or why there is none; a new model at each game,
    // so its lines slide in again, one after the other. The block sits
    // 14px left of its place: each line moves that far to the right.
    for key in (Library.detail ? [] : [Library.shelf + ":" + (root.has-games ? root.current.id : "")]): VerticalLayout {
        x: -14px;
        y: 28px;
        width: 654px;
        height: 270px;
        spacing: 14px;
        alignment: start;

        store := RevealLine {
            order: 0;
            spacing: 8px;
            alignment: start;
            height: 16px;
            if root.has-games: VerticalLayout {
                alignment: center;
                StoreLogo {
                    width: 15px;
                    height: 15px;
                    store: root.current.source;
                    ink: Theme.dim;
                    opacity: store.shown;
                }
            }
            Text {
                text: root.has-games ? Library.store-name(root.current.source).to-uppercase() : root.to-install ? @tr("To install").to-uppercase() : "";
                color: Theme.dim;
                font-size: 13px;
                font-weight: 600;
                letter-spacing: 1px;
                vertical-alignment: center;
                opacity: store.shown;
            }
        }

        title := RevealLine {
            order: 1;
            Text {
                text: root.has-games ? root.current.title : !root.to-install ? (!Library.ready ? @tr("Looking for games…") : @tr("No games found")) : Library.owned-loading ? @tr("Looking for your games…") : Library.steam-key || Library.epic-account != "" || Library.gog-account != "" ? @tr("Every game you own is installed") : @tr("Install your games from here");
                color: Theme.text;
                font-size: 52px;
                font-weight: 700;
                letter-spacing: -1px;
                overflow: elide;
                opacity: title.shown;
            }
        }

        note := RevealLine {
            order: 2;
            Text {
                text: Library.change-text != "" ? Library.change-text : Library.install-error != "" ? Library.install-error : Library.failed != "" ? @tr("Could not launch {}", Library.failed) : root.signing-up && Library.epic-waiting ? @tr("Sign in to Epic in the browser, then copy the page it lands on (or its authorizationCode): Canapé reads it from the clipboard.") : root.signing-up && Library.gog-waiting ? @tr("Sign in to GOG in the browser, then copy the address of the page it lands on: Canapé reads it from the clipboard.") : root.signing-up ? @tr("Steam: add your Steam Web API key (steamcommunity.com/dev/apikey) as steam_api_key in shell.json. Epic and GOG: sign in once below; Canapé installs their games without their launchers.") : !root.has-games && Library.ready ? @tr("Canapé lists the games installed with Steam, the Epic Games Launcher, GOG Galaxy and the Xbox app.") : root.has-games && root.current.progress == 0 ? @tr("Waiting for the store…") : root.has-games && root.current.progress > 1 ? @tr("Downloading…") : root.has-games && root.current.progress > 0 ? @tr("Installing… {} %", Math.round(root.current.progress * 100)) : root.has-games && !root.current.installed ? @tr("Not installed") : root.has-games ? Library.played-text(root.current.played) : "";
                color: Library.change-text != "" || Library.install-error != "" || Library.failed != "" ? Theme.warn : Theme.text.mix(Theme.dim, 0.6);
                font-size: 16px;
                wrap: word-wrap;
                max-height: 66px;
                overflow: elide;
                opacity: note.shown;
            }
        }

        if root.has-games: button := RevealLine {
            order: 3;
            padding-top: 10px;
            alignment: start;
            PrimaryButton {
                opacity: button.shown;
                pressed: root.pressed;
                label: Library.launching == root.current.id ? @tr("Launching…") : root.current.progress >= 0 ? @tr("Installing…") : @tr("Details");
                clicked => {
                    root.act();
                    fs.focus();
                }
            }
        }

        // No game to install yet: sign in to Epic or GOG, left and right
        // pick one.
        if root.signing-up: accounts := RevealLine {
            order: 3;
            padding-top: 10px;
            spacing: 12px;
            alignment: start;
            PrimaryButton {
                opacity: accounts.shown;
                pressed: root.pressed && root.account-pick == 0;
                quiet: root.account-pick != 0;
                label: Library.epic-busy ? @tr("Opening the Epic sign-in…") : Library.epic-waiting ? @tr("Waiting for the Epic code…") : Library.epic-account != "" ? @tr("Epic: {} (sign in again)", Library.epic-account) : @tr("Sign in to Epic Games");
                clicked => {
                    root.account-pick = 0;
                    root.act();
                    fs.focus();
                }
            }
            PrimaryButton {
                opacity: accounts.shown;
                pressed: root.pressed && root.account-pick == 1;
                quiet: root.account-pick != 1;
                label: Library.gog-busy ? @tr("Opening the GOG sign-in…") : Library.gog-waiting ? @tr("Waiting for the GOG address…") : Library.gog-account != "" ? @tr("GOG: {} (sign in again)", Library.gog-account) : @tr("Sign in to GOG");
                clicked => {
                    root.account-pick = 1;
                    root.act();
                    fs.focus();
                }
            }
        }
    }

    // The shelves, the one in front at the top; the one above slides out
    // of view, the next one peeks in at the bottom.
    // Starts left of the covers: the focus ring reaches past the first one.
    Rectangle {
        visible: !Library.detail;
        x: -root.margin;
        y: 300px;
        width: parent.width + 48px + root.margin;
        height: parent.height - 300px;
        clip: true;

        Rectangle {
            x: root.margin;
            width: parent.width - root.margin;
            y: -Library.shelf * root.shelf-pitch;
            height: Library.shelves.length * root.shelf-pitch;
            animate y { duration: Theme.motion(200ms); easing: cubic-bezier(0.2, 0.8, 0.2, 1); }

            for shelf[si] in Library.shelves: Rectangle {
                property <bool> in-front: si == Library.shelf;
                property <int> pick: self.in-front ? Library.selected : shelf.selected;
                property <int> first: self.in-front ? Library.first : shelf.first;
                property <length> scroll: max(0, min(self.first * root.pitch, shelf.games.length * root.pitch + 12px - root.width));
                y: si * root.shelf-pitch;
                height: root.shelf-pitch;
                // Only the shelves around the one in front are drawn.
                visible: si >= Library.shelf - 1 && si <= Library.shelf + 1;

                ShelfTitle {
                    x: 0;
                    y: 16px;
                    height: 20px;
                    shelf: shelf;
                    front: parent.in-front;
                }

                if shelf.games.length == 0 && shelf.kind == 3: Text {
                    x: 0;
                    y: 60px;
                    text: Library.owned-loading ? @tr("Looking for your games…") : @tr("Nothing to install");
                    color: Theme.dim;
                    font-size: 14px;
                }

                for game[i] in shelf.games: Cover {
                    // The selected cover grows on its own spot.
                    x: i * root.pitch - parent.scroll - (self.selected ? 6px : 0);
                    y: 46px + 200px - self.height - 8px;
                    game: game;
                    selected: parent.in-front && i == parent.pick;
                    focused: fs.has-focus;
                    launching: Library.launching == game.id;
                    visible: self.x > -root.pitch && self.x < root.width + 48px;
                    animate x { duration: Theme.motion(160ms); easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                    clicked => {
                        if !parent.in-front {
                            root.go-shelf(si);
                            Library.selected = i;
                        } else if Library.selected == i {
                            root.act();
                        } else {
                            Library.selected = i;
                        }
                        fs.focus();
                    }
                }

                // The shelves behind the one in front are dimmed. Ends with
                // the covers: the shelf above would show a band of it.
                Rectangle {
                    y: 40px;
                    height: 46px + 200px - 8px - 40px;
                    background: Theme.background.with-alpha(parent.in-front ? 0 : 0.45);
                    animate background { duration: 220ms; }
                }
            }
        }
    }
}
