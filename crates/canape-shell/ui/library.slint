// The game library, Canapé's landing page: the selected game large, then
// shelves of covers: recent, installed, one per store, to install. The
// shelf in front is full; the next one peeks in below. Left and right move
// along the shelf (the gamepad sends arrow keys while it has the focus, see
// nav.rs), up and down change shelf, A plays or installs. The games, their
// covers and the launches come from library.rs, the shelves from
// shelves.rs.

import { Theme } from "theme.slint";
import { App } from "state.slint";
import { PadGlyph, StoreLogo } from "widgets.slint";
import { RevealLine } from "kit.slint";

export struct GameView {
    id: string,
    title: string,
    // Store name: "Steam", "Epic", "GOG" or "Xbox" (brands: not translated),
    // or "Other" for a game of games.json (see Library.store-name).
    source: string,
    // Empty until decoded, and again once scrolled far away.
    cover: image,
    // The game has cover art on disk, loaded or not yet.
    art: bool,
    // 0 unknown, 1 today, 2 yesterday, 3 within 7 days, 4 within 30 days,
    // 5 longer ago.
    played: int,
    // False for an owned game that A installs.
    installed: bool,
    // Install progress, 0 to 1; -1 when not installing.
    progress: float,
}

export struct ShelfView {
    // 0 recent, 1 installed, 2 a store's, 3 to install.
    kind: int,
    // The store of a store's shelf (see GameView.source), "" otherwise.
    store: string,
    games: [GameView],
    // Selected game and first game in view while the shelf is not in front.
    selected: int,
    first: int,
}

// The game page: what the shelf does not show, for the selected game.
export struct DetailView {
    // The cover, larger than on the shelf.
    cover: image,
    // Bytes on disk in tenths of a gigabyte, -1 when unknown. For a game
    // to install, what it will take once installed.
    size-tenths: int,
    // A game to install from Epic or GOG: the free space of the games
    // folder, in tenths of a gigabyte; -1 otherwise or when unknown.
    free-tenths: int,
    // The games folder.
    folder: string,
    // Minutes played, -1 when unknown.
    minutes: int,
    // The game's executable, once seen after a launch from Canapé; its
    // profile, if any, shows on the page. "" when not known yet.
    exe: string,
}

// A line of the "Add a game" sub-page.
export struct AddGameView {
    // The game's title (a shortcut's name).
    name: string,
    // The program's file name.
    file: string,
    // In games.json: A takes it out; otherwise A adds it.
    added: bool,
}

export global Library {
    // Top to bottom.
    in property <[ShelfView]> shelves;
    // The shelf in front, its selected game and its first game in view.
    in property <int> shelf;
    in-out property <int> selected;
    in-out property <int> first;
    // Every installed game.
    in property <int> total;
    in property <bool> scanning;
    // A cache or a finished scan has been loaded: an empty list means
    // there are no games.
    in property <bool> ready;
    // Id of the game being launched, "" when none.
    in property <string> launching;
    // Title of a game that could not be launched, "" when none.
    in property <string> failed;
    // A glow in the selected game's colour, stretched over the window: two
    // layers, the new colour goes into the hidden one, which then fades in
    // over the other.
    in property <image> backdrop-a;
    in property <image> backdrop-b;
    in property <bool> backdrop-b-front;
    // Where the layers start, in physical pixels: left of it the glow is
    // gone and the window's background shows.
    in property <int> backdrop-x;
    // A Steam Web API key is set in shell.json.
    in property <bool> steam-key;
    // Signed-in Epic account (through Legendary), "" when none.
    in property <string> epic-account;
    // Legendary is being downloaded or its sign-in window is open.
    in property <bool> epic-busy;
    // Signed-in GOG account (through gogdl), "" when none.
    in property <string> gog-account;
    // gogdl is being downloaded, or the sign-in code is being checked.
    in property <bool> gog-busy;
    // GOG's sign-in page is open in the browser: the clipboard is watched
    // for the address it lands on.
    in property <bool> gog-waiting;
    // The owned lists are being fetched.
    in property <bool> owned-loading;
    // Last install or sign-in failure, "" when none.
    in property <string> install-error;
    // Games listed in games.json.
    in property <int> external;
    // The "Add a game" sub-page: games.json and the shortcuts that could
    // be games, while they are being looked for, and why games.json could
    // not be read or written ("" when it could).
    in property <[AddGameView]> add-games;
    in property <bool> add-games-loading;
    in property <string> add-games-error;
    callback open-add-games();
    // A on this line: add the game, or take it out of games.json.
    callback toggle-add-game(int);
    // Where Legendary and gogdl install games, and its free space in
    // tenths of a gigabyte (-1 when unknown).
    in property <string> games-folder;
    in property <int> games-free-tenths: -1;
    // Settings: the previous (-1) or next (1) games folder.
    callback games-folder-step(int);

    // Bring this shelf to the front.
    callback focus-shelf(int);
    // The game page of the selected game is open, and what it shows.
    in-out property <bool> detail;
    in property <DetailView> detail-view;
    // Wide art behind the game page (Steam's), drawn at the window's width
    // and faded into the background; empty when there is none.
    in property <image> detail-art;
    callback open-detail(int);
    callback close-detail();
    callback epic-login();
    callback gog-login();
    callback launch(int);
    // The game at this index of the shelf in front was selected, with the
    // first game in view.
    callback select(int, int);
    // A shelf shows this many covers across, of this size in physical
    // pixels.
    callback view(int, float, float);
    // The shelf gained (true) or lost the focus.
    callback focus-changed(bool);
    // The library page was shown (true) or left.
    callback shown(bool);

    // A store's name as shown; "Other" is the games of games.json.
    public pure function store-name(store: string) -> string {
        store == "Other" ? @tr("Other games") : store
    }

    public pure function played-text(played: int) -> string {
        if played == 1 {
            return @tr("Played today");
        }
        if played == 2 {
            return @tr("Played yesterday");
        }
        if played == 3 {
            return @tr("Played in the last 7 days");
        }
        if played == 4 {
            return @tr("Played in the last 30 days");
        }
        if played == 5 {
            return @tr("Played more than a month ago");
        }
        ""
    }
}

// A cover on the shelf; the selected one is larger, fully opaque and
// ringed.
component Cover inherits Rectangle {
    in property <GameView> game;
    in property <bool> selected;
    in property <bool> focused;
    in property <bool> launching;
    callback clicked();
    width: root.selected ? 128px : 116px;
    height: root.selected ? 192px : 174px;
    animate width, height { duration: 160ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }

    if root.selected && root.focused: Rectangle {
        x: -6px;
        y: -6px;
        width: parent.width + 12px;
        height: parent.height + 12px;
        border-radius: 16px;
        border-width: 3px;
        border-color: Theme.focus;
        drop-shadow-blur: 30px;
        drop-shadow-color: #0000008c;
        drop-shadow-offset-y: 18px;
    }

    card := Rectangle {
        border-radius: 10px;
        clip: true;
        // Under loaded art, nothing: a fill would show at the rounded corners.
        background: !root.game.art ? Theme.accent.mix(Theme.surface, 0.3) : root.game.cover.width > 0 ? transparent : Theme.surface-high;

        // Fades in once decoded.
        if root.game.art: Image {
            width: 100%;
            height: 100%;
            source: root.game.cover;
            image-fit: fill;
            opacity: root.game.cover.width > 0 ? 1 : 0;
            animate opacity { duration: 200ms; }
        }

        // No art: the title at the bottom of a tinted card.
        if !root.game.art: Text {
            x: 12px;
            y: parent.height - self.height - 12px;
            width: parent.width - 24px;
            text: root.game.title;
            color: Theme.text;
            font-size: 15px;
            font-weight: 700;
            wrap: word-wrap;
            max-height: parent.height - 24px;
            overflow: elide;
        }

        // Install in progress: a bar along the bottom.
        if root.game.progress >= 0: Rectangle {
            x: 10px;
            y: parent.height - 16px;
            width: parent.width - 20px;
            height: 6px;
            border-radius: 3px;
            background: #000000a0;
            Rectangle {
                x: 0;
                width: parent.width * root.game.progress;
                border-radius: 3px;
                background: Theme.accent;
            }
        }

        if root.launching: Rectangle {
            background: #0b0c0fb0;
        }
    }

    // Dims the covers not selected: a veil costs far less than an opacity,
    // which the software renderer draws through a layer.
    Rectangle {
        border-radius: 10px;
        background: Theme.background.with-alpha(root.selected ? 0 : 0.38);
        animate background { duration: 160ms; }
    }

    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// The main action: white, with the A button. A quiet one is another
// choice, which left or right selects.
component PrimaryButton inherits Rectangle {
    in property <string> label;
    // Briefly darker after a press of A.
    in property <bool> pressed;
    in property <bool> quiet;
    callback clicked();
    height: 48px;
    width: text.preferred-width + (root.quiet ? 44px : 60px);
    border-radius: 10px;
    background: root.quiet ? Theme.surface-high.with-alpha(0.7) : root.pressed || ta.pressed ? Theme.focus.darker(0.3) : Theme.focus;
    animate background { duration: 90ms; }

    HorizontalLayout {
        padding-left: root.quiet ? 22px : 14px;
        padding-right: 22px;
        spacing: 10px;
        if !root.quiet: VerticalLayout {
            alignment: center;
            PadGlyph {
                text: "A";
                ink: Theme.background;
            }
        }

        text := Text {
            text: root.label;
            color: root.quiet ? Theme.text : Theme.background;
            font-size: 16px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// A shelf's name, with its store's logo and its size.
component ShelfTitle inherits HorizontalLayout {
    in property <ShelfView> shelf;
    in property <bool> front;
    spacing: 8px;
    alignment: start;
    if root.shelf.kind == 2: VerticalLayout {
        alignment: center;
        StoreLogo {
            width: 16px;
            height: 16px;
            store: root.shelf.store;
            ink: label.color;
        }
    }
    label := Text {
        text: root.shelf.kind == 0 ? @tr("Recent") : root.shelf.kind == 1 ? @tr("Installed · {}", root.shelf.games.length) : root.shelf.kind == 2 ? Library.store-name(root.shelf.store) + " · " + root.shelf.games.length : @tr("To install · {}", root.shelf.games.length);
        color: root.front ? Theme.text.mix(Theme.dim, 0.6) : Theme.dim;
        font-size: 14px;
        font-weight: 600;
        vertical-alignment: center;
    }
}

// The game page, over the shelves: the cover large, what is known about the
// game, and the button that plays or installs it. Its lines slide in like
// the title on the shelf.
component GamePage inherits Rectangle {
    in property <GameView> game;
    in property <DetailView> view;
    in property <bool> pressed;
    callback play();
    // The game does not fit in the games folder.
    property <bool> short: !root.game.installed && root.view.free-tenths >= 0 && root.view.size-tenths > root.view.free-tenths;

    cover := Rectangle {
        x: 0;
        y: 96px;
        width: 240px;
        height: 360px;
        border-radius: 12px;
        clip: true;
        background: root.game.art ? Theme.surface-high : Theme.accent.mix(Theme.surface, 0.3);
        drop-shadow-blur: 40px;
        drop-shadow-color: #00000099;
        drop-shadow-offset-y: 20px;
        // Launching: the cover comes forward a little.
        property <length> lift: Library.launching == root.game.id ? 8px : 0;
        animate lift { duration: 500ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }

        Image {
            y: -cover.lift;
            width: 100%;
            height: 100%;
            source: root.view.cover.width > 0 ? root.view.cover : root.game.cover;
            image-fit: fill;
        }

        if !root.game.art: Text {
            x: 16px;
            y: parent.height - self.height - 16px;
            width: parent.width - 32px;
            text: root.game.title;
            color: Theme.text;
            font-size: 20px;
            font-weight: 700;
            wrap: word-wrap;
        }
    }

    VerticalLayout {
        x: 280px - 14px;
        y: 96px;
        width: parent.width - 280px;
        height: 360px;
        spacing: 14px;
        alignment: end;

        store := RevealLine {
            order: 0;
            spacing: 8px;
            alignment: start;
            height: 16px;
            VerticalLayout {
                alignment: center;
                StoreLogo {
                    width: 15px;
                    height: 15px;
                    store: root.game.source;
                    ink: Theme.dim;
                    opacity: store.shown;
                }
            }
            Text {
                text: Library.store-name(root.game.source).to-uppercase();
                color: Theme.dim;
                font-size: 13px;
                font-weight: 600;
                letter-spacing: 1px;
                vertical-alignment: center;
                opacity: store.shown;
            }
        }

        title := RevealLine {
            order: 1;
            Text {
                text: root.game.title;
                color: Theme.text;
                font-size: 52px;
                font-weight: 700;
                letter-spacing: -1px;
                wrap: word-wrap;
                max-height: 130px;
                overflow: elide;
                opacity: title.shown;
            }
        }

        // When it was played, for how long, and its size: only what is known.
        facts := RevealLine {
            order: 2;
            Text {
                text: (root.game.installed ? Library.played-text(root.game.played) : @tr("Not installed"))
                    + (root.view.minutes >= 60 ? " · " + @tr("{} h played", Math.round(root.view.minutes / 60)) : root.view.minutes > 0 ? " · " + @tr("{} min played", root.view.minutes) : "")
                    + (root.view.size-tenths >= 0 ? " · " + @tr("{} GB", App.tenths(root.view.size-tenths)) : "")
                    + (!root.game.installed && root.view.free-tenths >= 0 ? " · " + @tr("{} GB free in {}", App.tenths(root.view.free-tenths), root.view.folder) : "");
                color: Theme.text.mix(Theme.dim, 0.6);
                font-size: 16px;
                overflow: elide;
                opacity: facts.shown;
            }
        }

        action := RevealLine {
            order: 3;
            padding-top: 10px;
            spacing: 16px;
            alignment: start;
            PrimaryButton {
                opacity: action.shown;
                pressed: root.pressed;
                label: Library.launching == root.game.id ? @tr("Launching…") : root.game.progress >= 0 ? @tr("Installing…") : root.game.installed ? @tr("Play") : @tr("Install");
                clicked => {
                    root.play();
                }
            }
            VerticalLayout {
                alignment: center;
                Text {
                    opacity: action.shown;
                    text: Library.install-error != "" ? Library.install-error : Library.failed != "" ? @tr("Could not launch {}", Library.failed) : root.short && root.game.progress < 0 ? @tr("Not enough space: free some up, or pick another games folder in Settings.") : root.game.progress == 0 ? @tr("Waiting for the store…") : root.game.progress > 0 ? @tr("Installing… {} %", Math.round(root.game.progress * 100)) : "";
                    color: Library.install-error != "" || Library.failed != "" || (root.short && root.game.progress < 0) ? Theme.warn : Theme.text.mix(Theme.dim, 0.6);
                    font-size: 14px;
                    overflow: elide;
                }
            }
        }
    }

    // The game's profile, once its executable is known and has one: every
    // profile is laid at the same place, only the matching one shows.
    for profile in App.profiles: Rectangle {
        x: 280px;
        y: 96px + 360px + 32px;
        width: min(560px, root.width - 280px);
        height: 64px;
        border-radius: 12px;
        background: Theme.surface.with-alpha(0.85);
        visible: root.view.exe != "" && profile.exe.to-lowercase() == root.view.exe.to-lowercase();

        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            alignment: center;
            spacing: 4px;
            Text {
                text: @tr("This game's profile");
                color: Theme.dim;
                font-size: 13px;
            }

            Text {
                text: (profile.auto-tdp ? App.fps-value(profile.target-fps) + " · " + App.watts(profile.min-watts) + "–" + App.watts(profile.max-watts) : @tr("Auto TDP off")) + (profile.learned-watts >= 0 ? " · " + @tr("{} learned", App.watts(profile.learned-watts)) : "") + (profile.fps-limit > 0 ? " · " + @tr("limit {}", App.fps-value(profile.fps-limit)) : "");
                color: Theme.text;
                font-size: 16px;
                font-weight: 600;
                overflow: elide;
            }
        }
    }

    // Install progress under the button.
    if root.game.progress >= 0: Rectangle {
        x: 280px;
        y: 96px + 360px + 24px;
        width: 360px;
        height: 4px;
        border-radius: 2px;
        background: Theme.surface-focus;
        Rectangle {
            x: 0;
            width: parent.width * root.game.progress;
            border-radius: 2px;
            background: Theme.accent;
            animate width { duration: 400ms; }
        }
    }
}

export component LibraryPage inherits Rectangle {
    property <ShelfView> front: Library.shelves[Library.shelf];
    property <GameView> current: root.front.games[Library.selected];
    property <bool> has-games: root.front.games.length > 0;
    property <bool> to-install: root.front.kind == 3;
    // Empty To install: the store to sign in to, 0 Epic, 1 GOG.
    in-out property <int> account-pick: 0;
    property <bool> signing-up: !root.has-games && root.to-install;
    property <int> sel: Library.selected;
    property <length> pitch: 132px;
    // From one shelf's title to the next.
    property <length> shelf-pitch: 240px;
    // Room left of the shelves for the focus ring.
    property <length> margin: 16px;
    // A was just pressed: the button shows it for a moment.
    property <bool> pressed;
    // Covers fully in view across a shelf.
    property <int> in-view: Math.floor((root.width + 48px) / root.pitch);
    changed sel => {
        // The shelf only scrolls when the selection reaches an edge, keeping
        // one game beside it: a step then redraws two covers, not the row.
        if self.sel < Library.first + 1 {
            Library.first = max(0, self.sel - 1);
        } else if self.sel > Library.first + root.in-view - 2 {
            Library.first = self.sel - root.in-view + 2;
        }
        Library.select(self.sel, Library.first);
    }

    function report() {
        // Decoded at the size of a cover not selected, so that only the
        // selected one is scaled when drawn.
        Library.view(Math.ceil(root.width / root.pitch) + 1, 116px / 1phx, 174px / 1phx);
    }
    // A on the shelf opens the game page; A on the page plays or installs.
    function act() {
        root.pressed = true;
        if Library.detail {
            // A game that does not fit is not installed: the page says why.
            let short = !root.current.installed && Library.detail-view.free-tenths >= 0 && Library.detail-view.size-tenths > Library.detail-view.free-tenths;
            if root.current.progress < 0 && !short {
                Library.launch(Library.selected);
            }
        } else if root.has-games {
            Library.open-detail(Library.selected);
        } else if root.signing-up && root.account-pick == 0 && !Library.epic-busy {
            Library.epic-login();
        } else if root.signing-up && root.account-pick == 1 && !Library.gog-busy {
            Library.gog-login();
        }
    }
    function go-shelf(index: int) {
        if index >= 0 && index < Library.shelves.length && index != Library.shelf {
            Library.focus-shelf(index);
        }
    }
    init => {
        self.report();
        Library.select(Library.selected, Library.first);
    }
    changed width => {
        self.report();
    }

    fs := FocusScope {
        init => {
            self.focus();
        }
        key-pressed(event) => {
            if Library.detail {
                // B goes back to the shelf, on the same game.
                if event.text == Key.Escape {
                    Library.close-detail();
                    return accept;
                }
                if event.text == Key.Return || event.text == " " {
                    root.act();
                }
                return accept;
            }
            if event.text == Key.LeftArrow {
                if root.signing-up {
                    root.account-pick = 0;
                }
                Library.selected = max(0, Library.selected - 1);
                return accept;
            }
            if event.text == Key.RightArrow {
                if root.signing-up {
                    root.account-pick = 1;
                }
                Library.selected = max(0, min(root.front.games.length - 1, Library.selected + 1));
                return accept;
            }
            if event.text == Key.UpArrow {
                root.go-shelf(Library.shelf - 1);
                return accept;
            }
            if event.text == Key.DownArrow {
                root.go-shelf(Library.shelf + 1);
                return accept;
            }
            if event.text == Key.Return || event.text == " " {
                root.act();
                return accept;
            }
            return reject;
        }
        focus-gained(reason) => {
            Library.focus-changed(true);
        }
        focus-lost(reason) => {
            Library.focus-changed(false);
        }
    }

    Timer {
        interval: 140ms;
        running: root.pressed;
        triggered => {
            root.pressed = false;
        }
    }

    if Library.detail: GamePage {
        width: root.width;
        height: root.height;
        game: root.current;
        view: Library.detail-view;
        pressed: root.pressed;
        play => {
            root.act();
            fs.focus();
        }
    }

    // The selected game, or why there is none; a new model at each game,
    // so its title fades in.
    // The selected game, or why there is none; a new model at each game,
    // so its lines slide in again, one after the other. The block sits
    // 14px left of its place: each line moves that far to the right.
    for key in (Library.detail ? [] : [Library.shelf + ":" + (root.has-games ? root.current.id : "")]): VerticalLayout {
        x: -14px;
        y: 28px;
        width: 654px;
        height: 270px;
        spacing: 14px;
        alignment: start;

        store := RevealLine {
            order: 0;
            spacing: 8px;
            alignment: start;
            height: 16px;
            if root.has-games: VerticalLayout {
                alignment: center;
                StoreLogo {
                    width: 15px;
                    height: 15px;
                    store: root.current.source;
                    ink: Theme.dim;
                    opacity: store.shown;
                }
            }
            Text {
                text: root.has-games ? Library.store-name(root.current.source).to-uppercase() : root.to-install ? @tr("To install").to-uppercase() : "";
                color: Theme.dim;
                font-size: 13px;
                font-weight: 600;
                letter-spacing: 1px;
                vertical-alignment: center;
                opacity: store.shown;
            }
        }

        title := RevealLine {
            order: 1;
            Text {
                text: root.has-games ? root.current.title : !root.to-install ? (!Library.ready ? @tr("Looking for games…") : @tr("No games found")) : Library.owned-loading ? @tr("Looking for your games…") : Library.steam-key || Library.epic-account != "" || Library.gog-account != "" ? @tr("Every game you own is installed") : @tr("Install your games from here");
                color: Theme.text;
                font-size: 52px;
                font-weight: 700;
                letter-spacing: -1px;
                overflow: elide;
                opacity: title.shown;
            }
        }

        note := RevealLine {
            order: 2;
            Text {
                text: Library.install-error != "" ? Library.install-error : Library.failed != "" ? @tr("Could not launch {}", Library.failed) : root.signing-up && Library.gog-waiting ? @tr("Sign in to GOG in the browser, then copy the address of the page it lands on: Canapé reads it from the clipboard.") : root.signing-up ? @tr("Steam: add your Steam Web API key (steamcommunity.com/dev/apikey) as steam_api_key in shell.json. Epic and GOG: sign in once below; Canapé installs their games without their launchers.") : !root.has-games && Library.ready ? @tr("Canapé lists the games installed with Steam, the Epic Games Launcher, GOG Galaxy and the Xbox app.") : root.has-games && root.current.progress == 0 ? @tr("Waiting for the store…") : root.has-games && root.current.progress > 0 ? @tr("Installing… {} %", Math.round(root.current.progress * 100)) : root.has-games && !root.current.installed ? @tr("Not installed") : root.has-games ? Library.played-text(root.current.played) : "";
                color: Library.install-error != "" || Library.failed != "" ? Theme.warn : Theme.text.mix(Theme.dim, 0.6);
                font-size: 16px;
                wrap: word-wrap;
                max-height: 66px;
                overflow: elide;
                opacity: note.shown;
            }
        }

        if root.has-games: button := RevealLine {
            order: 3;
            padding-top: 10px;
            alignment: start;
            PrimaryButton {
                opacity: button.shown;
                pressed: root.pressed;
                label: Library.launching == root.current.id ? @tr("Launching…") : root.current.progress >= 0 ? @tr("Installing…") : @tr("Details");
                clicked => {
                    root.act();
                    fs.focus();
                }
            }
        }

        // No game to install yet: sign in to Epic or GOG, left and right
        // pick one.
        if root.signing-up: accounts := RevealLine {
            order: 3;
            padding-top: 10px;
            spacing: 12px;
            alignment: start;
            PrimaryButton {
                opacity: accounts.shown;
                pressed: root.pressed && root.account-pick == 0;
                quiet: root.account-pick != 0;
                label: Library.epic-busy ? @tr("Opening the Epic sign-in…") : Library.epic-account != "" ? @tr("Epic: {} (sign in again)", Library.epic-account) : @tr("Sign in to Epic Games");
                clicked => {
                    root.account-pick = 0;
                    root.act();
                    fs.focus();
                }
            }
            PrimaryButton {
                opacity: accounts.shown;
                pressed: root.pressed && root.account-pick == 1;
                quiet: root.account-pick != 1;
                label: Library.gog-busy ? @tr("Opening the GOG sign-in…") : Library.gog-waiting ? @tr("Waiting for the GOG address…") : Library.gog-account != "" ? @tr("GOG: {} (sign in again)", Library.gog-account) : @tr("Sign in to GOG");
                clicked => {
                    root.account-pick = 1;
                    root.act();
                    fs.focus();
                }
            }
        }
    }

    // The shelves, the one in front at the top; the one above slides out
    // of view, the next one peeks in at the bottom.
    // Starts left of the covers: the focus ring reaches past the first one.
    Rectangle {
        visible: !Library.detail;
        x: -root.margin;
        y: 300px;
        width: parent.width + 48px + root.margin;
        height: parent.height - 300px;
        clip: true;

        Rectangle {
            x: root.margin;
            width: parent.width - root.margin;
            y: -Library.shelf * root.shelf-pitch;
            height: Library.shelves.length * root.shelf-pitch;
            animate y { duration: 200ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }

            for shelf[si] in Library.shelves: Rectangle {
                property <bool> in-front: si == Library.shelf;
                property <int> pick: self.in-front ? Library.selected : shelf.selected;
                property <int> first: self.in-front ? Library.first : shelf.first;
                property <length> scroll: max(0, min(self.first * root.pitch, shelf.games.length * root.pitch + 12px - root.width));
                y: si * root.shelf-pitch;
                height: root.shelf-pitch;
                // Only the shelves around the one in front are drawn.
                visible: si >= Library.shelf - 1 && si <= Library.shelf + 1;

                ShelfTitle {
                    x: 0;
                    y: 16px;
                    height: 20px;
                    shelf: shelf;
                    front: parent.in-front;
                }

                if shelf.games.length == 0 && shelf.kind == 3: Text {
                    x: 0;
                    y: 60px;
                    text: Library.owned-loading ? @tr("Looking for your games…") : @tr("Nothing to install");
                    color: Theme.dim;
                    font-size: 14px;
                }

                for game[i] in shelf.games: Cover {
                    // The selected cover grows on its own spot.
                    x: i * root.pitch - parent.scroll - (self.selected ? 6px : 0);
                    y: 46px + 200px - self.height - 8px;
                    game: game;
                    selected: parent.in-front && i == parent.pick;
                    focused: fs.has-focus;
                    launching: Library.launching == game.id;
                    visible: self.x > -root.pitch && self.x < root.width + 48px;
                    animate x { duration: 160ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
                    clicked => {
                        if !parent.in-front {
                            root.go-shelf(si);
                            Library.selected = i;
                        } else if Library.selected == i {
                            root.act();
                        } else {
                            Library.selected = i;
                        }
                        fs.focus();
                    }
                }

                // The shelves behind the one in front are dimmed. Ends with
                // the covers: the shelf above would show a band of it.
                Rectangle {
                    y: 40px;
                    height: 46px + 200px - 8px - 40px;
                    background: Theme.background.with-alpha(parent.in-front ? 0 : 0.45);
                    animate background { duration: 220ms; }
                }
            }
        }
    }
}
