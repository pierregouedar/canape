// Data shared between Rust and the pages. Numbers stay numbers so that Slint
// formats and translates them; -1 means "unknown".

export struct StatusView {
    connected: bool,
    // Watts, -1 while a firmware mode picks the limits.
    tdp: int,
    // What the APU draws, in tenths of a watt.
    power-tenths: int,
    // "silent", "performance", "turbo", "manual" or "".
    mode: string,
    fps: int,
    // GPU activity, percent.
    gpu: int,
    // CPU temperature, °C.
    temp: int,
    battery: int,
    power-known: bool,
    on-battery: bool,
    auto-tdp: bool,
    target-fps: int,
    min-watts: int,
    max-watts: int,
    // Watts while on battery, 0 = no cap.
    battery-cap: int,
    // °C, 0 = no limit.
    temp-limit: int,
    thermal-limited: bool,
    // Executable names, "" when none.
    foreground: string,
    active-profile: string,
    // Other programs driving the hardware, comma separated.
    conflicts: string,
    bench-running: bool,
    bench-step: int,
    bench-steps: int,
    bench-watts: int,
    bench-seconds-left: int,
    // Power range of this model, in watts.
    tdp-floor: int,
    tdp-ceiling: int,
    // Fan speeds, -1 when unknown.
    cpu-rpm: int,
    gpu-rpm: int,
    // "" (firmware curves), "balanced", "max-cooling" or "custom".
    fan-preset: string,
    // The CPU fan's custom curve (hardware.rs: viewbox 90 x 100), "" when
    // the firmware drives it.
    fan-line: string,
    fan-area: string,
    // Driver frame rate cap, 0 = none.
    fps-limit: int,
    // "gamepad", "wasd", "mouse" or "" when unknown.
    controller: string,
}

export struct ProfileView {
    exe: string,
    auto-tdp: bool,
    target-fps: int,
    min-watts: int,
    max-watts: int,
    learned-watts: int,
    // Frame rate cap, 0 for none.
    fps-limit: int,
}

export struct BenchRow {
    watts: int,
    fps-avg: int,
    fps-low: int,
    // Frames per watt, in tenths.
    fps-per-watt-tenths: int,
    temp: int,
    // Average frame rate relative to the best one, for the bars.
    share: float,
}

export struct RecView {
    available: bool,
    watts: int,
    fps: int,
}

export struct BenchView {
    available: bool,
    completed: bool,
    exe: string,
    target-fps: int,
    sweet-spot: RecView,
    for-target: RecView,
    most-efficient: RecView,
}

// The last minute as Path commands (history.rs): viewbox 59 x 100, the
// newest sample on the right, y = 0 at the top of the scale.
export struct GraphView {
    // Watts at the top of the power graph.
    power-scale: int,
    power-line: string,
    power-area: string,
    limit-line: string,
    // GPU activity, 0 to 100 %.
    gpu-line: string,
    gpu-area: string,
}

// Outcome of the last command, shown in the bottom bar.
export enum Notice {
    idle,
    unreachable,
    service-error,
    saved,
}

export global App {
    in property <StatusView> status;
    in property <GraphView> graphs: { power-scale: 10 };
    in property <[ProfileView]> profiles;
    in property <BenchView> bench;
    in property <[BenchRow]> bench-rows;
    // Cleared after a while by the window (app.slint).
    in-out property <Notice> notice;
    // Message from the service, untranslated.
    in property <string> notice-detail;
    // "auto" or a language code.
    in property <string> language: "auto";
    in property <string> version;
    // Covers downloaded for games without art (shell.json), and whether a
    // SteamGridDB key is set there.
    in property <bool> online-covers;
    in property <bool> griddb-key;
    // Built-in screen: current refresh rate (0: unknown) and the rates it
    // offers at the current resolution.
    in property <int> refresh-hz;
    in property <[int]> refresh-rates;
    // The Ally's own buttons act on Canapé (shell.json).
    in property <bool> ally-buttons;
    // Time of day, "21:42".
    in property <string> clock;
    // Power the auto TDP learned for the game in the foreground, -1 when
    // none.
    in property <int> learned-watts: -1;

    callback set-mode(string);
    callback change-tdp(int);
    callback apply-tdp(int);
    callback toggle-auto-tdp();
    callback set-target-fps(int);
    callback change-min-watts(int);
    callback change-max-watts(int);
    callback set-battery-cap(int);
    callback set-temp-limit(int);
    callback save-profile();
    callback delete-profile(string);
    callback refresh();
    callback start-bench(int, int);
    callback cancel-bench();
    // Total seconds of a run with this step (W) and measuring time (s).
    pure callback bench-duration(int, int) -> int;
    // Saves a game profile from the bench result at this wattage.
    callback apply-profile(int);
    callback set-language(string);
    // Accent picked in the settings page, from the sliders (hue in
    // degrees, saturation and value in [0, 1]) or a preset (#rrggbb).
    callback pick-accent-hsv(float, float, float);
    callback pick-accent(string);
    // Hardware page. A preset key from StatusView.fan-preset, "" for the
    // firmware's curves.
    callback set-fan-preset(string);
    // 0 removes the cap.
    callback set-fps-limit(int);
    callback set-controller(string);
    // Saves the current fan curves and frame rate cap in the profile of the
    // game in the foreground.
    callback save-hardware-profile();
    callback toggle-online-covers();
    callback set-refresh(int);
    // Next refresh rate the screen offers, wrapping around.
    callback cycle-refresh();
    // A page that moves with the arrow keys gained (true) or lost the
    // focus: the gamepad sends arrows instead of Tab while it has it.
    callback arrow-focus(bool);
    callback toggle-ally-buttons();

    // Shared formatting, translated.
    public pure function watts(w: int) -> string {
        @tr("{} W", w)
    }
    // Tenths of a watt, with one decimal: 126 -> "12.6 W".
    public pure function watts-tenths(t: int) -> string {
        @tr("{} W", tenths(t))
    }
    public pure function fps-value(f: int) -> string {
        @tr("{} FPS", f)
    }
    public pure function celsius(c: int) -> string {
        @tr("{} °C", c)
    }
    public pure function percent(p: int) -> string {
        @tr("{} %", p)
    }
    // A number given in tenths, with one decimal: 26 -> "2.6" (or "2,6").
    public pure function tenths(value: int) -> string {
        Math.floor(value / 10) + @tr("decimal separator" => ".") + Math.mod(value, 10)
    }
    public pure function duration(seconds: int) -> string {
        Math.floor(seconds / 60) + ":" + (Math.mod(seconds, 60) < 10 ? "0" : "") + Math.mod(seconds, 60)
    }
    public pure function mode-name(mode: string) -> string {
        if mode == "silent" {
            return @tr("Silent");
        }
        if mode == "performance" {
            return @tr("Performance");
        }
        if mode == "turbo" {
            return @tr("Turbo");
        }
        if mode == "manual" {
            return @tr("Manual");
        }
        ""
    }
    // `text` when `value` is known, else a dash.
    public pure function known(value: int, text: string) -> string {
        status.connected && value >= 0 ? text : "—"
    }
    // Firmware modes pick the power limits themselves and do not report them.
    public pure function firmware-mode() -> bool {
        status.mode == "silent" || status.mode == "performance" || status.mode == "turbo"
    }
}
