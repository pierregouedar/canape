// What a back button can send, as a grid of chips with an icon each:
// gamepad buttons as the controller draws them, keys as keycaps, mouse
// and media actions as small drawings. The chips follow the order of
// ButtonTarget::ALL (canape-core), so a chip's index is the target's.

import { Theme } from "theme.slint";
import { Icon } from "kit.slint";
import { PadGlyph } from "widgets.slint";

// A drawing on a 24-unit grid, in the chip's ink.
component Drawing inherits Path {
    in property <color> ink;
    width: 28px;
    height: 28px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: root.ink;
    stroke-width: 1.8px;
    stroke-line-join: round;
}

// Filled shapes on the same grid.
component Shape inherits Path {
    in property <color> ink;
    width: 28px;
    height: 28px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: root.ink;
}

// A key: an outline with its label, or a drawing for arrows and the like.
component Keycap inherits Rectangle {
    in property <string> label;
    in property <string> drawing;
    in property <bool> filled;
    in property <color> ink;
    height: 30px;
    width: root.label != "" ? max(30px, label-text.preferred-width + 16px) : 30px;
    border-radius: 6px;
    border-width: 1.5px;
    border-color: root.ink;

    label-text := Text {
        visible: root.label != "";
        text: root.label;
        color: root.ink;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.drawing != "" && !root.filled: Drawing {
        x: (parent.width - self.width) / 2 + 3px;
        y: (parent.height - self.height) / 2 + 3px;
        width: 22px;
        height: 22px;
        ink: root.ink;
        stroke-width: 1.6px;
        commands: root.drawing;
    }
    if root.drawing != "" && root.filled: Shape {
        x: (parent.width - self.width) / 2 + 4px;
        y: (parent.height - self.height) / 2 + 4px;
        width: 20px;
        height: 20px;
        ink: root.ink;
        commands: root.drawing;
    }
}

// The icon of target `target`; `own-key` names the button's own key, for
// its default.
export component TargetIcon inherits Rectangle {
    in property <int> target;
    in property <string> own-key;
    in property <color> ink: Theme.text;
    property <string> pad-label: ["A", "B", "X", "Y", "LB", "RB", "LT", "RT", "LS", "RS"][root.target - 2];
    // The D-pad's outline, and the arm of each direction.
    property <string> cross: "M 9 2 L 15 2 L 15 9 L 22 9 L 22 15 L 15 15 L 15 22 L 9 22 L 9 15 L 2 15 L 2 9 L 9 9 Z";
    property <[string]> arms: [
        "M 9 2 L 15 2 L 15 9 L 9 9 Z",
        "M 9 15 L 15 15 L 15 22 L 9 22 Z",
        "M 2 9 L 9 9 L 9 15 L 2 15 Z",
        "M 15 9 L 22 9 L 22 15 L 15 15 Z",
    ];
    property <[string]> key-labels: ["Esc", "Enter", "Space", "Tab", "", "", "", "", "", "PgUp", "PgDn", "Shift", "Ctrl", "", "F11", "F12"];
    property <[string]> key-drawings: [
        "", "", "", "",
        "M 9 6 L 20 6 L 20 18 L 9 18 L 3 12 Z M 12 9.5 L 17 14.5 M 17 9.5 L 12 14.5",
        "M 12 19 L 12 5 M 7 10 L 12 5 L 17 10",
        "M 12 5 L 12 19 M 7 14 L 12 19 L 17 14",
        "M 19 12 L 5 12 M 10 7 L 5 12 L 10 17",
        "M 5 12 L 19 12 M 14 7 L 19 12 L 14 17",
        "", "", "", "",
        "M 3 3 L 11 3 L 11 11 L 3 11 Z M 13 3 L 21 3 L 21 11 L 13 11 Z M 3 13 L 11 13 L 11 21 L 3 21 Z M 13 13 L 21 13 L 21 21 L 13 21 Z",
        "", "",
    ];
    // The mouse's outline, and the part each button fills.
    property <string> mouse: "M 12 3 A 6 6 0 0 1 18 9 L 18 15 A 6 6 0 0 1 6 15 L 6 9 A 6 6 0 0 1 12 3 Z M 6 10 L 18 10 M 12 3 L 12 10";
    property <[string]> mouse-parts: [
        "M 12 3 A 6 6 0 0 0 6 9 L 6 10 L 12 10 Z",
        "M 12 3 A 6 6 0 0 1 18 9 L 18 10 L 12 10 Z",
        "M 10.8 4.5 L 13.2 4.5 L 13.2 8.8 L 10.8 8.8 Z",
    ];
    property <string> small-mouse: "M 9 4 A 5 5 0 0 1 14 9 L 14 15 A 5 5 0 0 1 4 15 L 4 9 A 5 5 0 0 1 9 4 Z";
    property <string> speaker: "M 3 9 L 7 9 L 12 5 L 12 19 L 7 15 L 3 15 Z";
    width: 40px;
    height: 32px;

    // Default: the button's own key; Disabled: nothing.
    if root.target == 0: Keycap {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        label: root.own-key;
        ink: root.ink;
    }
    if root.target == 1: Drawing {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        ink: root.ink;
        commands: "M 12 3 A 9 9 0 1 1 11.99 3 M 5.6 5.6 L 18.4 18.4";
    }
    // Face buttons and stick clicks round, bumpers and triggers square.
    if root.target >= 2 && root.target <= 11: PadGlyph {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        text: root.pad-label;
        round: root.target <= 5 || root.target >= 10;
        size: 28px;
        ink: root.ink;
    }
    if root.target >= 12 && root.target <= 15: Rectangle {
        x: (parent.width - 28px) / 2;
        y: (parent.height - 28px) / 2;
        width: 28px;
        height: 28px;
        Drawing {
            x: 0;
            y: 0;
            ink: root.ink;
            stroke-width: 1.4px;
            commands: root.cross;
        }

        Shape {
            x: 0;
            y: 0;
            ink: root.ink;
            commands: root.arms[root.target - 12];
        }
    }
    // View, Menu, Xbox.
    if root.target >= 16 && root.target <= 18: Drawing {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        ink: root.ink;
        commands: root.target == 16 ? "M 4 9 L 14 9 L 14 19 L 4 19 Z M 9 9 L 9 5 L 20 5 L 20 15 L 14 15"
            : root.target == 17 ? "M 5 7 L 19 7 M 5 12 L 19 12 M 5 17 L 19 17"
            : "M 12 3 A 9 9 0 1 1 11.99 3 M 7 6.5 C 10 9 14 15 17 17.5 M 17 6.5 C 14 9 10 15 7 17.5";
    }
    if root.target >= 19 && root.target <= 34: Keycap {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        label: root.key-labels[root.target - 19];
        drawing: root.key-drawings[root.target - 19];
        filled: root.target == 32;
        ink: root.ink;
    }
    // Mouse buttons: the button pressed is filled.
    if root.target >= 35 && root.target <= 37: Rectangle {
        x: (parent.width - 28px) / 2;
        y: (parent.height - 28px) / 2;
        width: 28px;
        height: 28px;
        Drawing {
            x: 0;
            y: 0;
            ink: root.ink;
            commands: root.mouse;
        }

        Shape {
            x: 0;
            y: 0;
            ink: root.ink;
            commands: root.mouse-parts[root.target - 35];
        }
    }
    // The wheel: a mouse with its wheel, and the way it turns.
    if root.target == 38 || root.target == 39: Rectangle {
        x: (parent.width - 28px) / 2;
        y: (parent.height - 28px) / 2;
        width: 28px;
        height: 28px;
        Drawing {
            x: 0;
            y: 0;
            ink: root.ink;
            commands: root.small-mouse + (root.target == 38 ? " M 19 19 L 19 6 M 16 9 L 19 5.5 L 22 9" : " M 19 5 L 19 18 M 16 15 L 19 18.5 L 22 15");
        }

        Shape {
            x: 0;
            y: 0;
            ink: root.ink;
            commands: "M 8 6.5 L 10 6.5 L 10 10.5 L 8 10.5 Z";
        }
    }
    // Volume up and down, the microphone muted, the touch keyboard.
    if root.target == 40 || root.target == 41: Drawing {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        ink: root.ink;
        commands: root.speaker + (root.target == 40 ? " M 15 12 L 21 12 M 18 9 L 18 15" : " M 15 12 L 21 12");
    }
    if root.target == 42: Drawing {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        ink: root.ink;
        commands: "M 12 3 A 3 3 0 0 1 15 6 L 15 11 A 3 3 0 0 1 9 11 L 9 6 A 3 3 0 0 1 12 3 Z M 6 11 A 6 6 0 0 0 18 11 M 12 17 L 12 21 M 4 4 L 20 20";
    }
    if root.target == 43: Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 28px;
        height: 28px;
        name: "keyboard";
        stroke: root.ink;
        stroke-width: 1.8px;
    }
}

// One chip of the grid.
component TargetChip inherits Rectangle {
    in property <int> target;
    in property <string> own-key;
    in property <bool> applied;
    in property <bool> focused;
    callback clicked();
    width: 56px;
    height: 40px;
    border-radius: 10px;
    background: root.applied ? Theme.selected : Theme.surface-high;

    TargetIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        target: root.target;
        own-key: root.own-key;
        ink: root.focused || root.applied ? Theme.text : Theme.text.mix(Theme.dim, 0.6);
    }

    if root.applied: Rectangle {
        y: parent.height - 3px;
        height: 3px;
        background: Theme.accent;
    }
    if root.focused: Rectangle {
        border-radius: 10px;
        border-width: 2px;
        border-color: Theme.focus;
    }

    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// A group of chips on a row of the grid: its name, then its targets.
component TargetGroup inherits HorizontalLayout {
    in property <string> group;
    in property <length> label-width;
    in property <int> start;
    in property <int> count;
    in property <string> own-key;
    in property <int> applied;
    in property <int> current;
    in property <bool> active;
    callback pick(int);
    spacing: 6px;
    Text {
        width: root.label-width;
        text: root.group;
        color: Theme.dim;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }

    for c in root.count: TargetChip {
        target: root.start + c;
        own-key: root.own-key;
        applied: root.applied == root.start + c;
        focused: root.active && root.current == root.start + c;
        clicked => {
            root.pick(root.start + c);
        }
    }
}

// The targets in three rows: the button's own key and nothing, then the
// mouse and media; the gamepad; the keyboard. Arrows move (`move`); the
// page applies `current` and routes the keys here.
export component TargetGrid inherits VerticalLayout {
    in property <string> own-key;
    // The target applied now, and the one the focus is on.
    in property <int> applied;
    in-out property <int> current;
    in property <bool> active;
    callback pick(int);
    property <[int]> counts: [11, 17, 16];
    spacing: 6px;
    alignment: start;

    pure function row-of(i: int) -> int {
        i < 2 || i >= 35 ? 0 : i < 19 ? 1 : 2
    }
    pure function column-of(i: int) -> int {
        i < 2 ? i : i >= 35 ? i - 33 : i < 19 ? i - 2 : i - 19
    }
    pure function at(row: int, column: int) -> int {
        row == 0 ? (column < 2 ? column : column + 33) : row == 1 ? column + 2 : column + 19
    }
    // Arrows: across a row, or to the same column of the next row.
    public function move(dx: int, dy: int) {
        let row = root.row-of(root.current);
        let to = clamp(row + dy, 0, 2);
        root.current = root.at(to, clamp(root.column-of(root.current) + dx, 0, root.counts[to] - 1));
    }

    HorizontalLayout {
        spacing: 18px;
        alignment: start;
        TargetGroup {
            label-width: 92px;
            start: 0;
            count: 2;
            own-key: root.own-key;
            applied: root.applied;
            current: root.current;
            active: root.active;
            pick(i) => {
                root.current = i;
                root.pick(i);
            }
        }

        TargetGroup {
            group: @tr("Mouse");
            start: 35;
            count: 5;
            own-key: root.own-key;
            applied: root.applied;
            current: root.current;
            active: root.active;
            pick(i) => {
                root.current = i;
                root.pick(i);
            }
        }

        TargetGroup {
            group: @tr("Media");
            start: 40;
            count: 4;
            own-key: root.own-key;
            applied: root.applied;
            current: root.current;
            active: root.active;
            pick(i) => {
                root.current = i;
                root.pick(i);
            }
        }
    }

    TargetGroup {
        group: @tr("Gamepad");
        label-width: 92px;
        start: 2;
        count: 17;
        own-key: root.own-key;
        applied: root.applied;
        current: root.current;
        active: root.active;
        pick(i) => {
            root.current = i;
            root.pick(i);
        }
    }

    TargetGroup {
        group: @tr("Keyboard");
        label-width: 92px;
        start: 19;
        count: 16;
        own-key: root.own-key;
        applied: root.applied;
        current: root.current;
        active: root.active;
        pick(i) => {
            root.current = i;
            root.pick(i);
        }
    }
}
