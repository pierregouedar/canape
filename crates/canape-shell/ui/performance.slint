// Performance page: the live figures at the top, then two shelves of
// setting cards. Up and down change shelf, left and right change card; A
// opens the card's drawer (or the bench and the game profiles, which are
// pages of their own); X saves the settings for the game in the
// foreground. In a drawer, left and right change the value or pick a tile
// that A applies; B closes it. Cards:
//   shelf 0, power: mode, target, power range, on battery, temperature;
//   shelf 1, measures and screen: bench, screen, game profiles.

import { Theme } from "theme.slint";
import { App } from "state.slint";
import { Graph } from "widgets.slint";
import { ChoiceTile, Drawer, HeroFigure, HeroLine, HintSet, IconTile, PageHints, Ruler, Shelf, ShelfCard, ShelfPane, Shelves, Stepper } from "kit.slint";

// The power range on the model's scale, with what the APU draws now.
component PowerBar inherits Rectangle {
    in property <bool> two-knobs;
    in property <int> low;
    in property <int> high;
    // Which knob has the focus: 0 none, 1 low, 2 high.
    in property <int> active;
    property <int> floor: App.status.tdp-floor > 0 ? App.status.tdp-floor : 5;
    property <int> ceiling: App.status.tdp-ceiling > root.floor ? App.status.tdp-ceiling : 35;
    property <float> scale: 1 / (root.ceiling - root.floor);
    property <length> knob-low: self.width * clamp((root.low - root.floor) * root.scale, 0, 1);
    property <length> knob-high: self.width * clamp((root.high - root.floor) * root.scale, 0, 1);
    property <float> live: App.status.power-tenths / 10;
    property <bool> live-known: App.status.connected && App.status.power-tenths >= 0;
    property <length> live-x: self.width * clamp((root.live - root.floor) * root.scale, 0, 1);
    height: 46px;

    Rectangle {
        y: 21px;
        height: 4px;
        border-radius: 2px;
        background: Theme.surface-focus;
    }

    Rectangle {
        x: root.two-knobs ? root.knob-low : 0;
        y: 21px;
        width: root.two-knobs ? root.knob-high - root.knob-low : root.knob-high;
        height: 4px;
        border-radius: 2px;
        background: Theme.accent;
        animate x, width { duration: 160ms; easing: ease-out; }
    }

    if root.two-knobs: Rectangle {
        x: root.knob-low - self.width / 2;
        y: 23px - self.height / 2;
        width: root.active == 1 ? 24px : 20px;
        height: self.width;
        border-radius: self.width / 2;
        background: Theme.focus;
        border-width: root.active == 1 ? 4px : 0;
        border-color: Theme.accent.with-alpha(0.35);
        animate x { duration: 160ms; easing: ease-out; }
    }

    Rectangle {
        x: root.knob-high - self.width / 2;
        y: 23px - self.height / 2;
        width: root.active == 2 ? 24px : 20px;
        height: self.width;
        border-radius: self.width / 2;
        background: Theme.focus;
        border-width: root.active == 2 ? 4px : 0;
        border-color: Theme.accent.with-alpha(0.35);
        animate x { duration: 160ms; easing: ease-out; }
    }

    if root.live-known: Rectangle {
        x: root.live-x - 3px;
        y: 13px;
        width: 6px;
        height: 20px;
        border-radius: 3px;
        background: Theme.sheet;
        animate x { duration: 300ms; easing: ease-out; }
        Rectangle {
            x: 2px;
            y: 2px;
            width: 2px;
            height: 16px;
            border-radius: 1px;
            background: Theme.accent-line;
        }
    }
}

// The screen's refresh rates as tiles: left and right move, A applies.
// Shared with the hardware page.
export component RefreshTiles inherits HorizontalLayout {
    in property <int> focus-col;
    callback pick(int);
    spacing: 12px;
    alignment: start;
    for hz[i] in App.refresh-rates: ChoiceTile {
        width: 180px;
        label: @tr("{} Hz", hz);
        selected: App.refresh-hz == hz;
        focused: root.focus-col == i;
        clicked => {
            root.pick(i);
        }
    }
}

// The index of the current refresh rate in App.refresh-rates, -1 when
// unknown. Past the end, an array reads as 0.
export global Refresh {
    public pure function index(hz: int) -> int {
        hz <= 0 ? -1 : hz == App.refresh-rates[0] ? 0 : hz == App.refresh-rates[1] ? 1 : hz == App.refresh-rates[2] ? 2 : hz == App.refresh-rates[3] ? 3 : hz == App.refresh-rates[4] ? 4 : hz == App.refresh-rates[5] ? 5 : -1
    }
}

export component PerformancePage inherits Rectangle {
    // Opens the bench page, and the game profiles.
    callback open-bench();
    callback open-profiles();
    // The shelf in front and its focused card.
    in-out property <int> shelf: 0;
    in-out property <int> card: 0;
    // The card whose drawer is open, "" when none; `sheet` keeps the last
    // one so the drawer keeps its content while it closes.
    in-out property <string> drawer;
    property <string> sheet;
    in-out property <int> mode-col: root.mode-index >= 0 ? root.mode-index : 0;
    // In the range drawer: 0 the minimum, 1 the maximum.
    in-out property <int> range-knob: 0;
    in-out property <int> refresh-col: 0;

    property <bool> auto: App.status.auto-tdp;
    property <bool> manual: !root.auto && App.status.mode == "manual";
    // 0 silent, 1 performance, 2 turbo, 3 auto TDP.
    property <int> mode-index: root.auto ? 3 : App.status.mode == "silent" ? 0 : App.status.mode == "performance" ? 1 : App.status.mode == "turbo" ? 2 : -1;
    property <int> target-index: App.status.target-fps <= 30 ? 0 : App.status.target-fps <= 40 ? 1 : App.status.target-fps <= 45 ? 2 : App.status.target-fps <= 60 ? 3 : App.status.target-fps <= 90 ? 4 : 5;
    property <[int]> target-stops: [30, 40, 45, 60, 90, 120];
    property <[int]> battery-stops: [0, 10, 15, 20];
    property <int> battery-index: App.status.battery-cap <= 0 ? 0 : App.status.battery-cap <= 10 ? 1 : App.status.battery-cap <= 15 ? 2 : 3;
    property <[int]> temp-stops: [0, 80, 85, 90];
    property <int> temp-index: App.status.temp-limit <= 0 ? 0 : App.status.temp-limit <= 80 ? 1 : App.status.temp-limit <= 85 ? 2 : 3;
    property <bool> active: fs.has-focus;
    property <bool> open: root.drawer != "";
    property <string> focused-key: root.key(root.shelf, root.card);
    property <string> mode-text: root.auto ? @tr("Auto TDP") : App.mode-name(App.status.mode);
    property <string> profile-note: App.status.active-profile != "" ? @tr("{} · game profile", App.status.active-profile) : @tr("General settings");

    property <HintSet> hints: !root.open ? {
        move-glyph: "dpad",
        move: @tr("Shelves"),
        a: !root.usable(root.focused-key) ? "" : root.focused-key == "bench" || root.focused-key == "profiles" ? @tr("Open") : @tr("Adjust"),
        x: App.status.connected && App.status.foreground != "" ? @tr("Save for this game") : "",
        b: @tr("Back"),
    } : root.drawer == "mode" || root.drawer == "screen" ? {
        move-glyph: "leftright",
        move: @tr("Choose"),
        a: @tr("Apply"),
        x: App.status.connected && App.status.foreground != "" ? @tr("Save for this game") : "",
        b: @tr("Close"),
    } : {
        move-glyph: "leftright",
        move: @tr("Value"),
        y: root.drawer == "range" && !root.manual ? @tr("Minimum / maximum") : "",
        x: App.status.connected && App.status.foreground != "" ? @tr("Save for this game") : "",
        b: @tr("Close"),
    };
    init => {
        PageHints.current = self.hints;
    }
    changed hints => {
        PageHints.current = self.hints;
    }

    pure function key(s: int, c: int) -> string {
        s == 0 ? ["mode", "target", "range", "battery", "temp"][c] : ["bench", "screen", "profiles"][c]
    }
    pure function cards(s: int) -> int {
        s == 0 ? 5 : 3
    }
    // A card that A acts on now.
    pure function usable(k: string) -> bool {
        k == "bench" || k == "profiles" ? true : k == "screen" ? App.refresh-rates.length > 0 : !App.status.connected ? false : k == "target" ? root.auto : k == "range" ? root.auto || root.manual : true
    }
    function activate() {
        let k = root.focused-key;
        if !root.usable(k) {
            return;
        }
        if k == "bench" {
            root.open-bench();
        } else if k == "profiles" {
            root.open-profiles();
        } else {
            root.mode-col = root.mode-index >= 0 ? root.mode-index : root.mode-col;
            root.refresh-col = max(0, Refresh.index(App.refresh-hz));
            root.range-knob = 0;
            // Not `k` twice: a string local is moved by its first use.
            root.sheet = root.focused-key;
            root.drawer = root.focused-key;
        }
    }
    function pick-mode(i: int) {
        if i == 3 {
            if !root.auto {
                App.toggle-auto-tdp();
            }
        } else {
            App.set-mode(i == 0 ? "silent" : i == 1 ? "performance" : "turbo");
        }
    }
    // Left (-1) or right (1) in the open drawer.
    function side(d: int) {
        if root.drawer == "mode" {
            root.mode-col = clamp(root.mode-col + d, 0, 3);
        } else if root.drawer == "target" {
            App.set-target-fps(root.target-stops[clamp(root.target-index + d, 0, 5)]);
        } else if root.drawer == "range" {
            if root.manual {
                App.change-tdp(d);
            } else if root.range-knob == 0 {
                App.change-min-watts(d);
            } else {
                App.change-max-watts(d);
            }
        } else if root.drawer == "battery" {
            App.set-battery-cap(root.battery-stops[clamp(root.battery-index + d, 0, 3)]);
        } else if root.drawer == "temp" {
            App.set-temp-limit(root.temp-stops[clamp(root.temp-index + d, 0, 3)]);
        } else if root.drawer == "screen" {
            root.refresh-col = clamp(root.refresh-col + d, 0, App.refresh-rates.length - 1);
        }
    }
    // A in the open drawer: applies the tile, or closes a drawer whose
    // value is already applied.
    function apply() {
        if root.drawer == "mode" {
            root.pick-mode(root.mode-col);
        } else if root.drawer == "screen" {
            App.set-refresh(App.refresh-rates[root.refresh-col]);
        } else {
            root.drawer = "";
        }
    }
    // The drawer's card no longer applies (the mode changed): close it.
    changed auto => {
        if (root.drawer == "target" && !root.auto) || (root.drawer == "range" && !root.auto && !root.manual) {
            root.drawer = "";
        }
    }
    changed manual => {
        if root.drawer == "range" && !root.auto && !root.manual {
            root.drawer = "";
        }
    }

    fs := FocusScope {
        init => {
            self.focus();
        }
        key-pressed(event) => {
            // X: keep these settings for the game in the foreground.
            if (event.text == Key.F2 || event.text == "x") && App.status.connected {
                App.save-profile();
                return accept;
            }
            if root.open {
                if event.text == Key.Escape {
                    root.drawer = "";
                } else if event.text == Key.LeftArrow {
                    root.side(-1);
                } else if event.text == Key.RightArrow {
                    root.side(1);
                } else if event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.F3 || event.text == "y" {
                    root.range-knob = 1 - root.range-knob;
                } else if event.text == Key.Return || event.text == " " {
                    root.apply();
                }
                return accept;
            }
            if event.text == Key.UpArrow || event.text == Key.DownArrow {
                root.shelf = clamp(root.shelf + (event.text == Key.UpArrow ? -1 : 1), 0, 1);
                root.card = min(root.card, root.cards(root.shelf) - 1);
                return accept;
            }
            if event.text == Key.LeftArrow || event.text == Key.RightArrow {
                root.card = clamp(root.card + (event.text == Key.LeftArrow ? -1 : 1), 0, root.cards(root.shelf) - 1);
                return accept;
            }
            if event.text == Key.Return || event.text == " " {
                root.activate();
                return accept;
            }
            return reject;
        }
    }

    // Live: the game in front, the figures, the last minute of power.
    HeroLine {
        x: 48px;
        y: 36px;
        width: parent.width - 96px;
        title: App.status.game;
        detail: !App.status.connected ? @tr("Service not connected") : (App.status.game == "" ? @tr("General settings") : (App.status.active-profile != "" ? "· " + @tr("game profile") + " " : "") + "· " + root.mode-text);
    }

    HorizontalLayout {
        x: 48px;
        y: 68px;
        width: parent.width - 96px;
        height: 96px;
        spacing: 56px;
        HeroFigure {
            value: App.known(App.status.power-tenths, App.tenths(App.status.power-tenths));
            unit: @tr("W");
            warn: App.status.thermal-limited;
            note: App.status.thermal-limited ? @tr("Thermal limit reached") : App.status.tdp < 0 ? " " : App.learned-watts > 0 ? @tr("limit {} · {} learned", App.watts(App.status.tdp), App.watts(App.learned-watts)) : @tr("limit {}", App.watts(App.status.tdp));
        }

        HeroFigure {
            value: App.known(App.status.fps, App.status.fps);
            unit: "FPS";
            note: root.auto ? @tr("target {}", App.fps-value(App.status.target-fps)) : " ";
        }

        HeroFigure {
            value: App.known(App.status.temp, App.status.temp);
            unit: "°C";
            note: "CPU";
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        VerticalLayout {
            alignment: end;
            padding-bottom: 6px;
            Graph {
                width: 420px;
                height: 84px;
                line: App.graphs.power-line;
                area: "";
                reference: App.graphs.limit-line;
                tint: Theme.accent;
            }
        }
    }

    ShelfPane {
        x: 0;
        y: 256px;
        width: parent.width;
        height: 330px;
        front: root.shelf;

        Shelf {
            x: 48px;
            width: parent.width - 48px;
            index: 0;
            front: root.shelf;
            icon: "turbo";
            title: @tr("Power");
            ShelfCard {
                label: @tr("Mode");
                icon: "dial";
                value: App.status.connected ? (root.mode-text != "" ? root.mode-text : "—") : "—";
                enabled: root.usable("mode");
                focused: root.active && root.shelf == 0 && root.card == 0;
                clicked => {
                    root.shelf = 0;
                    root.card = 0;
                    root.activate();
                    fs.focus();
                }
            }

            ShelfCard {
                label: @tr("Target");
                icon: "target";
                value: App.status.connected ? App.fps-value(App.status.target-fps) : "—";
                enabled: root.usable("target");
                focused: root.active && root.shelf == 0 && root.card == 1;
                clicked => {
                    root.shelf = 0;
                    root.card = 1;
                    root.activate();
                    fs.focus();
                }
            }

            ShelfCard {
                label: root.manual ? @tr("Power limit") : @tr("Power range");
                icon: "range";
                value: !App.status.connected ? "—" : root.manual ? App.known(App.status.tdp, App.watts(App.status.tdp)) : root.auto ? App.status.min-watts + " – " + App.watts(App.status.max-watts) : "—";
                enabled: root.usable("range");
                focused: root.active && root.shelf == 0 && root.card == 2;
                clicked => {
                    root.shelf = 0;
                    root.card = 2;
                    root.activate();
                    fs.focus();
                }
            }

            ShelfCard {
                label: @tr("On battery");
                icon: "battery";
                value: !App.status.connected ? "—" : App.status.battery-cap == 0 ? @tr("None") : @tr("{} max", App.watts(App.status.battery-cap));
                enabled: root.usable("battery");
                focused: root.active && root.shelf == 0 && root.card == 3;
                clicked => {
                    root.shelf = 0;
                    root.card = 3;
                    root.activate();
                    fs.focus();
                }
            }

            ShelfCard {
                label: @tr("Temperature");
                icon: "thermo";
                value: !App.status.connected ? "—" : App.status.temp-limit == 0 ? @tr("None") : @tr("{} max", App.celsius(App.status.temp-limit));
                enabled: root.usable("temp");
                focused: root.active && root.shelf == 0 && root.card == 4;
                clicked => {
                    root.shelf = 0;
                    root.card = 4;
                    root.activate();
                    fs.focus();
                }
            }
        }

        Shelf {
            x: 48px;
            width: parent.width - 48px;
            index: 1;
            front: root.shelf;
            icon: "bench";
            title: @tr("Measures and screen");
            ShelfCard {
                label: @tr("Bench");
                icon: "bench";
                value: App.status.bench-running ? @tr("{} left", App.duration(App.status.bench-seconds-left)) : @tr("Start · {}", App.duration(App.bench-duration(3, 15)));
                focused: root.active && root.shelf == 1 && root.card == 0;
                clicked => {
                    root.shelf = 1;
                    root.card = 0;
                    root.activate();
                    fs.focus();
                }
            }

            ShelfCard {
                label: @tr("Screen");
                icon: "screen";
                value: App.refresh-hz > 0 ? @tr("{} Hz", App.refresh-hz) : "—";
                enabled: root.usable("screen");
                focused: root.active && root.shelf == 1 && root.card == 1;
                clicked => {
                    root.shelf = 1;
                    root.card = 1;
                    root.activate();
                    fs.focus();
                }
            }

            ShelfCard {
                label: @tr("Game profiles");
                icon: "profiles";
                value: App.profiles.length;
                focused: root.active && root.shelf == 1 && root.card == 2;
                clicked => {
                    root.shelf = 1;
                    root.card = 2;
                    root.activate();
                    fs.focus();
                }
            }
        }
    }

    Drawer {
        width: parent.width;
        page-height: parent.height;
        open: root.open;
        sheet-height: root.sheet == "mode" ? 226px : root.sheet == "range" ? 212px : 200px;
        title: root.sheet == "mode" ? @tr("Mode") : root.sheet == "target" ? @tr("Target") : root.sheet == "range" ? (root.manual ? @tr("Power limit") : @tr("Power range")) : root.sheet == "battery" ? @tr("On battery") : root.sheet == "temp" ? @tr("Temperature") : @tr("Screen");
        note: root.sheet == "mode" ? root.profile-note
            : root.sheet == "target" ? App.known(App.status.fps, @tr("{} now", App.fps-value(App.status.fps)))
            : root.sheet == "range" ? App.known(App.status.power-tenths, App.learned-watts > 0 ? @tr("{} now · {} learned", App.watts-tenths(App.status.power-tenths), App.watts(App.learned-watts)) : @tr("{} now", App.watts-tenths(App.status.power-tenths)))
            : root.sheet == "temp" ? App.known(App.status.temp, @tr("{} now", App.celsius(App.status.temp)))
            : "";

        if root.sheet == "mode": HorizontalLayout {
            spacing: 12px;
            for icon[i] in ["silent", "balanced", "turbo", "auto"]: IconTile {
                horizontal-stretch: 1;
                preferred-width: 10px;
                icon: icon;
                label: i == 0 ? App.mode-name("silent") : i == 1 ? App.mode-name("performance") : i == 2 ? App.mode-name("turbo") : @tr("Auto TDP");
                selected: root.mode-index == i;
                focused: root.active && root.mode-col == i;
                clicked => {
                    root.mode-col = i;
                    root.pick-mode(i);
                    fs.focus();
                }
            }
        }

        if root.sheet == "target": Ruler {
            y: 4px;
            labels: [App.fps-value(30), App.fps-value(40), App.fps-value(45), App.fps-value(60), App.fps-value(90), App.fps-value(120)];
            selected: root.target-index;
            pick(i) => {
                App.set-target-fps(root.target-stops[i]);
                fs.focus();
            }
        }

        if root.sheet == "range": HorizontalLayout {
            y: 4px;
            height: 46px;
            spacing: 18px;
            if !root.manual: Stepper {
                width: 112px;
                value: App.watts(App.status.min-watts);
                active: root.active && root.range-knob == 0;
                step(d) => {
                    root.range-knob = 0;
                    App.change-min-watts(d);
                    fs.focus();
                }
            }
            PowerBar {
                horizontal-stretch: 1;
                two-knobs: !root.manual;
                low: App.status.min-watts;
                high: root.manual ? max(App.status.tdp, 0) : App.status.max-watts;
                active: !root.active ? 0 : root.manual ? 2 : root.range-knob + 1;
            }

            Stepper {
                width: 112px;
                value: root.manual ? App.known(App.status.tdp, App.watts(App.status.tdp)) : App.watts(App.status.max-watts);
                active: root.active && (root.manual || root.range-knob == 1);
                step(d) => {
                    if root.manual {
                        App.change-tdp(d);
                    } else {
                        root.range-knob = 1;
                        App.change-max-watts(d);
                    }
                    fs.focus();
                }
            }
        }

        if root.sheet == "battery": Ruler {
            y: 4px;
            labels: [@tr("None"), App.watts(10), App.watts(15), App.watts(20)];
            selected: root.battery-index;
            pick(i) => {
                App.set-battery-cap(root.battery-stops[i]);
                fs.focus();
            }
        }

        if root.sheet == "temp": Ruler {
            y: 4px;
            labels: [@tr("None"), App.celsius(80), App.celsius(85), App.celsius(90)];
            selected: root.temp-index;
            pick(i) => {
                App.set-temp-limit(root.temp-stops[i]);
                fs.focus();
            }
        }

        if root.sheet == "screen": RefreshTiles {
            height: 56px;
            focus-col: root.active ? root.refresh-col : -1;
            pick(i) => {
                root.refresh-col = i;
                App.set-refresh(App.refresh-rates[i]);
                fs.focus();
            }
        }
    }
}
