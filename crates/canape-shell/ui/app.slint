// Canapé home screen: the logo, four sections, a status strip, the current
// page, and the gamepad hints. LB / RB arrive as PageUp / PageDown (see
// nav.rs) and move between sections; B (Escape) leaves a sub-page, else
// goes back to the games. Every user-visible string goes through @tr:
// catalogs in lang/<code>/LC_MESSAGES/canape-shell.po.

import { Theme } from "theme.slint";
import { App, Notice } from "state.slint";
import { BatteryIcon, Bolt, Hint, Logo } from "widgets.slint";
import { BenchPage, ProfilesPage } from "pages.slint";
import { SettingsPage } from "settings.slint";
import { PerformancePage } from "performance.slint";
import { Library, LibraryPage } from "library.slint";
import { HardwarePage } from "hardware.slint";

export { App, Notice, StatusView, GraphView, ProfileView, BenchRow, RecView, BenchView } from "state.slint";
export { Theme } from "theme.slint";
export { Library, GameView } from "library.slint";

// A section name; the current one is brighter and underlined.
component Section inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();
    width: text.preferred-width;

    text := Text {
        text: root.label;
        color: root.selected ? Theme.focus : ta.has-hover ? Theme.text : Theme.dim;
        font-size: 16px;
        font-weight: root.selected ? 600 : 500;
        vertical-alignment: center;
    }

    if root.selected: Rectangle {
        y: parent.height - 2px;
        height: 2px;
        border-radius: 1px;
        background: Theme.accent;
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// A live value in the status strip: the number, then its unit.
component Reading inherits HorizontalLayout {
    in property <string> value;
    in property <string> unit;
    horizontal-stretch: 0;
    spacing: 4px;
    Text {
        text: root.value;
        color: Theme.text;
        font-size: 14px;
        font-weight: 600;
        vertical-alignment: center;
    }

    Text {
        text: root.unit;
        color: Theme.text.mix(Theme.dim, 0.6);
        font-size: 14px;
        vertical-alignment: center;
    }
}

export component AppWindow inherits Window {
    title: "Canapé";
    background: Theme.background;
    // The Ally's 1080p panel at 150 % scaling: 1280x720 logical pixels.
    preferred-width: 1280px;
    preferred-height: 720px;

    // Sections 0 Games, 1 Performance, 2 Hardware, 3 Settings; then the
    // sub-pages 4 Profiles (from Settings) and 5 Bench (from Performance).
    in-out property <int> page: 0;
    property <int> section: root.page == 4 ? 3 : root.page == 5 ? 1 : root.page;
    changed page => {
        Library.shown(root.page == 0);
        // Every page but the library moves with the arrow keys; the
        // library tells the gamepad itself, from its shelf's focus.
        App.arrow-focus(root.page >= 1);
    }

    // A command's outcome fades after a while; a later command replaces it.
    Timer {
        interval: 10s;
        running: App.notice != Notice.idle;
        triggered => {
            App.notice = Notice.idle;
        }
    }

    FocusScope {
        // Only sees the keys the focused control did not take.
        focus-on-click: false;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if event.text == Key.PageUp {
                root.page = Math.mod(root.section + 3, 4);
                return accept;
            }
            if event.text == Key.PageDown {
                root.page = Math.mod(root.section + 1, 4);
                return accept;
            }
            if event.text == Key.Escape && root.page != 0 {
                root.page = root.page == 4 ? 3 : root.page == 5 ? 1 : 0;
                return accept;
            }
            return reject;
        }

        // The selected game's colour behind the library, fading out
        // towards the shelves.
        if root.page == 0: Rectangle {
            Image {
                width: 100%;
                height: 100%;
                source: Library.backdrop;
                image-fit: fill;
            }

            Rectangle {
                background: @linear-gradient(180deg, Theme.background.with-alpha(0) 0%, Theme.background.with-alpha(0.55) 52%, Theme.background 78%);
            }
        }

        VerticalLayout {
            HorizontalLayout {
                padding-left: 48px;
                padding-right: 48px;
                padding-top: 24px;
                height: 64px;
                spacing: 40px;

                HorizontalLayout {
                    horizontal-stretch: 0;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Logo { }
                    }

                    Text {
                        text: "Canapé";
                        color: Theme.text;
                        font-size: 18px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: 28px;
                    alignment: start;
                    for label[i] in [@tr("Games"), @tr("Performance"), @tr("Hardware"), @tr("Settings")]: Section {
                        label: label;
                        selected: root.section == i;
                        clicked => {
                            root.page = i;
                        }
                    }
                }

                HorizontalLayout {
                    horizontal-stretch: 0;
                    spacing: 18px;
                    if App.status.connected && App.status.power-tenths >= 0: Reading {
                        value: Math.round(App.status.power-tenths / 10);
                        unit: @tr("W");
                    }
                    if App.status.connected && App.status.fps >= 0: Reading {
                        value: App.status.fps;
                        unit: "FPS";
                    }
                    if App.status.connected && App.status.battery >= 0: HorizontalLayout {
                        spacing: 6px;
                        if App.status.power-known && !App.status.on-battery: VerticalLayout {
                            alignment: center;
                            Bolt { }
                        }
                        VerticalLayout {
                            alignment: center;
                            BatteryIcon {
                                percent: App.status.battery;
                                charging: App.status.power-known && !App.status.on-battery;
                            }
                        }

                        Reading {
                            value: App.status.battery;
                            unit: "%";
                        }
                    }
                    if !App.status.connected: Text {
                        text: @tr("Offline");
                        color: Theme.warn;
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Text {
                        text: App.clock;
                        color: Theme.dim;
                        font-size: 14px;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                // Runs under the hints: the next shelf peeks in at the bottom.
                if root.page == 0: LibraryPage {
                    x: 48px;
                    y: 20px;
                    width: parent.width - 96px;
                    height: parent.height + 34px;
                }
                if root.page == 1: PerformancePage {
                    x: 32px;
                    y: 28px;
                    width: parent.width - 80px;
                    height: parent.height - 28px;
                    open-bench => {
                        root.page = 5;
                    }
                }
                if root.page == 2: HardwarePage {
                    x: 32px;
                    y: 28px;
                    width: parent.width - 80px;
                    height: parent.height - 28px;
                }
                if root.page == 3: SettingsPage {
                    x: 32px;
                    y: 28px;
                    width: parent.width - 80px;
                    height: parent.height - 28px;
                    open-profiles => {
                        root.page = 4;
                    }
                }
                if root.page == 4: ProfilesPage {
                    x: 32px;
                    y: 28px;
                    width: parent.width - 80px;
                    height: parent.height - 28px;
                }
                if root.page == 5: BenchPage {
                    x: 32px;
                    y: 28px;
                    width: parent.width - 80px;
                    height: parent.height - 28px;
                }
            }

            HorizontalLayout {
                padding-left: 48px;
                padding-right: 48px;
                padding-bottom: 16px;
                height: 54px;
                spacing: 24px;

                Text {
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    overflow: elide;
                    font-size: 13px;
                    text: !App.status.connected ? @tr("Service not connected: start canape-service.") : App.notice == Notice.unreachable ? @tr("Service unreachable") : App.notice == Notice.service-error ? @tr("Service error: {}", App.notice-detail) : App.notice == Notice.saved ? @tr("Profile saved") : App.status.conflicts != "" ? @tr("Also driving the hardware: {}. Close it to avoid conflicts.", App.status.conflicts) : "";
                    color: App.notice == Notice.saved && App.status.connected ? Theme.good : Theme.warn;
                }

                if root.page >= 1: Hint {
                    glyph: "updown";
                    text: @tr("Setting");
                }
                if root.page >= 1 && root.page != 4: Hint {
                    glyph: "leftright";
                    text: @tr("Value");
                }
                Hint {
                    glyph: "A";
                    text: root.page == 0 ? (Library.mode == 1 ? @tr("Install") : @tr("Play")) : @tr("Choose");
                }

                if root.page == 1 || root.page == 2 || root.page == 5: Hint {
                    glyph: "X";
                    text: @tr("Save for this game");
                }
                if root.page == 4: Hint {
                    glyph: "X";
                    text: @tr("Delete");
                }
                if root.page != 0: Hint {
                    glyph: "B";
                    text: @tr("Back");
                }
                Hint {
                    glyph: "LB RB";
                    text: @tr("Sections");
                }
            }
        }
    }
}
