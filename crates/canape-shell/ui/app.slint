// Canapé home screen: the logo, four sections, a status strip, the current
// page, and the gamepad hints. LB / RB arrive as PageUp / PageDown (see
// nav.rs) and move between sections; B (Escape) leaves a sub-page, else
// goes back to the games. Every user-visible string goes through @tr:
// catalogs in lang/<code>/LC_MESSAGES/canape-shell.po.

import { Theme } from "theme.slint";
import { App, Notice } from "state.slint";
import { BatteryIcon, Bolt, Hint, Logo } from "widgets.slint";
import { AddGamesPage, BenchPage, HiddenGamesPage, ProfilesPage } from "pages.slint";
import { SettingsPage } from "settings.slint";
import { PerformancePage } from "performance.slint";
import { GameView, Library, LibraryPage } from "library.slint";
import { HardwarePage } from "hardware.slint";
import { PageHints, Reveal } from "kit.slint";
import { Onboarding, OnboardingFlow } from "onboarding.slint";
import { TweaksPage } from "tweaks.slint";

// Plus Jakarta Sans, embedded (OFL, see fonts/OFL.txt). Scripts it lacks,
// such as Cyrillic or CJK, fall back to the system fonts.
import "fonts/PlusJakartaSans-Regular.ttf";
import "fonts/PlusJakartaSans-Medium.ttf";
import "fonts/PlusJakartaSans-SemiBold.ttf";
import "fonts/PlusJakartaSans-Bold.ttf";

export { App, Notice, StatusView, GraphView, ProfileView, BenchRow, RecView, BenchView } from "state.slint";
export { Theme } from "theme.slint";
export { Onboarding } from "onboarding.slint";
export { Tweaks, TweakRow } from "tweaks.slint";
export { Library, GameView, ShelfView, DetailView, AddGameView, AchievementView, OptionsView, CategoryView, HiddenGameView } from "library.slint";

// A section name; the current one is brighter and underlined.
component Section inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();
    width: text.preferred-width;

    text := Text {
        text: root.label;
        color: root.selected ? Theme.focus : ta.has-hover ? Theme.text : Theme.dim;
        animate color { duration: 160ms; }
        font-size: 16px;
        font-weight: root.selected ? 600 : 500;
        vertical-alignment: center;
    }

    // Grows from the middle when the section is picked.
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 2px;
        width: root.selected ? parent.width : 0;
        height: 2px;
        border-radius: 1px;
        background: Theme.accent;
        animate width { duration: 220ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// A live value in the status strip: the number, then its unit.
component Reading inherits HorizontalLayout {
    in property <string> value;
    in property <string> unit;
    horizontal-stretch: 0;
    spacing: 4px;
    Text {
        text: root.value;
        color: Theme.text;
        font-size: 14px;
        font-weight: 600;
        vertical-alignment: center;
    }

    Text {
        text: root.unit;
        color: Theme.text.mix(Theme.dim, 0.6);
        font-size: 14px;
        vertical-alignment: center;
    }
}

export component AppWindow inherits Window {
    title: "Canapé";
    background: Theme.background;
    default-font-family: "Plus Jakarta Sans";
    // The Ally's 1080p panel at 150 % scaling: 1280x720 logical pixels.
    preferred-width: 1280px;
    preferred-height: 720px;

    // Sections 0 Games, 1 Performance, 2 Hardware, 3 Settings; then the
    // sub-pages 4 Profiles (from Performance or Settings), 5 Bench (from
    // Performance), 6 Add a game (from Settings), 7 Hidden games (from Add a
    // game), 8 Windows tweaks (from Settings).
    in-out property <int> page: 0;
    property <int> section: root.section-of(root.page);
    // The selected game on the shelf in front, for the hints.
    property <int> front-games: Library.shelves[Library.shelf].games.length;
    property <GameView> front-game: Library.shelves[Library.shelf].games[Library.selected];
    // Where the next page slides in from: the side it comes from in the
    // section order, below for a sub-page, above when leaving one.
    property <length> enter-x;
    property <length> enter-y;

    // The shelf and card each section page had: coming back from a
    // sub-page keeps them.
    property <int> performance-shelf: 0;
    property <int> performance-card: 0;
    property <int> hardware-shelf: 0;
    property <int> hardware-card: 0;
    property <int> settings-shelf: 0;
    property <int> settings-card: 0;
    // The section the game profiles were opened from: Performance or
    // Settings.
    property <int> profiles-from: 3;
    // Sections 1 to 3 are shelves of setting cards: their hints come from
    // the page (PageHints).
    property <bool> shelf-page: root.page >= 1 && root.page <= 3;
    pure function section-of(page: int) -> int {
        page == 4 ? root.profiles-from : page == 6 || page == 7 || page == 8 ? 3 : page == 5 ? 1 : page
    }
    function go(page: int) {
        if page == 4 && root.page != 4 {
            root.profiles-from = root.section;
        }
        let to-section = root.section-of(page);
        root.enter-x = to-section > root.section ? 32px : to-section < root.section ? -32px : 0;
        root.enter-y = page >= 4 ? 24px : root.page >= 4 && to-section == root.section ? -24px : 0;
        root.page = page;
    }
    changed page => {
        if Library.detail && root.page != 0 {
            Library.close-detail();
        }
        Library.shown(root.page == 0);
        // Every page but the library moves with the arrow keys; the
        // library tells the gamepad itself, from its shelf's focus.
        App.arrow-focus(root.page >= 1);
    }

    // A command's outcome fades after a while; a later command replaces it.
    Timer {
        interval: 10s;
        running: App.notice != Notice.idle;
        triggered => {
            App.notice = Notice.idle;
        }
    }

    FocusScope {
        // Only sees the keys the focused control did not take.
        focus-on-click: false;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if event.text == Key.PageUp {
                root.go(Math.mod(root.section + 3, 4));
                return accept;
            }
            if event.text == Key.PageDown {
                root.go(Math.mod(root.section + 1, 4));
                return accept;
            }
            if event.text == Key.Escape && root.page != 0 {
                root.go(root.page == 7 ? 6 : root.page >= 4 ? root.section-of(root.page) : 0);
                return accept;
            }
            return reject;
        }

        // The selected game's colour behind the library, fading out
        // towards the shelves: drawn by library.rs at the window's size, so
        // it is copied, never scaled.
        Rectangle {
            opacity: root.page == 0 ? 1 : 0;
            visible: self.opacity > 0;
            animate opacity { duration: Theme.motion(220ms); }

            Image {
                x: Library.backdrop-x * 1phx;
                y: 0;
                width: self.source.width * 1phx;
                height: self.source.height * 1phx;
                source: Library.backdrop-a;
            }

            Image {
                x: Library.backdrop-x * 1phx;
                y: 0;
                width: self.source.width * 1phx;
                height: self.source.height * 1phx;
                source: Library.backdrop-b;
                opacity: Library.backdrop-b-front ? 1 : 0;
                visible: self.opacity > 0;
                animate opacity { duration: Theme.motion(240ms); easing: ease-in-out; }
            }

            // The game page's wide art, over the glow; gone below the fold.
            Image {
                x: 0;
                y: 0;
                width: self.source.width * 1phx;
                height: self.source.height * 1phx;
                source: Library.detail-art;
                opacity: Library.detail && Library.detail-part == 0 && Library.detail-art.width > 0 ? 1 : 0;
                visible: self.opacity > 0;
                animate opacity { duration: Theme.motion(300ms); easing: ease-out; }
            }
        }

        // The first-run tour takes the place of the sections.
        if !Onboarding.active: VerticalLayout {
            HorizontalLayout {
                padding-left: 48px;
                padding-right: 48px;
                padding-top: 24px;
                height: 64px;
                spacing: 40px;

                HorizontalLayout {
                    horizontal-stretch: 0;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Logo { }
                    }

                    Text {
                        text: "Canapé";
                        color: Theme.text;
                        font-size: 18px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: 28px;
                    alignment: start;
                    for label[i] in [@tr("Games"), @tr("Performance"), @tr("Hardware"), @tr("Settings")]: Section {
                        label: label;
                        selected: root.section == i;
                        clicked => {
                            root.go(i);
                        }
                    }
                }

                HorizontalLayout {
                    horizontal-stretch: 0;
                    spacing: 18px;
                    if App.status.connected && App.status.power-tenths >= 0: Reading {
                        value: Math.round(App.status.power-tenths / 10);
                        unit: @tr("W");
                    }
                    if App.status.connected && App.status.fps >= 0: Reading {
                        value: App.status.fps;
                        unit: "FPS";
                    }
                    if App.status.connected && App.status.battery >= 0: HorizontalLayout {
                        spacing: 6px;
                        if App.status.power-known && !App.status.on-battery: VerticalLayout {
                            alignment: center;
                            Bolt { }
                        }
                        VerticalLayout {
                            alignment: center;
                            BatteryIcon {
                                percent: App.status.battery;
                                charging: App.status.power-known && !App.status.on-battery;
                            }
                        }

                        Reading {
                            value: App.status.battery;
                            unit: "%";
                        }
                    }
                    if !App.status.connected: Text {
                        text: @tr("Offline");
                        color: Theme.warn;
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Text {
                        text: App.clock;
                        color: Theme.dim;
                        font-size: 14px;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                // Runs under the hints: the next shelf peeks in at the bottom.
                if root.page == 0: Reveal {
                    x: 48px;
                    y: 20px;
                    width: parent.width - 96px;
                    height: parent.height + 34px;
                    from-x: root.enter-x;
                    from-y: root.enter-y;
                    LibraryPage { }
                }
                // The next shelf fades out under the hints.
                if root.page == 0: Rectangle {
                    y: parent.height - 48px;
                    height: 48px + 54px;
                    background: @linear-gradient(180deg, Theme.background.with-alpha(0) 0%, Theme.background.with-alpha(0.75) 50%, Theme.background.with-alpha(0.92) 100%);
                }
                // Shelf pages run under the hints: their drawers rise from
                // the bottom of the window.
                if root.page == 1: Reveal {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height + 54px;
                    from-x: root.enter-x;
                    from-y: root.enter-y;
                    PerformancePage {
                        width: parent.width;
                        height: parent.height;
                        shelf <=> root.performance-shelf;
                        card <=> root.performance-card;
                        open-bench => {
                            root.go(5);
                        }
                        open-profiles => {
                            root.go(4);
                        }
                    }
                }
                if root.page == 2: Reveal {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height + 54px;
                    from-x: root.enter-x;
                    from-y: root.enter-y;
                    HardwarePage {
                        width: parent.width;
                        height: parent.height;
                        shelf <=> root.hardware-shelf;
                        card <=> root.hardware-card;
                    }
                }
                if root.page == 3: Reveal {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height + 54px;
                    from-x: root.enter-x;
                    from-y: root.enter-y;
                    SettingsPage {
                        width: parent.width;
                        height: parent.height;
                        shelf <=> root.settings-shelf;
                        card <=> root.settings-card;
                        open-profiles => {
                            root.go(4);
                        }
                        open-add-games => {
                            root.go(6);
                        }
                        open-tweaks => {
                            root.go(8);
                        }
                    }
                }
                if root.page == 4: Reveal {
                    x: 32px;
                    y: 28px;
                    width: parent.width - 80px;
                    height: parent.height - 28px;
                    from-x: root.enter-x;
                    from-y: root.enter-y;
                    ProfilesPage { }
                }
                if root.page == 5: Reveal {
                    x: 32px;
                    y: 28px;
                    width: parent.width - 80px;
                    height: parent.height - 28px;
                    from-x: root.enter-x;
                    from-y: root.enter-y;
                    BenchPage { }
                }
                if root.page == 6: Reveal {
                    x: 32px;
                    y: 28px;
                    width: parent.width - 80px;
                    height: parent.height - 28px;
                    from-x: root.enter-x;
                    from-y: root.enter-y;
                    AddGamesPage {
                        open-hidden => {
                            root.go(7);
                        }
                    }
                }
                if root.page == 7: Reveal {
                    x: 32px;
                    y: 28px;
                    width: parent.width - 80px;
                    height: parent.height - 28px;
                    from-x: root.enter-x;
                    from-y: root.enter-y;
                    HiddenGamesPage { }
                }
                if root.page == 8: Reveal {
                    x: 32px;
                    y: 28px;
                    width: parent.width - 80px;
                    height: parent.height - 28px;
                    from-x: root.enter-x;
                    from-y: root.enter-y;
                    TweaksPage { }
                }
            }

            HorizontalLayout {
                padding-left: 48px;
                padding-right: 48px;
                padding-bottom: 16px;
                height: 54px;
                spacing: 24px;

                Text {
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    overflow: elide;
                    font-size: 13px;
                    text: !App.status.connected ? @tr("Service not connected: start canape-service.") : App.notice == Notice.unreachable ? @tr("Service unreachable") : App.notice == Notice.service-error ? @tr("Service error: {}", App.notice-detail) : App.notice == Notice.saved ? @tr("Profile saved") : App.status.conflicts != "" ? @tr("Also driving the hardware: {}. Close it to avoid conflicts.", App.status.conflicts) : "";
                    color: App.notice == Notice.saved && App.status.connected ? Theme.good : Theme.warn;
                }

                if root.page == 0 && !Library.detail && Library.shelves.length > 1: Hint {
                    glyph: "updown";
                    text: @tr("Shelves");
                }
                if root.shelf-page && PageHints.current.move != "": Hint {
                    glyph: PageHints.current.move-glyph;
                    text: PageHints.current.move;
                }
                if root.shelf-page && PageHints.current.move2 != "": Hint {
                    glyph: PageHints.current.move2-glyph;
                    text: PageHints.current.move2;
                }
                if root.shelf-page && PageHints.current.a != "": Hint {
                    glyph: "A";
                    text: PageHints.current.a;
                }
                if root.shelf-page && PageHints.current.y != "": Hint {
                    glyph: "Y";
                    text: PageHints.current.y;
                }
                if root.shelf-page && PageHints.current.x != "": Hint {
                    glyph: "X";
                    text: PageHints.current.x;
                }
                if root.shelf-page && PageHints.current.b != "": Hint {
                    glyph: "B";
                    text: PageHints.current.b;
                }
                if root.page >= 4: Hint {
                    glyph: "updown";
                    text: @tr("Setting");
                }
                if root.page == 5: Hint {
                    glyph: "leftright";
                    text: @tr("Value");
                }
                // The game page: Down shows what is below the fold, Up
                // goes back to the top.
                // The game page's options: up and down, A picks, B back.
                if root.page == 0 && Library.detail && Library.options && (Library.options-mode != 1 && Library.options-mode != 3): Hint {
                    glyph: "updown";
                    text: @tr("Setting");
                }
                if root.page == 0 && Library.detail && !Library.options && Library.detail-part == 0 && Library.detail-more: Hint {
                    glyph: "updown";
                    text: @tr("More");
                }
                if root.page == 0 && Library.detail && !Library.options && Library.detail-part == 1: Hint {
                    glyph: "updown";
                    text: @tr("Top");
                }
                if !root.shelf-page && (root.page != 0 || !Library.detail || Library.detail-part == 0): Hint {
                    glyph: "A";
                    text: root.page != 0 ? @tr("Choose") : !Library.detail ? (root.front-games > 0 ? @tr("Details") : @tr("Choose")) : Library.options ? (Library.options-mode == 1 || Library.options-mode == 3 ? @tr("Confirm") : @tr("Choose")) : root.front-game.installed ? @tr("Play") : @tr("Install");
                }
                if root.page == 0 && Library.detail && !Library.options && root.front-games > 0: Hint {
                    glyph: "Y";
                    text: @tr("Options");
                }

                if root.page == 5: Hint {
                    glyph: "X";
                    text: @tr("Save for this game");
                }
                if root.page == 4: Hint {
                    glyph: "X";
                    text: @tr("Delete");
                }
                if !root.shelf-page && (root.page != 0 || Library.detail): Hint {
                    glyph: "B";
                    text: @tr("Back");
                }
                Hint {
                    glyph: "LB RB";
                    text: @tr("Sections");
                }
            }
        }

        if Onboarding.active: OnboardingFlow { }
    }
}
