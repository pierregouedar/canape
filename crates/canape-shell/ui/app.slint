// Canapé home screen: a tab bar, the current page, and the gamepad hints.
// LB / RB arrive as PageUp / PageDown (see nav.rs) and switch pages; B
// (Escape) goes back to Home. Every user-visible string goes through @tr:
// catalogs in lang/<code>/LC_MESSAGES/canape-shell.po.

import { Theme } from "theme.slint";
import { App, Notice } from "state.slint";
import { BatteryIcon, Bolt, Hint, Logo, PadGlyph } from "widgets.slint";
import { BenchPage, HomePage, PerformancePage, ProfilesPage, SettingsPage } from "pages.slint";

export { App, Notice, StatusView, GraphView, ProfileView, BenchRow, RecView, BenchView } from "state.slint";
export { Theme } from "theme.slint";

// A page name; the current one is bright with an accent underline.
component Tab inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();
    height: 44px;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text {
            text: root.label;
            color: root.selected ? Theme.text : ta.has-hover ? Theme.text.with-alpha(0.85) : Theme.dim;
            font-size: Theme.font-body;
            font-weight: root.selected ? 700 : 500;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    Rectangle {
        x: 14px;
        y: parent.height - 3px;
        width: parent.width - 28px;
        height: 3px;
        border-radius: 1.5px;
        background: root.selected ? Theme.accent : transparent;
        animate background { duration: 120ms; }
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component AppWindow inherits Window {
    title: "Canapé";
    background: Theme.background;
    // The Ally's 1080p panel at 150 % scaling: 1280x720 logical pixels.
    preferred-width: 1280px;
    preferred-height: 720px;

    // 0 Home, 1 Performance, 2 Profiles, 3 Bench, 4 Settings.
    in-out property <int> page: 0;
    property <int> pages: 5;

    FocusScope {
        // Only sees the keys the focused control did not take.
        focus-on-click: false;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if event.text == Key.PageUp {
                root.page = Math.mod(root.page + root.pages - 1, root.pages);
                return accept;
            }
            if event.text == Key.PageDown {
                root.page = Math.mod(root.page + 1, root.pages);
                return accept;
            }
            if event.text == Key.Escape && root.page != 0 {
                root.page = 0;
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            padding-left: 40px;
            padding-right: 40px;
            padding-top: 16px;
            padding-bottom: 10px;
            spacing: 16px;

            HorizontalLayout {
                height: 52px;
                spacing: 14px;

                // Both sides share what the tabs leave, so the tabs stay centred.
                HorizontalLayout {
                    spacing: 10px;
                    min-width: 0;
                    preferred-width: 200px;
                    horizontal-stretch: 1;
                    VerticalLayout {
                        alignment: center;
                        Logo {
                            size: 34px;
                        }
                    }

                    Text {
                        text: "Canapé";
                        color: Theme.text;
                        font-size: 26px;
                        font-weight: 800;
                        vertical-alignment: center;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    PadGlyph {
                        text: "LB";
                        round: false;
                    }
                }

                HorizontalLayout {
                    spacing: 2px;
                    for label[i] in [@tr("Home"), @tr("Performance"), @tr("Profiles"), @tr("Bench"), @tr("Settings")]: VerticalLayout {
                        alignment: center;
                        Tab {
                            label: label;
                            selected: root.page == i;
                            clicked => {
                                root.page = i;
                            }
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    PadGlyph {
                        text: "RB";
                        round: false;
                    }
                }

                HorizontalLayout {
                    min-width: 0;
                    preferred-width: 200px;
                    horizontal-stretch: 1;
                    spacing: 10px;
                    alignment: end;
                    if App.status.connected && App.status.battery >= 0: HorizontalLayout {
                        spacing: 8px;
                        if App.status.power-known && !App.status.on-battery: VerticalLayout {
                            alignment: center;
                            Bolt { }
                        }
                        VerticalLayout {
                            alignment: center;
                            BatteryIcon {
                                percent: App.status.battery;
                                charging: App.status.power-known && !App.status.on-battery;
                            }
                        }

                        Text {
                            text: App.percent(App.status.battery);
                            color: Theme.text;
                            font-size: Theme.font-body;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    if !App.status.connected: Text {
                        text: @tr("Offline");
                        color: Theme.warn;
                        font-size: Theme.font-small;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                if root.page == 0: HomePage { }
                if root.page == 1: PerformancePage { }
                if root.page == 2: ProfilesPage { }
                if root.page == 3: BenchPage { }
                if root.page == 4: SettingsPage { }
            }

            HorizontalLayout {
                height: 34px;
                spacing: 26px;
                Hint {
                    glyph: "A";
                    text: @tr("Select");
                }

                Hint {
                    glyph: "B";
                    text: @tr("Back");
                }

                Hint {
                    glyph: "LB RB";
                    round: false;
                    text: @tr("Change page");
                }

                Rectangle { }

                Text {
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    overflow: elide;
                    font-size: Theme.font-small;
                    text: !App.status.connected ? @tr("Service not connected: start canape-service.") : App.notice == Notice.unreachable ? @tr("Service unreachable") : App.notice == Notice.service-error ? @tr("Service error: {}", App.notice-detail) : App.notice == Notice.saved ? @tr("Profile saved") : "";
                    color: !App.status.connected || App.notice == Notice.unreachable || App.notice == Notice.service-error ? Theme.warn : Theme.good;
                }
            }
        }
    }
}
