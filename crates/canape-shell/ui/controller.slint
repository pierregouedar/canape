// Controller sub-page (from the hardware page): what the back buttons
// send on the left, the light of the stick rings on the right. Up and
// down change line. On M1 and M2, A opens the grid of targets
// (targets.slint), where A applies one (a single write) and B closes it.
// On brightness, effect and speed, left and right change the value shown
// and A applies it; leaving the line drops a choice not applied. A also
// restores the default buttons and picks a colour. Lines:
//   0 M1, 1 M2, 2 restore the default buttons, 3 ring brightness,
//   4 effect, 5 its speed (effects that move), 6 ring colour (effects
//   that show it). Up and down skip the lines that do not apply.

import { Theme } from "theme.slint";
import { App } from "state.slint";
import { Row, SectionTitle, SettingLine, Swatch } from "kit.slint";
import { TargetPicker } from "targets.slint";

// The accent colour as a ring rather than a disc: it follows the accent,
// so it must not look like the fixed colour it happens to match.
component AccentSwatch inherits Rectangle {
    in property <bool> selected;
    in property <bool> focused;
    callback clicked();
    width: 40px;
    height: 40px;
    border-radius: 20px;
    border-width: root.focused || root.selected ? 2px : 0;
    border-color: root.focused ? Theme.focus : Theme.text.mix(Theme.dim, 0.6);

    Rectangle {
        x: 7px;
        y: 7px;
        width: parent.width - 14px;
        height: parent.height - 14px;
        border-radius: self.width / 2;
        border-width: 5px;
        border-color: Theme.accent;
    }

    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component ControllerPage inherits Rectangle {
    in-out property <int> focus-row: 0;
    property <bool> active: fs.has-focus;
    // In the order of ButtonTarget::ALL (canape-core): StatusView.m1 and
    // m2 index it, and so does set-back-button.
    property <[string]> target-names: [
        @tr("Default"),
        @tr("Disabled"),
        "A",
        "B",
        "X",
        "Y",
        "LB",
        "RB",
        "LT",
        "RT",
        @tr("Left stick click"),
        @tr("Right stick click"),
        @tr("D-pad up"),
        @tr("D-pad down"),
        @tr("D-pad left"),
        @tr("D-pad right"),
        "View",
        "Menu",
        "Xbox",
        @tr("Esc key"),
        @tr("Enter key"),
        @tr("Space bar"),
        @tr("Tab key"),
        @tr("Backspace key"),
        @tr("Up arrow"),
        @tr("Down arrow"),
        @tr("Left arrow"),
        @tr("Right arrow"),
        @tr("Page up"),
        @tr("Page down"),
        @tr("Shift key"),
        @tr("Ctrl key"),
        @tr("Windows key"),
        "F11",
        "F12",
        @tr("Left click"),
        @tr("Right click"),
        @tr("Middle click"),
        @tr("Scroll up"),
        @tr("Scroll down"),
        @tr("Volume up"),
        @tr("Volume down"),
        @tr("Mute the microphone"),
        @tr("Touch keyboard"),
    ];
    // Ring colours: "" follows the accent, then white and the accent
    // presets of the settings page.
    property <[{ hex: string, color: color }]> colors: [
        { hex: "", color: Theme.accent },
        { hex: "#ffffff", color: #ffffff },
        { hex: "#ff3d5e", color: #ff3d5e },
        { hex: "#f97316", color: #f97316 },
        { hex: "#eab308", color: #eab308 },
        { hex: "#10b981", color: #10b981 },
        { hex: "#06b6d4", color: #06b6d4 },
        { hex: "#3b82f6", color: #3b82f6 },
        { hex: "#8b5cf6", color: #8b5cf6 },
        { hex: "#ec4899", color: #ec4899 },
    ];
    // Brightness line: 0 left to the controller, then off, low, medium,
    // high (levels 0 to 3).
    property <[string]> levels: [@tr("Default"), @tr("Off"), @tr("Low"), @tr("Medium"), @tr("High")];
    in-out property <int> level-pick: App.status.lighting-level + 1;
    property <int> level-status: App.status.lighting-level + 1;
    changed level-status => {
        root.level-pick = root.level-status;
    }
    // Effects, in the order of LightingEffect::ALL (canape-core), and
    // speeds, in the order of LightingSpeed::ALL.
    property <[string]> effect-names: [@tr("Steady"), @tr("Breathing"), @tr("Colour cycle"), @tr("Rainbow"), @tr("Strobe")];
    property <[string]> speed-names: [@tr("Slow"), @tr("Medium"), @tr("Fast")];
    in-out property <int> effect-pick: App.status.lighting-effect;
    in-out property <int> speed-pick: App.status.lighting-speed;
    changed effect-status => {
        root.effect-pick = root.effect-status;
    }
    changed speed-status => {
        root.speed-pick = root.speed-status;
    }
    property <int> effect-status: App.status.lighting-effect;
    property <int> speed-status: App.status.lighting-speed;
    // What the applied effect uses: a speed (all but steady), the colour
    // (steady, breathing, strobe).
    property <bool> effect-moves: root.effect-status != 0;
    property <bool> effect-colored: root.effect-status == 0 || root.effect-status == 1 || root.effect-status == 4;
    in-out property <int> color-col: 0;
    // The back button whose grid is open: 0 M1, 1 M2, -1 none.
    in-out property <int> picking: -1;

    function step(row: int, d: int) {
        if row == 3 {
            root.level-pick = clamp(root.level-pick + d, 0, root.levels.length - 1);
        } else if row == 4 {
            root.effect-pick = clamp(root.effect-pick + d, 0, root.effect-names.length - 1);
        } else if row == 5 {
            root.speed-pick = clamp(root.speed-pick + d, 0, root.speed-names.length - 1);
        } else if row == 6 {
            root.color-col = clamp(root.color-col + d, 0, root.colors.length - 1);
        }
    }
    // The level a colour, effect or speed lights the rings at: the one
    // shown, high when they are off or left to the controller.
    function lit-level() -> int {
        root.level-pick >= 2 ? root.level-pick - 1 : 3
    }
    function light(color: string, effect: int, speed: int) {
        let level = root.lit-level();
        root.level-pick = level + 1;
        App.set-lighting(level, color, effect, speed);
    }
    function pick-color(i: int) {
        root.light(root.colors[i].hex, root.effect-status, root.speed-status);
    }
    function row-enabled(r: int) -> bool {
        (r != 5 || root.effect-moves) && (r != 6 || root.effect-colored)
    }
    // The next line up (-1) or down (1) that applies.
    function next-row(d: int) -> int {
        let one = root.focus-row + d;
        let two = root.row-enabled(one) ? one : one + d;
        let three = root.row-enabled(two) ? two : two + d;
        (three >= 0 && three <= 6) ? three : root.focus-row
    }
    function open-picker(row: int) {
        root.picking = row;
        picker.current = row == 0 ? App.status.m1 : App.status.m2;
    }
    function apply-picker() {
        App.set-back-button(root.picking == 0 ? "m1" : "m2", picker.current);
        root.picking = -1;
    }
    function activate() {
        if root.focus-row <= 1 {
            root.open-picker(root.focus-row);
        } else if root.focus-row == 2 {
            App.reset-back-buttons();
        } else if root.focus-row == 3 && root.level-pick != root.level-status {
            App.set-lighting(root.level-pick - 1, App.status.lighting-color, root.effect-status, root.speed-status);
        } else if root.focus-row == 4 && root.effect-pick != root.effect-status {
            root.light(App.status.lighting-color, root.effect-pick, root.speed-status);
        } else if root.focus-row == 5 && root.speed-pick != root.speed-status {
            root.light(App.status.lighting-color, root.effect-status, root.speed-pick);
        } else if root.focus-row == 6 {
            root.pick-color(root.color-col);
        }
    }
    // Moves to line `r`, dropping the choices not applied.
    function go(r: int) {
        if r != root.focus-row {
            root.level-pick = root.level-status;
            root.effect-pick = root.effect-status;
            root.speed-pick = root.speed-status;
        }
        root.focus-row = r;
    }
    // A tap on the focused line applies its choice, like A.
    function tap(r: int) {
        if root.focus-row == r && root.active {
            root.activate();
        }
        root.go(r);
    }
    function line-focused(r: int) -> bool {
        root.active && root.focus-row == r
    }

    fs := FocusScope {
        init => {
            self.focus();
        }
        key-pressed(event) => {
            if root.picking >= 0 {
                if event.text == Key.Escape {
                    root.picking = -1;
                    return accept;
                }
                if event.text == Key.Return || event.text == " " {
                    root.apply-picker();
                    return accept;
                }
                if event.text == Key.UpArrow || event.text == Key.DownArrow {
                    picker.move(0, event.text == Key.UpArrow ? -1 : 1);
                    return accept;
                }
                if event.text == Key.LeftArrow || event.text == Key.RightArrow {
                    picker.move(event.text == Key.LeftArrow ? -1 : 1, 0);
                    return accept;
                }
                return reject;
            }
            if event.text == Key.UpArrow {
                root.go(root.next-row(-1));
                return accept;
            }
            if event.text == Key.DownArrow {
                root.go(root.next-row(1));
                return accept;
            }
            if !App.status.connected {
                return reject;
            }
            if event.text == Key.LeftArrow {
                root.step(root.focus-row, -1);
                return accept;
            }
            if event.text == Key.RightArrow {
                root.step(root.focus-row, 1);
                return accept;
            }
            if event.text == Key.Return || event.text == " " {
                root.activate();
                return accept;
            }
            return reject;
        }
    }

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        spacing: 40px;

        VerticalLayout {
            horizontal-stretch: 1;
            // Fixed halves: the values must not move the columns.
            width: (root.width - 40px) / 2;
            spacing: 2px;
            alignment: start;

            SectionTitle {
                height: 36px;
                x: 16px;
                text: @tr("Back buttons");
            }

            SettingLine {
                label: @tr("M1, right");
                value: root.target-names[App.status.m1];
                chevrons: false;
                enabled: App.status.connected;
                focused: root.line-focused(0);
                clicked => {
                    root.go(0);
                    root.activate();
                    fs.focus();
                }
            }

            SettingLine {
                label: @tr("M2, left");
                value: root.target-names[App.status.m2];
                chevrons: false;
                enabled: App.status.connected;
                focused: root.line-focused(1);
                clicked => {
                    root.go(1);
                    root.activate();
                    fs.focus();
                }
            }

            SettingLine {
                label: @tr("Restore the default buttons");
                value: "";
                chevrons: false;
                enabled: App.status.connected && (App.status.m1 != 0 || App.status.m2 != 0);
                focused: root.line-focused(2);
                clicked => {
                    root.go(2);
                    root.activate();
                    fs.focus();
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            // Fixed halves: the values must not move the columns.
            width: (root.width - 40px) / 2;
            spacing: 2px;
            alignment: start;

            SectionTitle {
                height: 36px;
                x: 16px;
                text: @tr("Stick lighting");
            }

            SettingLine {
                label: @tr("Brightness");
                value: root.levels[root.level-pick];
                pending: root.level-pick != root.level-status;
                enabled: App.status.connected;
                focused: root.line-focused(3);
                clicked => {
                    root.tap(3);
                    fs.focus();
                }
                step(d) => {
                    root.go(3);
                    root.step(3, d);
                    fs.focus();
                }
            }

            SettingLine {
                label: @tr("Effect");
                value: root.effect-names[root.effect-pick];
                pending: root.effect-pick != root.effect-status;
                enabled: App.status.connected;
                focused: root.line-focused(4);
                clicked => {
                    root.tap(4);
                    fs.focus();
                }
                step(d) => {
                    root.go(4);
                    root.step(4, d);
                    fs.focus();
                }
            }

            SettingLine {
                label: @tr("Speed");
                value: root.speed-names[root.speed-pick];
                pending: root.speed-pick != root.speed-status;
                enabled: App.status.connected && root.effect-moves;
                focused: root.line-focused(5);
                clicked => {
                    if root.effect-moves {
                        root.tap(5);
                    }
                    fs.focus();
                }
                step(d) => {
                    if root.effect-moves {
                        root.go(5);
                        root.step(5, d);
                    }
                    fs.focus();
                }
            }

            Row {
                height: 64px;
                border-radius: 10px;
                focused: root.line-focused(6);
                enabled: App.status.connected && root.effect-colored;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    alignment: space-between;
                    for c[i] in root.colors: VerticalLayout {
                        alignment: center;
                        if i == 0: AccentSwatch {
                            selected: App.status.lighting-level > 0 && App.status.lighting-color == "";
                            focused: root.line-focused(6) && root.color-col == 0;
                            clicked => {
                                root.go(6);
                                root.color-col = 0;
                                root.pick-color(0);
                                fs.focus();
                            }
                        }
                        if i > 0: Swatch {
                            swatch: c.color;
                            selected: App.status.lighting-level > 0 && App.status.lighting-color == c.hex;
                            focused: root.line-focused(6) && root.color-col == i;
                            clicked => {
                                root.go(6);
                                root.color-col = i;
                                root.pick-color(i);
                                fs.focus();
                            }
                        }
                    }
                }
            }

            // The first colour is not a fixed one.
            Text {
                x: 16px;
                height: 32px;
                text: root.line-focused(6) && root.color-col == 0 ? @tr("Follows the accent colour") : "";
                color: Theme.dim;
                font-size: 13px;
                vertical-alignment: center;
            }
        }
    }

    picker := TargetPicker {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        visible: root.picking >= 0;
        title: root.picking == 0 ? @tr("M1, right") : @tr("M2, left");
        own-key: root.picking == 0 ? "M1" : "M2";
        names: root.target-names;
        applied: root.picking == 0 ? App.status.m1 : App.status.m2;
        pick(i) => {
            root.apply-picker();
            fs.focus();
        }
    }
}
