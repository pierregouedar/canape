<Page
    x:Class="CanapeWidget.WidgetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark"
    Background="Transparent">

    <!-- Every user-visible string comes from Strings\<lang>\Resources.resw:
         x:Uid here, ResourceLoader in WidgetPage.xaml.cs. -->
    <Page.Resources>
        <ResourceDictionary>
            <!-- Lightweight styling of the stock Button / ToggleButton templates:
                 translucent tiles on the panel, accent #2563EB when checked. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ButtonBackground" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2BFFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#0AFFFFFF" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="#F2FFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#CCFFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#59FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />

                    <SolidColorBrush x:Key="ToggleButtonBackground" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#2BFFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="#0AFFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#2563EB" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#3B76F0" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#1D4FC4" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="#592563EB" />
                    <SolidColorBrush x:Key="ToggleButtonForeground" Color="#F2FFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="#CCFFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundDisabled" Color="#59FFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#E6FFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedDisabled" Color="#99FFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedDisabled" Color="Transparent" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Opaque here; WidgetPage applies Game Bar's requested opacity to it. -->
            <SolidColorBrush x:Key="PanelBackground" Color="#16181D" />

            <Style x:Key="Tile" TargetType="Border">
                <Setter Property="Background" Value="#12FFFFFF" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="8,6" />
            </Style>

            <Style x:Key="Caption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Opacity" Value="0.65" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>

            <Style x:Key="MetricValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="Text" Value="—" />
            </Style>

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Opacity" Value="0.8" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
            </Style>

            <Style x:Key="SectionHint" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Opacity" Value="0.6" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
            </Style>

            <Style x:Key="Choice" TargetType="ToggleButton">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="Action" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="FontSize" Value="13" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="Root" Background="{StaticResource PanelBackground}">
        <!-- 340x360 by default; a little more air and bigger numbers from 420x420. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SizeStates">
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Roomy">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="420" MinWindowHeight="420" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Body.Padding" Value="16" />
                        <Setter Target="Body.Spacing" Value="14" />
                        <Setter Target="GameText.FontSize" Value="16" />
                        <Setter Target="TdpText.FontSize" Value="24" />
                        <Setter Target="FpsText.FontSize" Value="24" />
                        <Setter Target="TempText.FontSize" Value="24" />
                        <Setter Target="BatteryText.FontSize" Value="24" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Body" Padding="12" Spacing="10">

                <!-- Header: link state, foreground game, active profile. -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="LinkDot" Width="8" Height="8" Fill="#80FFFFFF" VerticalAlignment="Center" />
                    <TextBlock x:Name="GameText" Grid.Column="1" FontSize="14" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" />
                    <Border x:Name="ProfileChip" Grid.Column="2" Visibility="Collapsed" VerticalAlignment="Center"
                            Background="#332563EB" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="10" Padding="8,1,8,2">
                        <TextBlock x:Name="ProfileText" FontSize="11" Foreground="#C7D7FE" MaxWidth="150"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </Border>
                </Grid>

                <!-- Live values. Temperature and battery captions double as the
                     thermal-limit and AC indicators. -->
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock x:Uid="TdpCaption" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="TdpText" Style="{StaticResource MetricValue}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock x:Uid="FpsCaption" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="FpsText" Style="{StaticResource MetricValue}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock x:Name="TempCaption" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="TempText" Style="{StaticResource MetricValue}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock x:Name="BatteryCaption" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="BatteryText" Style="{StaticResource MetricValue}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Bench progress (started from the shell; read-only here). -->
                <Border x:Name="BenchCard" Style="{StaticResource Tile}" Visibility="Collapsed">
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="BenchStepText" FontSize="12" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <TextBlock x:Name="BenchLeftText" Grid.Column="1" FontSize="12" Opacity="0.7" />
                        </Grid>
                        <ProgressBar x:Name="BenchBar" Minimum="0" Maximum="1" Value="0"
                                     Foreground="#2563EB" Background="#1FFFFFFF" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="6">
                    <TextBlock x:Uid="ModeHeader" Style="{StaticResource SectionHeader}" />
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="SilentButton" Grid.Column="0" Style="{StaticResource Choice}" Tag="silent" Click="OnMode">
                            <TextBlock x:Uid="ModeSilent" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </ToggleButton>
                        <ToggleButton x:Name="PerformanceButton" Grid.Column="1" Style="{StaticResource Choice}" Tag="performance" Click="OnMode">
                            <TextBlock x:Uid="ModePerformance" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </ToggleButton>
                        <ToggleButton x:Name="TurboButton" Grid.Column="2" Style="{StaticResource Choice}" Tag="turbo" Click="OnMode">
                            <TextBlock x:Uid="ModeTurbo" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </ToggleButton>
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="TdpHeader" Style="{StaticResource SectionHeader}" />
                        <TextBlock x:Name="TdpHint" Grid.Column="1" Style="{StaticResource SectionHint}" />
                    </Grid>
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="TdpMinusButton" x:Uid="TdpMinus" Grid.Column="0" Style="{StaticResource Action}" Tag="-1" Click="OnTdp" IsEnabled="False" />
                        <Button x:Name="TdpPlusButton" x:Uid="TdpPlus" Grid.Column="1" Style="{StaticResource Action}" Tag="1" Click="OnTdp" IsEnabled="False" />
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="AutoHeader" Style="{StaticResource SectionHeader}" />
                        <TextBlock x:Name="AutoRangeText" Grid.Column="1" Style="{StaticResource SectionHint}" />
                    </Grid>
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="AutoButton" Grid.Column="0" Style="{StaticResource Choice}" Click="OnAutoToggle">
                            <TextBlock x:Name="AutoText" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </ToggleButton>
                        <ToggleButton x:Name="Fps30Button" Grid.Column="1" Style="{StaticResource Choice}" Content="30" Tag="30" Click="OnTarget" />
                        <ToggleButton x:Name="Fps40Button" Grid.Column="2" Style="{StaticResource Choice}" Content="40" Tag="40" Click="OnTarget" />
                        <ToggleButton x:Name="Fps60Button" Grid.Column="3" Style="{StaticResource Choice}" Content="60" Tag="60" Click="OnTarget" />
                    </Grid>
                </StackPanel>

                <TextBlock x:Name="ConflictText" FontSize="12" Foreground="#FACC15" TextWrapping="Wrap" Visibility="Collapsed" />
                <TextBlock x:Name="MessageText" FontSize="12" Foreground="#FCA5A5" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
