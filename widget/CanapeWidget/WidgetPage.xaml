<Page
    x:Class="CanapeWidget.WidgetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark"
    Background="Transparent">

    <!-- Every user-visible string comes from Strings\<lang>\Resources.resw:
         x:Uid here, ResourceLoader in WidgetPage.xaml.cs. -->
    <Page.Resources>
        <ResourceDictionary>
            <!-- Lightweight styling of the stock Button / ToggleButton templates.
                 Unchecked choices are transparent inside a "Track" (segmented
                 control); checked ones take the accent. The accent brushes are
                 recoloured in code (WidgetPage.ApplyAccent) from Status.accent. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ButtonBackground" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#21FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#0DFFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#08FFFFFF" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="#EBFFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#B3FFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#4DFFFFFF" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />

                    <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#0AFFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#2563EB" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#4079EE" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#1F54C8" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="#592563EB" />
                    <SolidColorBrush x:Key="ToggleButtonForeground" Color="#C7FFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="#B3FFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundDisabled" Color="#4DFFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#E6FFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedDisabled" Color="#99FFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedDisabled" Color="Transparent" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Opaque here; WidgetPage applies Game Bar's requested opacity to it.
                 Same colour as Palette.Panel. -->
            <SolidColorBrush x:Key="PanelBackground" Color="#1A1B1F" />

            <!-- Accent family, recoloured in code; #2563EB until a status says otherwise. -->
            <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
            <SolidColorBrush x:Key="AccentFillBrush" Color="#382563EB" />
            <SolidColorBrush x:Key="AccentTextBrush" Color="#7EA2F3" />

            <SolidColorBrush x:Key="SurfaceBrush" Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="HairlineBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="ReferenceBrush" Color="#66FFFFFF" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#FCA5A5" />

            <Style x:Key="Tile" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="10,8,10,8" />
            </Style>

            <!-- Background of a group of choices (segmented control). -->
            <Style x:Key="Track" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="2" />
            </Style>

            <Style x:Key="Caption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Opacity" Value="0.6" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>

            <Style x:Key="MetricValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="Text" Value="—" />
            </Style>

            <Style x:Key="StatValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="Text" Value="—" />
            </Style>

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Opacity" Value="0.75" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
            </Style>

            <Style x:Key="SectionHint" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Opacity" Value="0.55" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
            </Style>

            <Style x:Key="Choice" TargetType="ToggleButton">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="Action" TargetType="Button">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="MinWidth" Value="58" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <!-- Sparkline strokes; Data is built in code (LiveGraph). -->
            <Style x:Key="GraphLine" TargetType="Path">
                <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
                <Setter Property="StrokeThickness" Value="1.5" />
                <Setter Property="StrokeLineJoin" Value="Round" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="Root" Background="{StaticResource PanelBackground}">
        <!-- 340x360 by default; a little more air, bigger numbers and taller
             graphs from 420x420. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SizeStates">
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Roomy">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="420" MinWindowHeight="420" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Body.Padding" Value="16" />
                        <Setter Target="Body.Spacing" Value="14" />
                        <Setter Target="GameText.FontSize" Value="17" />
                        <Setter Target="PowerText.FontSize" Value="26" />
                        <Setter Target="GpuText.FontSize" Value="26" />
                        <Setter Target="PowerPlot.Height" Value="44" />
                        <Setter Target="GpuPlot.Height" Value="44" />
                        <Setter Target="FpsText.FontSize" Value="18" />
                        <Setter Target="TempText.FontSize" Value="18" />
                        <Setter Target="BatteryText.FontSize" Value="18" />
                        <Setter Target="TdpText.FontSize" Value="18" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Body" Padding="12" Spacing="12">

                <!-- Header: foreground game (or link state) and the profile applied. -->
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="GameText" FontSize="15" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" />
                    <TextBlock x:Name="ProfileText" Grid.Column="1" FontSize="12" FontWeight="SemiBold" MaxWidth="160"
                               Foreground="{StaticResource AccentTextBrush}" Visibility="Collapsed"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" />
                </Grid>

                <!-- Live power draw against the limit, and GPU activity, over the last minute. -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock x:Uid="PowerCaption" Style="{StaticResource Caption}" />
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PowerText" Style="{StaticResource MetricValue}" Typography.NumeralAlignment="Tabular" />
                                <TextBlock x:Name="PowerLimitText" Grid.Column="1" Style="{StaticResource SectionHint}"
                                           Margin="0,0,0,3" Typography.NumeralAlignment="Tabular" />
                            </Grid>
                            <Canvas x:Name="PowerPlot" Height="30" Margin="0,6,0,0">
                                <Path x:Name="PowerArea" Fill="{StaticResource AccentFillBrush}" />
                                <Path x:Name="PowerLimitLine" Stroke="{StaticResource ReferenceBrush}" StrokeThickness="1" StrokeDashArray="3,3" />
                                <Path x:Name="PowerLine" Style="{StaticResource GraphLine}" />
                            </Canvas>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock x:Uid="GpuCaption" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="GpuText" Style="{StaticResource MetricValue}" Typography.NumeralAlignment="Tabular" />
                            <Canvas x:Name="GpuPlot" Height="30" Margin="0,6,0,0">
                                <Path x:Name="GpuArea" Fill="{StaticResource AccentFillBrush}" />
                                <Path x:Name="GpuLine" Style="{StaticResource GraphLine}" />
                            </Canvas>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- FPS, temperature, battery. The temperature caption turns into
                     "Throttled" (warning text) when auto TDP holds power because of
                     the temperature; the battery glyph shows the charge and a plug
                     on the charger. -->
                <Border Style="{StaticResource Tile}" Padding="0,8,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Padding="10,0">
                            <TextBlock x:Uid="FpsCaption" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="FpsText" Style="{StaticResource StatValue}" Typography.NumeralAlignment="Tabular" />
                        </StackPanel>
                        <Rectangle Grid.Column="1" Fill="{StaticResource HairlineBrush}" Margin="0,2" />
                        <StackPanel Grid.Column="2" Padding="10,0">
                            <TextBlock x:Name="TempCaption" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="TempText" Style="{StaticResource StatValue}" Typography.NumeralAlignment="Tabular" />
                        </StackPanel>
                        <Rectangle Grid.Column="3" Fill="{StaticResource HairlineBrush}" Margin="0,2" />
                        <StackPanel Grid.Column="4" Padding="10,0">
                            <TextBlock x:Name="BatteryCaption" Style="{StaticResource Caption}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="BatteryText" Style="{StaticResource StatValue}" Typography.NumeralAlignment="Tabular" />
                                <TextBlock x:Name="BatteryGlyph" FontFamily="Segoe MDL2 Assets" FontSize="14" Opacity="0.8"
                                           VerticalAlignment="Center" Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Bench progress (started from the shell; read-only here). -->
                <Border x:Name="BenchCard" Style="{StaticResource Tile}" Visibility="Collapsed">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="BenchStepText" FontSize="12" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <TextBlock x:Name="BenchLeftText" Grid.Column="1" FontSize="12" Opacity="0.6"
                                       Typography.NumeralAlignment="Tabular" />
                        </Grid>
                        <ProgressBar x:Name="BenchBar" Minimum="0" Maximum="1" Value="0"
                                     Foreground="{StaticResource AccentBrush}" Background="#1AFFFFFF" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="6">
                    <TextBlock x:Uid="ModeHeader" Style="{StaticResource SectionHeader}" />
                    <Border Style="{StaticResource Track}">
                        <Grid ColumnSpacing="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="SilentButton" Grid.Column="0" Style="{StaticResource Choice}" Tag="silent" Click="OnMode">
                                <TextBlock x:Uid="ModeSilent" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </ToggleButton>
                            <ToggleButton x:Name="PerformanceButton" Grid.Column="1" Style="{StaticResource Choice}" Tag="performance" Click="OnMode">
                                <TextBlock x:Uid="ModePerformance" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </ToggleButton>
                            <ToggleButton x:Name="TurboButton" Grid.Column="2" Style="{StaticResource Choice}" Tag="turbo" Click="OnMode">
                                <TextBlock x:Uid="ModeTurbo" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </ToggleButton>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Manual TDP: −1 W, current limit, +1 W on one row. -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock x:Uid="TdpHeader" Style="{StaticResource SectionHeader}" />
                        <TextBlock x:Name="TdpHint" Style="{StaticResource Caption}" Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button x:Name="TdpMinusButton" x:Uid="TdpMinus" Style="{StaticResource Action}" Tag="-1" Click="OnTdp" IsEnabled="False" />
                        <TextBlock x:Name="TdpText" Style="{StaticResource StatValue}" MinWidth="48" TextAlignment="Center"
                                   VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                        <Button x:Name="TdpPlusButton" x:Uid="TdpPlus" Style="{StaticResource Action}" Tag="1" Click="OnTdp" IsEnabled="False" />
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="AutoHeader" Style="{StaticResource SectionHeader}" />
                        <TextBlock x:Name="AutoRangeText" Grid.Column="1" Style="{StaticResource SectionHint}"
                                   Typography.NumeralAlignment="Tabular" />
                    </Grid>
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="2.6*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Track}">
                            <ToggleButton x:Name="AutoButton" Style="{StaticResource Choice}" Click="OnAutoToggle">
                                <TextBlock x:Name="AutoText" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </ToggleButton>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Track}">
                            <Grid ColumnSpacing="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="Fps30Button" Grid.Column="0" Style="{StaticResource Choice}" Content="30" Tag="30" Click="OnTarget" />
                                <ToggleButton x:Name="Fps40Button" Grid.Column="1" Style="{StaticResource Choice}" Content="40" Tag="40" Click="OnTarget" />
                                <ToggleButton x:Name="Fps60Button" Grid.Column="2" Style="{StaticResource Choice}" Content="60" Tag="60" Click="OnTarget" />
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>

                <TextBlock x:Name="ConflictText" FontSize="12" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                <TextBlock x:Name="MessageText" FontSize="12" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
