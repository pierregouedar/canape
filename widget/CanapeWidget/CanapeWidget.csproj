<?xml version="1.0" encoding="utf-8"?>
<!-- Xbox Game Bar widget: a UWP XAML app, the only shape Game Bar accepts.
     Based on Microsoft's WidgetSampleCS (MIT, github.com/microsoft/XboxGameBarSamples).
     x64 only (ROG Ally). Build with packaging\build-widget.ps1. -->
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <ProjectGuid>{6C1B4A3E-2D59-4F0E-9B7A-3C8E5D1F2A47}</ProjectGuid>
    <OutputType>AppContainerExe</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>CanapeWidget</RootNamespace>
    <AssemblyName>CanapeWidget</AssemblyName>
    <!-- Neutral/fallback language of the package resources (Strings\en-US). -->
    <DefaultLanguage>en-US</DefaultLanguage>
    <TargetPlatformIdentifier>UAP</TargetPlatformIdentifier>
    <!-- The SDK the UWP Build Tools workload installs; MinVersion stays 19041. -->
    <TargetPlatformVersion Condition=" '$(TargetPlatformVersion)' == '' ">10.0.26100.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <MinimumVisualStudioVersion>14</MinimumVisualStudioVersion>
    <FileAlignment>512</FileAlignment>
    <ProjectTypeGuids>{A5A43C5B-DE2A-4C0C-9213-0A381AF9435A};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <AppxPackageSigningEnabled>False</AppxPackageSigningEnabled>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
    <AppxSymbolPackageEnabled>False</AppxSymbolPackageEnabled>
    <AppxBundle>Never</AppxBundle>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <DebugSymbols>true</DebugSymbols>
    <OutputPath>bin\x64\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE;NETFX_CORE;WINDOWS_UWP</DefineConstants>
    <NoWarn>;2008</NoWarn>
    <DebugType>full</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <UseVSHostingProcess>false</UseVSHostingProcess>
    <Prefer32Bit>true</Prefer32Bit>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <OutputPath>bin\x64\Release\</OutputPath>
    <DefineConstants>TRACE;NETFX_CORE;WINDOWS_UWP</DefineConstants>
    <Optimize>true</Optimize>
    <NoWarn>;2008</NoWarn>
    <DebugType>pdbonly</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <UseVSHostingProcess>false</UseVSHostingProcess>
    <Prefer32Bit>true</Prefer32Bit>
    <UseDotNetNativeToolchain>true</UseDotNetNativeToolchain>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="App.xaml.cs">
      <DependentUpon>App.xaml</DependentUpon>
    </Compile>
    <Compile Include="CanapeLink.cs" />
    <Compile Include="LiveGraph.cs" />
    <Compile Include="Palette.cs" />
    <Compile Include="WidgetPage.xaml.cs">
      <DependentUpon>WidgetPage.xaml</DependentUpon>
    </Compile>
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>
  <ItemGroup>
    <!-- Sofa icons: base names plus Square44x44Logo target sizes (plated and
         unplated) for the Game Bar menu and the taskbar. -->
    <Content Include="Assets\*.png" />
    <Content Include="Properties\Default.rd.xml" />
    <!-- The shell's embedded font, shared rather than copied. -->
    <Content Include="..\..\crates\canape-shell\ui\fonts\*.ttf" Link="Assets\Fonts\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- UI strings, one folder per language (see widget/README.md). -->
    <PRIResource Include="Strings\en-US\Resources.resw" />
    <PRIResource Include="Strings\fr-FR\Resources.resw" />
    <PRIResource Include="Strings\es-ES\Resources.resw" />
    <PRIResource Include="Strings\de-DE\Resources.resw" />
    <PRIResource Include="Strings\it-IT\Resources.resw" />
    <PRIResource Include="Strings\pt-BR\Resources.resw" />
    <PRIResource Include="Strings\nl-NL\Resources.resw" />
    <PRIResource Include="Strings\pl-PL\Resources.resw" />
    <PRIResource Include="Strings\ru-RU\Resources.resw" />
    <PRIResource Include="Strings\tr-TR\Resources.resw" />
    <PRIResource Include="Strings\ja-JP\Resources.resw" />
    <PRIResource Include="Strings\ko-KR\Resources.resw" />
    <PRIResource Include="Strings\zh-Hans\Resources.resw" />
  </ItemGroup>
  <ItemGroup>
    <ApplicationDefinition Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </ApplicationDefinition>
    <Page Include="WidgetPage.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <!-- 7.3.x currently ships a duplicated proxy-stub InterfaceId that breaks
         the build (XboxGameBarSamples issue #155); keep the samples' version. -->
    <PackageReference Include="Microsoft.Gaming.XboxGameBar">
      <Version>7.2.240903001</Version>
    </PackageReference>
    <PackageReference Include="Microsoft.NETCore.UniversalWindowsPlatform">
      <Version>6.2.14</Version>
    </PackageReference>
  </ItemGroup>
  <PropertyGroup>
    <XboxGameBar-Platform>$(Platform)</XboxGameBar-Platform>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(VisualStudioVersion)' == '' or '$(VisualStudioVersion)' &lt; '14.0' ">
    <VisualStudioVersion>14.0</VisualStudioVersion>
  </PropertyGroup>
  <Import Project="$(MSBuildExtensionsPath)\Microsoft\WindowsXaml\v$(VisualStudioVersion)\Microsoft.Windows.UI.Xaml.CSharp.targets" />
</Project>
